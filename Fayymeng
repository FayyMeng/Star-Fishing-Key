do
    local function install()
        local GLIDE_SPEED = 520
        local AIM_RATE = 9
        local SNAP_GAP = 0.35
        local RESPONSE = 200
        local STREAM_GAP = 0.5
        local HOLD_FORCE = 1e7
        local HOLD_TORQUE = 1e7

        local attachment
        local mover
        local aligner
        local cursor
        local facing
        local goalFrame
        local aimSpot
        local streamClock = 0
        local glideConn
        local running = false

        local function humanoidOf()
            local character = LocalPlayer.Character
            return character and character:FindFirstChildOfClass("Humanoid")
        end

        local function detach()
            if mover then
                pcall(function()
                    mover:Destroy()
                end)
                mover = nil
            end

            if aligner then
                pcall(function()
                    aligner:Destroy()
                end)
                aligner = nil
            end

            if attachment then
                pcall(function()
                    attachment:Destroy()
                end)
                attachment = nil
            end
        end

        local function attach(root)
            detach()

            local ok = pcall(function()
                local point = Instance.new("Attachment")
                point.Name = "FayyMengGlidePoint"
                point.Parent = root

                local position = Instance.new("AlignPosition")
                position.Name = "FayyMengGlidePosition"
                position.Mode = Enum.PositionAlignmentMode.OneAttachment
                position.Attachment0 = point
                position.RigidityEnabled = false
                position.ApplyAtCenterOfMass = true
                position.ReactionForceEnabled = false
                position.MaxForce = HOLD_FORCE
                position.MaxVelocity = math.huge
                position.Responsiveness = RESPONSE
                position.Position = root.Position
                position.Parent = root

                local orientation = Instance.new("AlignOrientation")
                orientation.Name = "FayyMengGlideOrientation"
                orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
                orientation.Attachment0 = point
                orientation.RigidityEnabled = false
                orientation.ReactionTorqueEnabled = false
                orientation.MaxTorque = HOLD_TORQUE
                orientation.MaxAngularVelocity = math.huge
                orientation.Responsiveness = RESPONSE
                orientation.CFrame = root.CFrame.Rotation
                orientation.Parent = root

                attachment = point
                mover = position
                aligner = orientation
            end)

            if not ok then
                detach()
            end

            return ok
        end

        local function step(deltaTime)
            if not goalFrame then
                return
            end

            local root = FM.getRoot()
            if not root then
                return
            end

            if not mover or mover.Parent ~= root or not aligner or aligner.Parent ~= root then
                if not attach(root) then
                    return
                end

                cursor = root.Position
                facing = root.CFrame.Rotation
            end

            local humanoid = humanoidOf()
            if humanoid and not humanoid.PlatformStand then
                pcall(function()
                    humanoid.PlatformStand = true
                end)
            end

            cursor = cursor or root.Position
            facing = facing or root.CFrame.Rotation

            local delta = goalFrame.Position - cursor
            local mult = tonumber(S and S.moveSpeedMult) or 1.0
            local span = (GLIDE_SPEED * mult) * deltaTime

            if delta.Magnitude <= math.max(span, SNAP_GAP) then
                cursor = goalFrame.Position
            else
                cursor = cursor + delta.Unit * span
            end

            streamClock = streamClock + deltaTime
            if streamClock >= STREAM_GAP then
                streamClock = 0
                FM.requestStream(goalFrame.Position)
            end

            local look = goalFrame.Rotation

            if aimSpot then
                local gap = aimSpot - cursor
                if gap.Magnitude > 0.1 then
                    look = CFrame.lookAt(cursor, aimSpot).Rotation
                end
            end

            facing = facing:Lerp(look, 1 - math.exp(-AIM_RATE * deltaTime))

            mover.Position = cursor
            aligner.CFrame = facing
        end

        function Move.glide(goal, aim)
            if typeof(goal) ~= "CFrame" then
                return false
            end

            goalFrame = goal
            aimSpot = typeof(aim) == "Vector3" and aim or nil

            if not running then
                running = true

                local root = FM.getRoot()
                if root then
                    cursor = root.Position
                    facing = root.CFrame.Rotation
                    attach(root)
                end
            end

            if not glideConn then
                glideConn = RunService.Heartbeat:Connect(function(deltaTime)
                    if not running then
                        return
                    end

                    local ok, err = pcall(step, deltaTime)
                    if not ok then
                        FM.reportError("glide", err)
                    end
                end)
            end

            return true
        end

        function Move.glideStop()
            running = false
            goalFrame = nil
            aimSpot = nil
            cursor = nil
            facing = nil
            streamClock = 0

            if glideConn then
                glideConn:Disconnect()
                glideConn = nil
            end

            detach()

            local root = FM.getRoot()
            if root then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
            end

            local humanoid = humanoidOf()
            if humanoid then
                pcall(function()
                    humanoid.PlatformStand = false
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
        end
    end

    install()
end

function FM.placeAllSelectedRunes()
    local remote = PlotPlaceRequest or (FM.findRemote and FM.findRemote("PlotPlaceRequest"))
    if not remote then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Runes", Content = "PlotPlaceRequest remote missing", Duration = 3 })
            end
        end)
        return false
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local char = LocalPlayer.Character
    local tools = {}
    local function collect(src)
        if not src then return end
        for _, tool in ipairs(src:GetChildren()) do
            if tool:IsA("Tool") and tostring(tool.Name):find("Rune", 1, true) then
                tools[#tools+1] = tool
            end
        end
    end
    collect(bp)
    collect(char)
    if #tools == 0 then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Runes", Content = "No rune tools in inventory", Duration = 3 })
            end
        end)
        return false
    end
    for _, tool in ipairs(tools) do
        pcall(function()
            remote:FireServer(tool)
        end)
        task.wait(0.05)
    end
    return true
end


function FM.tweenBestBoulder()
    local TIER_RANK = { Mossite = 1, Voltite = 2, Gildrite = 3, Rimeveil = 4, Nocturnite = 5 }
    local bestModel, bestPos, bestRank, bestSize = nil, nil, -1, nil
    local function consider(model, kind)
        if not model or not model.Parent then return end
        local rank = TIER_RANK[kind] or 0
        if rank <= 0 then return end
        local part = model
        if model:IsA("Model") then
            part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
        end
        if not part or not part:IsA("BasePart") then return end
        local size = part.Size
        local topY = part.Position.Y + size.Y * 0.5
        local pos = Vector3.new(part.Position.X, topY, part.Position.Z)
        if rank > bestRank then
            bestRank, bestModel, bestPos, bestSize = rank, model, pos, size
        elseif rank == bestRank and bestPos then
            local root = FM.getRoot and FM.getRoot()
            if root and (pos - root.Position).Magnitude < (bestPos - root.Position).Magnitude then
                bestModel, bestPos, bestSize = model, pos, size
            end
        end
    end
    pcall(function()
        if Mountain and Mountain.findBoulder then
            for kind, _ in pairs(TIER_RANK) do
                local model = select(1, Mountain.findBoulder(kind, true))
                if model then consider(model, kind) end
            end
        end
    end)
    if not bestPos then
        pcall(function()
            local things = Workspace:FindFirstChild("Things")
            local folders = {}
            if things then
                folders[#folders+1] = things:FindFirstChild("Boulders")
                local zones = things:FindFirstChild("Zones")
                if zones then
                    for _, z in ipairs(zones:GetChildren()) do
                        folders[#folders+1] = z:FindFirstChild("Boulders")
                    end
                end
            end
            folders[#folders+1] = Workspace:FindFirstChild("Boulders")
            for _, folder in ipairs(folders) do
                if folder then
                    for _, child in ipairs(folder:GetChildren()) do
                        local name = child.Name
                        for k in pairs(TIER_RANK) do
                            if name == k or (type(name)=="string" and name:sub(1,#k)==k) then
                                consider(child, k)
                                break
                            end
                        end
                    end
                end
            end
        end)
    end
    if not bestPos then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Boulder", Content = "No boulder found", Duration = 3, Icon = "alert-circle" })
            end
        end)
        return false
    end
    local clearance = bestSize and math.max(4, bestSize.Y * 0.15) or 4
    local dest = bestPos + Vector3.new(0, clearance, 0)
    local lookAt = bestPos
    local mode = tostring(S.farmMode or "Tween")
    if mode == "Teleport" and FM.secureTeleportTo then
        FM.secureTeleportTo(dest, lookAt)
    elseif FM.moveTo then
        FM.moveTo(dest, lookAt)
    elseif FM.secureTeleportTo then
        FM.secureTeleportTo(dest, lookAt)
    elseif FM.teleportTo then
        FM.teleportTo(dest)
    else
        local root = FM.getRoot and FM.getRoot()
        if root then pcall(function() root.CFrame = CFrame.new(dest, lookAt) end) end
    end
    pcall(function()
        if WindUI and WindUI.Notify then
            WindUI:Notify({ Title = "Boulder", Content = "Moving above best boulder", Duration = 2, Icon = "check" })
        end
    end)
    return true
end

