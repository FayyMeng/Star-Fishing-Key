        local OFFSETS = { Vector2.new(0, 0) }
        local PEAK_OFFSETS = { Vector2.new(0, 0) }

        for ring = 1, RING_MAX do
            local slices = ring * 6

            for slice = 0, slices - 1 do
                local angle = slice / slices * math.pi * 2
                local reach = ring * COLUMN_STEP
                OFFSETS[#OFFSETS + 1] = Vector2.new(math.cos(angle) * reach, math.sin(angle) * reach)
            end
        end

        for ring = 1, PEAK_RINGS do
            local slices = ring * 3

            for slice = 0, slices - 1 do
                local angle = slice / slices * math.pi * 2
                local reach = ring * PEAK_STEP
                PEAK_OFFSETS[#PEAK_OFFSETS + 1] =
                    Vector2.new(math.cos(angle) * reach, math.sin(angle) * reach)
            end
        end

        local surfaceParams = RaycastParams.new()
        surfaceParams.FilterType = Enum.RaycastFilterType.Include
        surfaceParams.FilterDescendantsInstances = { Workspace.Terrain }
        surfaceParams.IgnoreWater = true

        local digParams = RaycastParams.new()
        digParams.FilterType = Enum.RaycastFilterType.Include
        digParams.IgnoreWater = true

        local digClock = 0

        local function digFilter(now)
            if digClock > 0 and now - digClock < DIG_REFRESH then
                return
            end

            digClock = now

            local list = { Workspace.Terrain }
            local decorations = Workspace:FindFirstChild("MountainDecorations")
            local boulders = decorations and decorations:FindFirstChild("Boulders")

            if boulders then
                list[#list + 1] = boulders
            end

            local test = Workspace:FindFirstChild("BoulderTest")

            if test then
                list[#list + 1] = test
            end

            digParams.FilterDescendantsInstances = list
        end

        local function pickReach(tool)
            local override = tool and tonumber(FM.getAttr(tool, "OverrideMaxReach"))
            return (override or DIG_REACH) + 3
        end

        local function aimPoint(origin, spot, reach, now)
            digFilter(now)

            local goals = {
                spot,
                spot - Vector3.new(0, 2, 0),
                origin - Vector3.new(0, reach, 0),
            }

            for _, goal in ipairs(goals) do
                local delta = goal - origin
                local distance = delta.Magnitude

                if distance > 0.05 then
                    local span = math.min(distance + 4, reach)
                    local hit = Workspace:Raycast(origin, delta.Unit * span, digParams)

                    if hit then
                        return hit.Position
                    end
                end
            end

            local delta = spot - origin

            if delta.Magnitude <= reach then
                return spot
            end

            return origin + delta.Unit * reach
        end

        local active = false
        local moneyLastPick = 0
        local autoSell = false
        local heldPick
        local loot
        local lootClock = 0
        local grabClock = 0
        local lootHp
        local lootMax
        local target
        local columnY
        local columnDry = 0
        local columnSwings = 0
        local surfaceClock = 0
        local peakClock = 0
        local scanIndex = 0
        local scanUntil = 0
        local loaded = false
        local swingClock = 0
        local equipClock = 0
        local sellSpot
        local sellUntil = 0
        local lootBlocked = false
        local statusText = "Idle"

        local function toggleValue(name)
            return false
        end

        local function zoneBase()
            local base = Workspace:GetAttribute("MountainBaseY")
            if typeof(base) == "number" then
                return base
            end
            return 0
        end

        local function zonePeak()
            local peak = Workspace:GetAttribute("MountainPeakY")
            if typeof(peak) == "number" then
                return peak
            end
            return zoneBase() + 900
        end

        local function zoneCenter()
            local spot = FM.mountainSpot()
            if spot then
                return Vector2.new(spot.X, spot.Z)
            end
            return nil
        end

        local function insideZone(x, z)
            local center = zoneCenter()
            if not center then
                return false
            end

            return (Vector2.new(x, z) - center).Magnitude <= FM.mountainSpan() + ZONE_PAD
        end

        local function surfaceAt(x, z)
            if not insideZone(x, z) then
                return nil
            end

            local base = zoneBase()
            local top = zonePeak() + RAY_TOP
            local hit = Workspace:Raycast(
                Vector3.new(x, top, z),
                Vector3.new(0, -(top - base + RAY_DROP), 0),
                surfaceParams
            )

            if not hit or hit.Position.Y <= base + 1 then
                return nil
            end

            return hit.Position
        end

        local function farmOrigin(root)
            if insideZone(root.Position.X, root.Position.Z) then
                return root.Position
            end

            return FM.mountainSpot() or root.Position
        end

        local function highestColumn(origin, offsets)
            local best

            for _, offset in ipairs(offsets) do
                local spot = surfaceAt(origin.X + offset.X, origin.Z + offset.Y)

                if spot and (not best or spot.Y > best.Y) then
                    best = spot
                end
            end

            return best
        end

        local function pickTarget(origin, now)
            local center = FM.mountainSpot()

            if center and now - peakClock >= PEAK_GAP then
                peakClock = now

                local high = highestColumn(center, PEAK_OFFSETS)
                if high then
                    return high
                end
            end

            local spot = highestColumn(origin, OFFSETS)
            if spot then
                return spot
            end

            if center then
                peakClock = now
                return highestColumn(center, PEAK_OFFSETS)
            end

            return nil
        end

        local function holdAt(goal, aim)
            if typeof(goal) ~= "CFrame" then
                return false
            end

            if Move and Move.glide then
                return Move.glide(goal, aim)
            end
            local root = FM.getRoot()
            if root then
                pcall(function()
                    root.CFrame = goal
                end)
                return true
            end
            return false
        end

        local function swing(spot)
            local event = Farm.digEvent()
            if not event or not heldPick then
                return false
            end

            local name = heldPick.Name
            if type(name) ~= "string" or name == "" then
                return false
            end
            local root = FM.getRoot()
            local aim = spot

            if root and typeof(spot) == "Vector3" then
                aim = aimPoint(root.Position, spot, pickReach(heldPick), os.clock()) or spot
            end
            if typeof(aim) ~= "Vector3" then
                return false
            end

            if tostring(S.farmDigTool or S.autoDigTool or "") == "Sledge Hammer" then
                local sledge = FM.findRemote and FM.findRemote("SledgeSwing")
                if sledge then
                    return pcall(function()
                        for step = 0, DIG_BURST - 1 do
                            local pos = aim - Vector3.new(0, step * DIG_SINK, 0)
                            sledge:FireServer(pos)
                        end
                    end)
                end
            end
            return pcall(function()
                for step = 0, DIG_BURST - 1 do
                    local pos = aim - Vector3.new(0, step * DIG_SINK, 0)
                    event:FireServer(name, pos)
                end
            end)
        end

        local function bagRatio()
            local capacity = FM.backpackCapacity()
            if capacity == math.huge or capacity <= 0 then
                return 0
            end

            return FM.backpackWeight() / capacity
        end

        local function findLoot(free, origin, luckFilterFn)
            local best, bestValue, bestDistance, bestLuck
            local blocked = false
            local seen = {}

            local fCfg = FM.farmPickupCfg
            
            local filterEnabled = fCfg and fCfg.Enabled == true
            local cfgMinValue = filterEnabled and (tonumber(fCfg.MinValue) or 0) or 0
            local cfgMinLuck  = filterEnabled and (tonumber(fCfg.MinLuck)  or 0) or 0
            local cfgTier     = filterEnabled and fCfg.Tier or nil
            local hasValueFilter = cfgMinValue > 0
            local hasLuckFilter  = cfgMinLuck  > 0
            local hasTierFilter  = type(cfgTier) == "table"
                                   and not cfgTier.All
                                   and next(cfgTier) ~= nil
            local hasAnyFilter = filterEnabled and (hasValueFilter or hasLuckFilter or hasTierFilter)

            local TIER_NAMES_MAP = {
                "Common","Uncommon","Rare","Epic","Legendary",
                "Mythic","Empyrean","Pulsar","Quasar"
            }
            local function tierAllowed(inst)
                if not hasTierFilter then return true end
                local tname = tostring(FM.getAttr(inst, "TierName") or "")
                if tname ~= "" and cfgTier[tname] then return true end
                local tierN = tonumber(FM.getAttr(inst, "Tier"))
                if tierN then
                    local nm = TIER_NAMES_MAP[tierN]
                    if nm and cfgTier[nm] then return true end
                end
                return false
            end

            local function consider(inst)
                if not inst or seen[inst] then return end
                seen[inst] = true

                if not inst.Parent or not FM.isCrystal(inst)
                    or FM.getAttr(inst, "Collected") == true then
                    return
                end

                local value = FM.crystalValue(inst)

                if hasAnyFilter then
                    
                    if hasValueFilter and value < cfgMinValue then return end
                    if not tierAllowed(inst) then return end
                    if hasLuckFilter then
                        local ok, lk = pcall(FM.crystalLuck, inst)
                        local lkPct = (ok and tonumber(lk)) or 0
                        if lkPct < cfgMinLuck then return end
                    end
                else
                    
                    if not FM.meetsFilter(inst, value) then return end
                end

                if luckFilterFn and not luckFilterFn(inst) then return end

                local distance = (inst.Position - origin).Magnitude
                if distance > COLLECT_RANGE then
                    return
                end

                if FM.crystalWeight(inst) > free then
                    blocked = true
                    return
                end

                local luckPts = math.floor((FM.crystalLuck(inst) or 0) * 100 + 0.5)
                local better = false
                if focusLuck then
                    better = not best or luckPts > (bestLuck or 0) or (luckPts == (bestLuck or 0) and value > (bestValue or 0))
                else
                    better = not best or value > bestValue
                    if not better and value == bestValue and distance < bestDistance then
                        better = true
                    end
                end

                if better then
                    best = inst
                    bestValue = value
                    bestDistance = distance
                    bestLuck = luckPts
                end
            end

            FM.eachContainer(function(container)
                for _, child in ipairs(container:GetChildren()) do
                    if child:IsA("BasePart") then
                        consider(child)
                    elseif child:IsA("Model") then
                        for _, inner in ipairs(child:GetChildren()) do
                            if inner:IsA("BasePart") then
                                consider(inner)
                            end
                        end
                    end
                end
            end)

            for inst in pairs(S.registry) do
                consider(inst)
            end

            return best, blocked
        end

        local function stop()

            active = false
            target = nil
            columnY = nil
            loaded = false
            scanIndex = 0
            loot = nil
            lootHp = nil
            lootMax = nil
            lootBlocked = false
            sellSpot = nil
            sellUntil = 0
            heldPick = nil
            statusText = "Idle"
            S.moneyFarmActive = false
            pcall(function()
                if FM.syncFarmActiveFlag then FM.syncFarmActiveFlag() end
            end)

            if not S.boulderFarmActive then
                pcall(function()
                    if Move and Move.glideStop then Move.glideStop() end
                end)
                pcall(function()
                    if Move and Move.setFly then Move.setFly(false) end
                end)
                pcall(function()
                    if Move and Move.setNoclip then Move.setNoclip(false, false) end
                end)
                pcall(function()
                    if Mountain and Mountain.setAutoGrab then Mountain.setAutoGrab(false) end
                end)
            end
        end

        local function step(deltaTime)
            local root = FM.getRoot()
            if not root then
                statusText = "Waiting for character"
                return
            end

            local now = os.clock()

            if not loaded then
                if scanIndex == 0 then
                    scanIndex = 1
                    scanUntil = now + SCAN_HOLD
                end

                if scanIndex <= #SCAN_SPOTS then
                    holdAt(SCAN_SPOTS[scanIndex])
                    statusText = string.format("Loading terrain %d/%d", scanIndex, #SCAN_SPOTS)

                    if now >= scanUntil then
                        scanIndex = scanIndex + 1
                        scanUntil = now + SCAN_HOLD
                    end

                    return
                end

                loaded = true
                peakClock = 0
            end

            if sellUntil > 0 then
                if now < sellUntil then
                    statusText = "Selling"
                    return
                end

                sellUntil = 0

                if sellSpot then
                    FM.applyPivot(sellSpot)
                    sellSpot = nil
                end

                target = nil
                columnY = nil
                surfaceClock = 0
            end

            if autoSell and (bagRatio() >= SELL_MARK or lootBlocked) then
                sellSpot = root.CFrame

                if FM.doSell() then
                    lootBlocked = false
                    sellUntil = now + SELL_WAIT
                    statusText = "Selling"
                    return
                end
            end

            
            do
                local now = os.clock()
                moneyLastPick = moneyLastPick or 0
                if now - moneyLastPick >= (PICK and PICK.cooldown or 0.08) then
                    local free = 0
                    pcall(function()
                        if type(backpackFree) == "function" then
                            free = backpackFree()
                        elseif FM.backpackFree then
                            free = FM.backpackFree() or 0
                        end
                    end)
                    if free > 0 then
                        local origin = root.Position
                        local range = (PICK and PICK.range or 14) + (PICK and PICK.pad or 6)
                        local candidates = {}

                        
                        local fCfg = FM.farmPickupCfg
                        local filterEnabled = fCfg and fCfg.Enabled == true
                        local cfgMinValue = filterEnabled and (tonumber(fCfg.MinValue) or 0) or 0
                        local cfgMinLuck  = filterEnabled and (tonumber(fCfg.MinLuck)  or 0) or 0
                        local cfgTier     = filterEnabled and fCfg.Tier or nil
                        local hasValueFilter = cfgMinValue > 0
                        local hasLuckFilter  = cfgMinLuck  > 0
                        local hasTierFilter  = type(cfgTier) == "table"
                                               and not cfgTier.All
                                               and next(cfgTier) ~= nil
                        local hasAnyFilter = filterEnabled and (hasValueFilter or hasLuckFilter or hasTierFilter)

                        local TIER_MAP = {
                            "Common","Uncommon","Rare","Epic","Legendary",
                            "Mythic","Empyrean","Pulsar","Quasar"
                        }
                        local function tierOk(inst)
                            if not hasTierFilter then return true end
                            local tn = tostring(inst:GetAttribute("TierName") or "")
                            if tn ~= "" and cfgTier[tn] then return true end
                            local n = tonumber(inst:GetAttribute("Tier"))
                            if n then
                                local nm = TIER_MAP[n]
                                if nm and cfgTier[nm] then return true end
                            end
                            return false
                        end

                        local function push(inst)
                            if not inst or not inst:IsA("BasePart") or not inst.Parent then
                                return
                            end
                            local isC = false
                            pcall(function()
                                if type(isCrystal) == "function" then
                                    isC = isCrystal(inst)
                                else
                                    isC = inst.Name:find("Crystal", 1, true) ~= nil
                                        or inst:GetAttribute("CrystalName") ~= nil
                                end
                            end)
                            if not isC then return end
                            if inst:GetAttribute("Collected") == true then return end
                            local w = tonumber(inst:GetAttribute("WeightKg")) or 0
                            if w > free then return end
                            local d = (inst.Position - origin).Magnitude
                            if d > range then return end

                            
                            if hasAnyFilter then
                                if hasValueFilter then
                                    local v = tonumber(inst:GetAttribute("Value")) or 0
                                    if v < cfgMinValue then return end
                                end
                                if not tierOk(inst) then return end
                                if hasLuckFilter then
                                    local ok, lk = pcall(FM.crystalLuck, inst)
                                    local lkPct = (ok and tonumber(lk)) or 0
                                    if lkPct < cfgMinLuck then return end
                                end
                            end

                            candidates[#candidates + 1] = { inst = inst, dist = d, weight = w }
                        end

                        pcall(function()
                            local folders = {
                                Workspace:FindFirstChild("DroppedCrystals"),
                                Workspace:FindFirstChild("Crystals"),
                            }
                            local things = Workspace:FindFirstChild("Things")
                            if things then
                                folders[#folders + 1] = things:FindFirstChild("DroppedCrystals")
                                folders[#folders + 1] = things:FindFirstChild("Crystals")
                            end
                            for _, folder in ipairs(folders) do
                                if folder then
                                    for _, child in ipairs(folder:GetChildren()) do
                                        if child:IsA("BasePart") then
                                            push(child)
                                        elseif child:IsA("Model") then
                                            for _, inner in ipairs(child:GetChildren()) do
                                                if inner:IsA("BasePart") then
                                                    push(inner)
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end)

                        table.sort(candidates, function(a, b)
                            return a.dist < b.dist
                        end)

                        local burst = (PICK and PICK.burst) or 4
                        local grabs = 0
                        local budget = free
                        for _, entry in ipairs(candidates) do
                            if grabs >= burst then break end
                            if entry.weight <= budget then
                                budget = budget - entry.weight
                                grabs = grabs + 1
                                local inst = entry.inst
                                pcall(function()
                                    if HoldComplete then
                                        FM.queueHoldComplete(inst)
                                    end
                                end)
                                pcall(function()
                                    local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and typeof(fireproximityprompt) == "function" then
                                        fireproximityprompt(prompt)
                                    end
                                end)
                            end
                        end
                        if grabs > 0 then
                            moneyLastPick = now
                        end
                    end
                end
            end

            if heldPick == nil or heldPick.Parent ~= LocalPlayer.Character then
                equipClock = 0
                heldPick = Farm.equipPick()
            else
                equipClock = equipClock + deltaTime
                if equipClock >= EQUIP_STEP then
                    equipClock = 0
                    heldPick = Farm.equipPick() or heldPick
                end
            end
            
            if not heldPick and S.farmDigTool == "Sledge Hammer" then
                heldPick = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
            end

            if not heldPick then
                statusText = "No pickaxe"
                return
            end

            swingClock = swingClock + deltaTime

            local swingNeed = math.max(0.02, Farm.swingGap(heldPick) * 0.4)
            local canSwing = swingClock >= swingNeed
            local free = FM.backpackFree()

            if loot and (not loot.Parent or FM.getAttr(loot, "Collected") == true) then
                loot = nil
                lootHp = nil
                lootMax = nil
            end

            if loot then
                local hp = tonumber(FM.getAttr(loot, "MinedHP"))
                if hp and (lootMax == nil or hp > lootMax) then
                    lootMax = hp
                end
                lootHp = hp
            end

            if not loot and now - lootClock >= COLLECT_GAP then
                lootClock = now
                loot, lootBlocked = findLoot(free, root.Position)
                if loot then
                    lootHp = tonumber(FM.getAttr(loot, "MinedHP"))
                    lootMax = lootHp
                end
            end

            if loot then
                local spot = loot.Position
                holdAt(CFrame.new(spot + Vector3.new(0, COLLECT_LIFT, 0), spot), spot)

                local digSpot = spot
                if not lootHp or lootHp <= 0 then
                    local ground = surfaceAt(spot.X, spot.Z)
                    if ground then digSpot = ground end
                end

                FM.requestStream(spot)

                if canSwing then
                    swingClock = swingClock - swingNeed
                    swing(digSpot)
                end

                if now - grabClock >= GRAB_GAP then
                    grabClock = now
                    FM.grabCrystal(loot, FM.crystalPrompt(loot))
                end

                if lootHp and lootHp > 0 then
                    local ratio = 0
                    if lootMax and lootMax > 0 then
                        ratio = math.clamp(1 - lootHp / lootMax, 0, 1)
                    end
                    statusText = string.format("Breaking crystal %d%%", math.floor(ratio * 100))
                else
                    statusText = "Collecting crystals"
                end

                return
            end

            local origin = farmOrigin(root)

            if target and now - surfaceClock >= SURFACE_GAP then
                surfaceClock = now
                local spot = surfaceAt(target.X, target.Z)
                if not spot then
                    target = nil
                    columnY = nil
                    columnDry = 0
                    columnSwings = 0
                else
                    if not columnY or spot.Y < columnY - 0.05 then
                        columnDry = 0
                    else
                        columnDry = columnDry + columnSwings
                    end
                    columnSwings = 0
                    columnY = spot.Y
                    target = spot
                    if columnDry >= COLUMN_DRY then
                        target = nil
                        columnY = nil
                        columnDry = 0
                    end
                end
            end

            if not target then
                local spot = pickTarget(origin, now)
                if not spot then spot = surfaceAt(origin.X, origin.Z) end
                if not spot then
                    FM.requestStream(origin)
                    if canSwing then
                        swingClock = swingClock - swingNeed
                        swing(root.Position - Vector3.new(0, DIG_REACH * 0.5, 0))
                    end
                    statusText = "Loading terrain"
                    return
                end
                target = spot
                columnY = spot.Y
                columnDry = 0
                columnSwings = 0
                surfaceClock = now
            end

            holdAt(CFrame.new(target + Vector3.new(0, DIG_LIFT, 0), target), target)

            if canSwing then
                swingClock = swingClock - swingNeed
                columnSwings = columnSwings + 1
                swing(target)
            end

            statusText = string.format("Mining surface at %dm", math.floor(target.Y))
        end

        local function setActive(value)
            if type(value) == "table" then
                value = value.Value or value.CurrentValue or value[1]
            end
            value = value == true
            if not value then
                stop()
                return
            end

            active = true
            S._pickupBusyUntil = 0
            target = nil
            columnY = nil
            columnDry = 0
            columnSwings = 0
            surfaceClock = 0
            peakClock = 0
            scanIndex = 0
            scanUntil = 0
            loaded = false
            loot = nil
            lootClock = 0
            lootHp = nil
            lootMax = nil
            lootBlocked = false
            swingClock = 0
            equipClock = 0
            sellSpot = nil
            sellUntil = 0
            heldPick = nil
            statusText = "Starting"
            S.moneyFarmActive = true
            pcall(FM.syncFarmActiveFlag)

            pcall(function()
                if Move and Move.setFly then Move.setFly(false) end
            end)
            pcall(function()
                if Move and Move.setNoclip then Move.setNoclip(true, false) end
            end)
            pcall(function()
                if Mountain and Mountain.setAutoGrab then Mountain.setAutoGrab(true) end
            end)

            if not moneyConn then
                moneyConn = RunService.Heartbeat:Connect(function(deltaTime)
                    if active then
                        local ok, err = pcall(step, deltaTime)
                        if not ok then
                            pcall(function()
                                if FM.reportError then FM.reportError("moneyFarm", err) end
                            end)
                        end
                    end
                end)
            end
        end

        local MoneyBox = Tabs.money

        local StatusLabel = MoneyBox:Paragraph({ Title = "Status" })
        local labelClock = 0

        if moneyConn then
            pcall(function() moneyConn:Disconnect() end)
            moneyConn = nil
        end

        moneyConn = RunService.Heartbeat:Connect(function(deltaTime)
            if active then
                local ok, err = pcall(step, deltaTime)
                if not ok then
                    FM.reportError("moneyFarm", err)
                end
            end

            labelClock = labelClock + deltaTime
            if labelClock >= 0.25 then
                labelClock = 0
                if StatusLabel then
                    StatusLabel.Desc = statusText
                end
            end
        end)

        Money.stop = stop
        Money.setActive = setActive
        FM.Money = Money
        Money.isActive = function() return active == true end
        Money.isSelling = function() return sellUntil > 0 end
        Money.setAutoSell = function(v) autoSell = v == true end

        FeatureManager:Register("AutoMoney", {
            enabled = false,
            active = false,
            Initialize = function() heldPick = nil end,
            StartRuntime = function() setActive(true) end,
            StopRuntime = function() stop() end,
            Cleanup = function() target = nil; heldPick = nil end,
            ResetRuntime = function()
                target = nil; heldPick = nil; loot = nil
                statusText = "Idle"; active = false
            end,
        })
    end

    install()
end

local fastDigConn

do
    local swingClock = 0
    local digRemote = nil

    local digParams = RaycastParams.new()
    digParams.FilterType = Enum.RaycastFilterType.Include
    digParams.IgnoreWater = true

    local function refreshDigFilter()
        local list = { Workspace.Terrain }
        local decorations = Workspace:FindFirstChild("MountainDecorations")
        local boulders = decorations and decorations:FindFirstChild("Boulders")
        if boulders then
            list[#list + 1] = boulders
        end
        local test = Workspace:FindFirstChild("BoulderTest")
        if test then
            list[#list + 1] = test
        end
        digParams.FilterDescendantsInstances = list
    end

    local function getDigRemote()
        if digRemote and digRemote.Parent then
            return digRemote
        end
        if Farm and Farm.digEvent then
            digRemote = Farm.digEvent()
        end
        if not digRemote then
            digRemote = FM.findRemote("DigRequest")
        end
        return digRemote
    end

    local function isDigTool(tool)
        if not tool or not tool:IsA("Tool") then
            return false
        end
        local n = tostring(tool.Name or "")
        if tool:GetAttribute("DigPower") ~= nil then
            return true
        end
        if n:find("Pick", 1, true) or n:find("Axe", 1, true) or n == "Sledge Hammer" then
            return true
        end
        if tool:GetAttribute("BitSpinAxis") ~= nil or n:find("Drill", 1, true) then
            return true
        end
        return false
    end

    local function getHeldPick()
        local char = LocalPlayer.Character
        if not char then
            return nil
        end
        local wantSledge = S.sledgeDigActive == true
        for _, tool in ipairs(char:GetChildren()) do
            if isDigTool(tool) then
                local isSledge = tool.Name == "Sledge Hammer"
                
                if wantSledge and isSledge then
                    return tool
                elseif not wantSledge and not isSledge then
                    return tool
                end
            end
        end
        return nil
    end

    local function findDigTarget(tool)
        local camera = Workspace.CurrentCamera
        local root = FM.getRoot()
        if not root then
            return nil
        end
        refreshDigFilter()
        local maxReach = 28
        if tool then
            local override = tonumber(FM.getAttr(tool, "OverrideMaxReach"))
            maxReach = math.max((override or 10) + 8, 20)
        end
        local look = (camera and camera.CFrame.LookVector) or root.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.001 then
            flat = root.CFrame.RightVector
        end
        flat = flat.Unit

        local function tryRay(origin, dir)
            local hit = Workspace:Raycast(origin, dir, digParams)
            if hit then
                return hit.Position
            end
            return nil
        end

        if camera then
            local hit = tryRay(camera.CFrame.Position, look * maxReach)
            if hit then return hit end
        end
        local hit = tryRay(root.Position + Vector3.new(0, 1.5, 0), look * maxReach)
        if hit then return hit end
        hit = tryRay(root.Position + Vector3.new(0, 1.5, 0), flat * maxReach)
        if hit then return hit end
        hit = tryRay(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -1, 0) * maxReach)
        if hit then return hit end
        hit = tryRay(root.Position + flat * 3 + Vector3.new(0, 2, 0), (look + Vector3.new(0, -0.35, 0)).Unit * maxReach)
        if hit then return hit end
        local hit = Workspace:Raycast(root.Position + Vector3.new(0, 1.5, 0), look * maxReach, digParams)
        if hit then
            return hit.Position
        end
        hit = Workspace:Raycast(root.Position + flat * 2, look * maxReach, digParams)
        if hit then
            return hit.Position
        end

        hit = Workspace:Raycast(root.Position, Vector3.new(0, -maxReach * 1.5, 0), digParams)
        if hit then
            return hit.Position
        end
        hit = Workspace:Raycast(root.Position + flat * 3, Vector3.new(0, -maxReach * 1.5, 0), digParams)
        if hit then
            return hit.Position
        end

        local hybrid = (look * 0.55 + Vector3.new(0, -0.85, 0))
        if hybrid.Magnitude > 0.05 then
            hybrid = hybrid.Unit
            hit = Workspace:Raycast(root.Position + Vector3.new(0, 1, 0), hybrid * maxReach, digParams)
            if hit then
                return hit.Position
            end
        end
        return root.Position + Vector3.new(0, -4, 0) + flat * 4
    end

    local function fireDig(toolName, pos)
        if type(toolName) ~= "string" or toolName == "" then
            return false
        end
        if typeof(pos) ~= "Vector3" then
            return false
        end
        local event = getDigRemote()
        if not event or not event.Parent then
            digRemote = nil
            event = getDigRemote()
        end
        if not event then
            digRemote = FM.findRemote("DigRequest")
            event = digRemote
        end
        if not event then
            return false
        end
        local ok = pcall(function()
            event:FireServer(toolName, pos)
        end)
        if not ok then
            digRemote = nil
            event = FM.findRemote("DigRequest")
            if event then
                digRemote = event
                ok = pcall(function()
                    event:FireServer(toolName, pos)
                end)
            end
        end
        return ok == true
    end

    function FM.fireDig(toolName, pos)
        return fireDig(toolName, pos)
    end

    local function fastDigStep(deltaTime)
        if not S.fastDigActive then
            return
        end

        
        if S.sledgeDigActive then
            return
        end

        if not S.farmActive and not S.miningBoulder then
            if FM.isPickupBusy and FM.isPickupBusy() then
                swingClock = 0
                return
            end
        end

        local pick = getHeldPick()
        if not pick or type(pick.Name) ~= "string" or pick.Name == "" then

            swingClock = 0
            return
        end

        local root = FM.getRoot()
        if not root then
            return
        end

        if FM.isAtBase and FM.isAtBase() then
            swingClock = 0
            return
        end
        do
            local cx = Workspace:GetAttribute("MountainCenterX")
            local cz = Workspace:GetAttribute("MountainCenterZ")
            local radius = Workspace:GetAttribute("MountainRadius")
            if typeof(cx) == "number" and typeof(cz) == "number" and typeof(radius) == "number" then
                if FM.isInMountainZone and not FM.isInMountainZone(root.Position) then
                    swingClock = 0
                    return
                end
            end
        end

        local mult = tonumber(S.digSpeedMult) or 0.4
        mult = math.clamp(mult, 0.08, 1)
        local baseGap = 0.04
        if Farm and Farm.swingGap then
            local okGap, gap = pcall(Farm.swingGap, pick)
            if okGap and type(gap) == "number" then
                baseGap = gap
            end
        end
        local swingNeed = math.max(0.03, baseGap * mult)

        swingClock = swingClock + (deltaTime or 0.016)
        if swingClock < swingNeed then
            return
        end
        swingClock = 0

        local aim = findDigTarget(pick)
        if typeof(aim) ~= "Vector3" then
            return
        end
        if FM.isInNoDigZone and FM.isInNoDigZone(aim) then
            return
        end

        local look = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.LookVector or root.CFrame.LookVector
        local right = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.RightVector or root.CFrame.RightVector
        fireDig(pick.Name, aim)
        fireDig(pick.Name, aim - Vector3.new(0, 1.2, 0))
        fireDig(pick.Name, aim + look * 1.5)
        fireDig(pick.Name, aim - look * 1.2)
        fireDig(pick.Name, aim + right * 1.4)
        fireDig(pick.Name, aim - right * 1.4)
        fireDig(pick.Name, aim + Vector3.new(0, 1.5, 0))
        fireDig(pick.Name, aim - Vector3.new(0, 2.4, 0))

        refreshDigFilter()
        local origin = root.Position + Vector3.new(0, 1.2, 0)
        local maxReach = 12
        local dirs = {
            look,
            -look,
            right,
            -right,
            Vector3.new(0, -1, 0),
            Vector3.new(0, 1, 0),
            (look + right).Unit,
            (look - right).Unit,
            (-look + right).Unit,
            (-look - right).Unit,
            (look + Vector3.new(0, 0.6, 0)).Unit,
            (look + Vector3.new(0, -0.6, 0)).Unit,
        }
        for i = 1, #dirs do
            local d = dirs[i]
            if typeof(d) == "Vector3" and d.Magnitude > 0.01 then
                local hit = Workspace:Raycast(origin, d.Unit * maxReach, digParams)
                if hit then
                    fireDig(pick.Name, hit.Position)
                else
                    fireDig(pick.Name, origin + d.Unit * math.min(6, maxReach))
                end
            end
        end
    end

    local function setFastDig(value)
        if type(value) == "table" then
            value = value.CurrentValue or value[1] or value.Value
        end

        if value == true then
            S.fastDigActive = true
            S.digSpeedMult = tonumber(S.digSpeedMult) or 0.28
            swingClock = 0
            digRemote = nil
            local tool = tostring(S.farmDigTool or S.autoDigTool or S.standaloneDigTool or "Pickaxe")
            S.farmDigTool = tool
            S.autoDigTool = tool
            S.standaloneDigTool = tool
            S.sledgeDigActive = (tool == "Sledge Hammer")
        else
            S.fastDigActive = false
            S.sledgeDigActive = false
            swingClock = 0
            digRemote = nil
        end
    end

    local function install()
        local DigBox = Tabs.dig

        
        
        
        
        
        
        DigBox:Section({ Title = "Farm Dig Tool", Opened = true })

        DigBox:Dropdown({
            Title = "Dig Tool (Boulder / Money / Vein)",
            Desc  = "Choose pickaxe or sledge hammer for auto farm systems. Does not affect Auto Dig.",
            Values = { "Pickaxe", "Sledge Hammer" },
            Value  = "Pickaxe",
            Flag   = "cfg_FarmDigTool",
            Callback = function(v)
                if type(v) == "table" then v = v[1] or v.Value or "Pickaxe" end
                v = tostring(v or "Pickaxe")
                S.farmDigTool = v
            end,
        })

        
        
        
        
        DigBox:Section({ Title = "Auto Dig", Opened = true })

        DigBox:Dropdown({
            Title = "Auto Dig Tool",
            Desc  = "Select which tool Auto Dig uses. Sledge Hammer here is for standalone dig only.",
            Values = { "Pickaxe", "Sledge Hammer" },
            Value  = "Pickaxe",
            Flag   = "cfg_DigTool",
            Callback = function(v)
                if type(v) == "table" then
                    v = v[1] or v.Value or "Pickaxe"
                end
                v = tostring(v or "Pickaxe")
                S.autoDigTool = v
                S.standaloneDigTool = v
                S.farmDigTool = v
                S.sledgeDigActive = (S.fastDigActive == true) and (v == "Sledge Hammer")
            end,
        })

        DigBox:Toggle({
            Title = "Auto Dig",
            Desc  = "Dig continuously using the Auto Dig Tool selected above. Separate from farm systems.",
            Value = false,
            Callback = setFastDig,
        })
    end

    install()

    fastDigConn = RunService.Heartbeat:Connect(function(deltaTime)
        local ok, err = pcall(fastDigStep, deltaTime)
        if not ok then
            FM.reportError("fastDig", err)
        end
    end)

    
    local sledgeClock = 0
    local sledgeRemote = nil
    local function getSledgeRemote()
        if sledgeRemote and sledgeRemote.Parent then
            return sledgeRemote
        end
        sledgeRemote = FM.findRemote("SledgeSwing")
        return sledgeRemote
    end
    local function sledgeDigStep(dt)
        if not S.sledgeDigActive or not S.fastDigActive then
            return
        end
        
        
        if S.boulderFarmActive or S.moneyFarmActive or S.veinFarmActive or S.farmActive then
            return
        end
        local root = FM.getRoot and FM.getRoot()
        if not root then
            return
        end
        sledgeClock = sledgeClock + (dt or 0)
        
        local gap = 0.14
        if sledgeClock < gap then
            return
        end
        sledgeClock = 0
        local event = getSledgeRemote()
        if not event then
            return
        end
        local base = root.Position
        local look = root.CFrame.LookVector
        local right = root.CFrame.RightVector
        local points = {
            base + look * 4 + Vector3.new(0, -1.5, 0),
            base + look * 6 + Vector3.new(0, -2.5, 0),
            base - look * 4 + Vector3.new(0, -2, 0),
            base + right * 4 + Vector3.new(0, -2, 0),
            base - right * 4 + Vector3.new(0, -2, 0),
            base + look * 4 + right * 3 + Vector3.new(0, -2, 0),
            base + look * 4 - right * 3 + Vector3.new(0, -2, 0),
        }
        for _, pt in ipairs(points) do
            pcall(function()
                event:FireServer(pt)
            end)
        end
    end
    RunService.Heartbeat:Connect(function(deltaTime)
        if not S.sledgeDigActive or not S.fastDigActive then
            return
        end
        local ok, err = pcall(sledgeDigStep, deltaTime)
        if not ok then
            pcall(function()
                if FM.reportError then FM.reportError("sledgeDig", err) end
            end)
        end
    end)
end

do
    function FM.setAntiRagdoll(value)
    S.antiRagdoll = value == true

    if S._antiRagdollConn then
        S._antiRagdollConn:Disconnect()
        S._antiRagdollConn = nil
    end
    if S._antiRagdollAttrConn then
        S._antiRagdollAttrConn:Disconnect()
        S._antiRagdollAttrConn = nil
    end
    if S._antiRagdollCharConn then
        S._antiRagdollCharConn:Disconnect()
        S._antiRagdollCharConn = nil
    end
    if S._antiRagdollStateConn then
        S._antiRagdollStateConn:Disconnect()
        S._antiRagdollStateConn = nil
    end
    if S._antiRagdollHealthConn then
        S._antiRagdollHealthConn:Disconnect()
        S._antiRagdollHealthConn = nil
    end

    if not S.antiRagdoll then
        return
    end

    S._lastSafeHealth = nil

    local function getDeactivateRemote()
        local pkg = ReplicatedStorage:FindFirstChild("RagdollSystemPackage")
        local sys = pkg and pkg:FindFirstChild("RagdollSystem")
        local remotes = sys and sys:FindFirstChild("Remotes")
        return remotes and remotes:FindFirstChild("DeactivateRagdollRemote")
    end

    local function zeroDamageAndUnragdoll()
        local character = LocalPlayer.Character
        if not character then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local safe = S._lastSafeHealth or humanoid.MaxHealth
            if humanoid.Health < safe then
                pcall(function()
                    humanoid.Health = safe
                end)
            end
            if humanoid.Health > humanoid.MaxHealth then
                pcall(function()
                    humanoid.Health = humanoid.MaxHealth
                end)
            end
        end

        local remote = getDeactivateRemote()
        if remote then
            pcall(function()
                remote:FireServer()
            end)
        end

        local alt = FM.findRemote and FM.findRemote("RagdollRequest")
        if alt then
            pcall(function()
                alt:FireServer("disable")
            end)
            pcall(function()
                alt:FireServer("deactivate")
            end)
        end

        pcall(function()
            character:SetAttribute("Ragdolled", false)
        end)

        local root = character:FindFirstChild("HumanoidRootPart")
        if humanoid then
            pcall(function()
                humanoid.PlatformStand = false
                if humanoid.WalkSpeed <= 0 then
                    if S._speedWanted or S.speedActive then
                        humanoid.WalkSpeed = (PACE and PACE.boost) or 40
                    else
                        humanoid.WalkSpeed = FM.getBaseSpeed()
                    end
                end
                local state = humanoid:GetState()
                if state == Enum.HumanoidStateType.Physics
                    or state == Enum.HumanoidStateType.FallingDown
                    or state == Enum.HumanoidStateType.Ragdoll then
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
        end

        if root then
            pcall(function()
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end

        for _, inst in ipairs(character:GetDescendants()) do
            if inst:IsA("AnimationConstraint") then
                pcall(function()
                    inst.Enabled = true
                    inst.IsKinematic = true
                end)
            end
        end

        pcall(function()
            FM.restoreUpright(character)
        end)
        if humanoid then
            pcall(function()
                if S._speedWanted or S.speedActive then
                    S.speedActive = true
                    FM.watchSpeed(humanoid)
                    FM.enforceSpeed(humanoid)
                else
                    humanoid.WalkSpeed = FM.getBaseSpeed()
                end
            end)
        end
    end

    local function hookCharacter(character)
        if S._antiRagdollAttrConn then
            S._antiRagdollAttrConn:Disconnect()
            S._antiRagdollAttrConn = nil
        end
        if S._antiRagdollHealthConn then
            S._antiRagdollHealthConn:Disconnect()
            S._antiRagdollHealthConn = nil
        end
        if not character then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            S._lastSafeHealth = humanoid.Health
            S._antiRagdollHealthConn = humanoid.HealthChanged:Connect(function(newHealth)
                if not S.antiRagdoll then return end
                local isRag = character:GetAttribute("Ragdolled") == true
                    or humanoid:GetState() == Enum.HumanoidStateType.Physics
                    or humanoid:GetState() == Enum.HumanoidStateType.Ragdoll
                    or humanoid.PlatformStand
                if isRag then
                    local safe = S._lastSafeHealth or humanoid.MaxHealth
                    if newHealth < safe then
                        pcall(function()
                            humanoid.Health = safe
                        end)
                    end
                    zeroDamageAndUnragdoll()
                else
                    if newHealth > 0 then
                        S._lastSafeHealth = newHealth
                    end
                end
            end)
        end

        S._antiRagdollAttrConn = character:GetAttributeChangedSignal("Ragdolled"):Connect(function()
            if S.antiRagdoll and character:GetAttribute("Ragdolled") then
                zeroDamageAndUnragdoll()
            end
        end)

        if humanoid then
            if S._antiRagdollStateConn then
                S._antiRagdollStateConn:Disconnect()
            end
            S._antiRagdollStateConn = humanoid.StateChanged:Connect(function(_, newState)
                if not S.antiRagdoll then
                    return
                end
                if newState == Enum.HumanoidStateType.Physics
                    or newState == Enum.HumanoidStateType.Ragdoll
                    or newState == Enum.HumanoidStateType.FallingDown then
                    zeroDamageAndUnragdoll()
                end
            end)
        end

        if character:GetAttribute("Ragdolled") then
            zeroDamageAndUnragdoll()
        end
    end

    hookCharacter(LocalPlayer.Character)
    S._antiRagdollCharConn = LocalPlayer.CharacterAdded:Connect(hookCharacter)

    local clock = 0
    S._antiRagdollConn = RunService.Heartbeat:Connect(function(dt)
        if not S.antiRagdoll then
            return
        end
        clock = clock + dt
        if clock < 0.2 then
            return
        end
        clock = 0

        local character = LocalPlayer.Character
        if not character then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local ragdolled = character:GetAttribute("Ragdolled") == true
        local physics = humanoid and (
            humanoid:GetState() == Enum.HumanoidStateType.Physics
            or humanoid:GetState() == Enum.HumanoidStateType.Ragdoll
            or humanoid.PlatformStand == true
        )

        if ragdolled or physics then
            zeroDamageAndUnragdoll()
        elseif humanoid and humanoid.Health > 0 then
            S._lastSafeHealth = humanoid.Health
        end
    end)
end

local function install()
        local PlotBox = Tabs.runes

        PlotBox:Button({
            Title = "PLACE ALL SELECTED RUNE",
            Desc = "Place runes on your plot.",
            Callback = function()
                task.spawn(function()
