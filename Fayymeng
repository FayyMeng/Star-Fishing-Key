            pcall(function()
                if S.moneyFarmActive then return end
                if MovementOwner and MovementOwner.HasAny and MovementOwner:HasAny() then
                    local owners = MovementOwner.owners or {}
                    if owners["Money"] or owners["AutoVein"] then return end
                end
                if Move and Move.glideStop then Move.glideStop() end
            end)
            hpMark = nil
            dryRounds = 0
            pendingFinish = false
            lootUntil = 0
            predigUntil = 0
            predigPoints = nil
            predigIndex = 0
            predigSwingClock = 0
            spotFrame = nil
            aimTurn = 0
            blindClock = 0
            lostClock = 0
            dryClock = 0
            probeIndex = 0
            statusText = "Idle"
            farmGen = (farmGen or 0) + 1
            myGen = -1
            S.miningBoulder = nil
            S.boulderFarmActive = false
            pcall(FM.syncFarmActiveFlag)

            pcall(function()
                local feat = FeatureManager:Get("AutoBoulder")
                if feat then feat.active = false end
            end)
            pcall(function()
                if MovementOwner and MovementOwner.Release then

                    MovementOwner:Release("Boulder")
                    MovementOwner:Release("AutoBoulder")
                end
            end)

            if farmConn then
                pcall(function() farmConn:Disconnect() end)
                farmConn = nil
            end

            pcall(function()

                if not MovementOwner or not (
                    (type(MovementOwner.HasAny) == "function" and MovementOwner:HasAny())
                    or MovementOwner.owner
                ) then

                    if not S.moneyFarmActive then
                        Move.forceClearFarmMovement()
                        Move.setNoclip(false, false)
                    end
                end
            end)
            pcall(function()

                if not S.moneyFarmActive then
                    if Move and Move.glideStop then Move.glideStop() end
                end
            end)
            if S._noclipWanted then
                pcall(function()
                    Move.setNoclip(true, false)
                end)
            end

            pcall(function()

                if S.moneyFarmActive then return end
                if FM.RunePickupSystem and FM.RunePickupSystem.Active then return end
                if Mountain and Mountain.setAutoGrab then
                    Mountain.setAutoGrab(false)
                end
            end)
            pcall(function()

                if not S.moneyFarmActive then
                    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum:Move(Vector3.zero, false)
                    end
                end
            end)
        end

        local function step(deltaTime)
            if not active then
                return
            end
            if myGen ~= nil and myGen ~= farmGen then
                return
            end

            local root = FM.getRoot()
            if not root then
                statusText = "Waiting for character"
                return
            end

            local now = os.clock()

            if FM.safeModeStep() then
                statusText = "Safe Mode: avoiding player"
                return
            end

            if S.pickupValueActive or S.pickupLuckActive or S.pickupRarityActive then
                filterPickClock = (filterPickClock or 0) + deltaTime
                local filterTick = ((S.pickupMode or "Legit") == "Burst") and 0.15 or 0.35
                if filterPickClock >= filterTick then
                    filterPickClock = 0
                    local free = FM.backpackFree()
                    if free > 0 then
                        pcall(function()
                            FM.tryFilteredCrystalPickup(root.Position, free)
                        end)
                    end
                end
            end

            if phase == "scan" then

                if not scanned then
                    if scanIndex == 0 then
                        scanIndex = 1
                        waitUntil = now + SCAN_HOLD
                    end

                    if scanIndex <= #SCAN_SPOTS then
                        hold(SCAN_SPOTS[scanIndex])
                        statusText = string.format("Scanning %d/%d", scanIndex, #SCAN_SPOTS)

                        if now >= waitUntil then
                            scanIndex = scanIndex + 1
                            waitUntil = now + SCAN_HOLD
                        end

                        return
                    end

                    scanned = true
                    noTargetClock = 0
                    statusText = "Scanning targets"
                end

                local model = pickTarget()
                if not model then
                    noTargetClock = (noTargetClock or 0) + deltaTime
                    local spot = FM.mountainSpot() or root.Position

                    if noTargetClock > 6 then
                        scanned = false
                        scanIndex = 0
                        noTargetClock = 0
                        statusText = "Rescan spots"
                        return
                    end

                    if noTargetClock < 1.2 then
                        if math.floor(noTargetClock * 2) % 2 == 0 then
                            FM.requestStream(spot)
                        end
                        statusText = string.format("Checking boulders %.1fs", noTargetClock)
                        return
                    end
                    if S.autoRejoinOnEmpty then

                        phase = "crystal_collect"
                        crystalCollectUntil = 0 
                        crystalCollectStarted = os.clock()
                        statusText = "Crystal collect phase before rejoin"
                        pcall(function()
                            if WindUI and WindUI.Notify then
                                WindUI:Notify({
                                    Title = "Boulder",
                                    Content = "No boulders — collecting all matching crystals then runes",
                                    Duration = 4,
                                    Icon = "check",
                                })
                            end
                        end)
                        return
                    end

                    if S.autoHopOnEmpty then
                        statusText = "Boulders empty — hopping server..."
                        stop()
                        pcall(function()
                            if Move and Move.forceClearFarmMovement then
                                Move.forceClearFarmMovement()
                            end
                        end)
                        pcall(function()
                            if WindUI and WindUI.Notify then
                                WindUI:Notify({
                                    Title = "Boulder",
                                    Content = "No boulders — server hop",
                                    Duration = 3,
                                    Icon = "check",
                                })
                            end
                        end)
                        task.spawn(function()
                            task.wait(0.35)
                            pcall(function()
                                if FM.hopRandomServer then
                                    FM.hopRandomServer()
                                end
                            end)
                        end)
                        return
                    end
                    
                    phase = "crystal_collect"
                    crystalCollectUntil = 0 
                    crystalCollectStarted = os.clock()
                    crystalRecoverTarget = nil
                    statusText = "Boulders empty — collecting crystals then runes"
                    return
                end

                noTargetClock = 0
                target = model
                anchor = visibleAnchor(model)
                spotFrame = nil
                aimTurn = 0
                blindClock = 0
                lostClock = 0
                dryClock = 0
                probeIndex = 0
                hpMark = nil
                dryRounds = 0

                predigPoints = buildPredigPoints(model)
                predigIndex = 1
                predigSwingClock = 0
                predigApproached = false
                PREDIG_DURATION = (S.farmDigTool == "Sledge Hammer") and PREDIG_DURATION_SLEDGE or PREDIG_DURATION_NORMAL
                predigUntil = os.clock() + PREDIG_DURATION
                phase = "predig"
                statusText = "Approaching boulder..."
                return
            end

            if phase == "predig" then
                if not target or not target.Parent then
                    S.miningBoulder = nil
                    phase = "scan"
                    scanned = false
                    scanIndex = 0
                    predigPoints = nil
                    predigApproached = false
                    return
                end

                S.miningBoulder = target
                local kind = boulderKind(target) or "Boulder"
                local hp = boulderHealth(target)
                if hp and hp <= 0 then
                    lastSpot = root.CFrame
                    predigPoints = nil
                    predigApproached = false
                    beginLoot(false)
                    return
                end

                
                if heldPick == nil or heldPick.Parent ~= LocalPlayer.Character then
                    equipClock = 0
                    heldPick = equipPick()
                end
                if not heldPick and S.farmDigTool == "Sledge Hammer" then
                    heldPick = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                end

                
                if not predigApproached then
                    local center = coreSpot(target) or (anchor and anchor.Position)
                    anchor = anchor or visibleAnchor(target) or anchorOf(target)
                    if anchor and center then
                        spotFrame = approach(anchor, target, 0, center, 0)
                        if spotFrame then
                            FM.ownedSetNoclip("AutoBoulder", true, false)
                            hold(spotFrame, center)
                        end
                    end
                    
                    predigPoints = buildPredigPoints(target)
                    predigIndex = 1
                    predigSwingClock = 0
                    predigApproached = true
                    
                    predigUntil = os.clock() + PREDIG_DURATION
                    statusText = string.format("Pre-digging terrain  %.1fs", PREDIG_DURATION)
                    return
                end

                
                if spotFrame then
                    local center = coreSpot(target) or (anchor and anchor.Position)
                    hold(spotFrame, center)
                end

                local nowPredig = os.clock()
                if nowPredig >= predigUntil or not predigPoints or #predigPoints == 0 then
                    predigPoints    = nil
                    predigIndex     = 0
                    predigSwingClock = 0
                    predigUntil     = 0
                    predigApproached = false
                    phase = "mine"
                    statusText = string.format("Mining %s", kind)
                    return
                end

                
                
                predigSwingClock = predigSwingClock + deltaTime
                local mult = math.clamp(tonumber(S.digSpeedMult) or 0.4, 0.08, 1)
                local baseGap = swingGap and swingGap() or 0.06
                local gap = math.max(0.03, baseGap * mult)

                if predigSwingClock >= gap then
                    predigSwingClock = 0

                    
                    if heldPick and root then
                        local base = root.Position
                        local camera = Workspace.CurrentCamera
                        local look = (camera and camera.CFrame.LookVector) or root.CFrame.LookVector
                        local right = (camera and camera.CFrame.RightVector) or root.CFrame.RightVector
                        local origin = base + Vector3.new(0, 1.2, 0)
                        local maxReach = 22

                        local autoDigParams = RaycastParams.new()
                        autoDigParams.FilterType = Enum.RaycastFilterType.Include
                        autoDigParams.IgnoreWater = true
                        local list = { Workspace.Terrain }
                        local deco = Workspace:FindFirstChild("MountainDecorations")
                        local boulders = deco and deco:FindFirstChild("Boulders")
                        if boulders then list[#list + 1] = boulders end
                        local bt = Workspace:FindFirstChild("BoulderTest")
                        if bt then list[#list + 1] = bt end
                        autoDigParams.FilterDescendantsInstances = list

                        local function tryFire(orig, dir)
                            local hit = Workspace:Raycast(orig, dir, autoDigParams)
                            if hit and hit.Position then
                                swingTerrainWithMode(hit.Position, kind)
                            else
                                swingTerrainWithMode(orig + dir.Unit * math.min(8, maxReach), kind)
                            end
                        end

                        
                        for _, ox in ipairs({ -6, -3, 0, 3, 6 }) do
                            for _, oz in ipairs({ -6, -3, 0, 3, 6 }) do
                                local pt = base + Vector3.new(ox, -2.5, oz)
                                swingTerrainWithMode(pt, kind)
                                tryFire(pt + Vector3.new(0, 8, 0), Vector3.new(0, -30, 0))
                            end
                        end

                        
                        for _ = 1, 6 do
                            local pt = base + Vector3.new(
                                (math.random() - 0.5) * 12,
                                -2.0 - math.random() * 2,
                                (math.random() - 0.5) * 12
                            )
                            swingTerrainWithMode(pt, kind)
                        end

                        if camera then
                            local camHit = Workspace:Raycast(
                                camera.CFrame.Position, look * maxReach, autoDigParams)
                            if camHit then swingTerrainWithMode(camHit.Position, kind) end
                        end

                        local aim = base + Vector3.new(0, 1.5, 0) + look * math.min(10, maxReach)
                        swingTerrainWithMode(aim, kind)
                        swingTerrainWithMode(aim - Vector3.new(0, 1.2, 0), kind)
                        swingTerrainWithMode(aim + look * 2, kind)
                        swingTerrainWithMode(aim - look * 1.5, kind)
                        swingTerrainWithMode(aim + right * 2, kind)
                        swingTerrainWithMode(aim - right * 2, kind)
                        swingTerrainWithMode(aim + Vector3.new(0, 2, 0), kind)
                        swingTerrainWithMode(aim - Vector3.new(0, 3, 0), kind)

                        local dirs = {
                            look, -look, right, -right,
                            Vector3.new(0, -1, 0), Vector3.new(0, 1, 0),
                            (look + right).Unit, (look - right).Unit,
                            (-look + right).Unit, (-look - right).Unit,
                            (look + Vector3.new(0, 0.6, 0)).Unit,
                            (look + Vector3.new(0, -0.6, 0)).Unit,
                        }
                        for _, d in ipairs(dirs) do
                            if typeof(d) == "Vector3" and d.Magnitude > 0.01 then
                                tryFire(origin, d.Unit * maxReach)
                            end
                        end
                    end

                    
                    if predigPoints and #predigPoints > 0 then
                        if predigIndex > #predigPoints then predigIndex = 1 end
                        local gridPt = predigPoints[predigIndex]
                        predigIndex = predigIndex + 1
                        swingTerrainWithMode(gridPt, kind)
                        
                        if typeof(gridPt) == "Vector3" then
                            swingTerrainWithMode(gridPt + Vector3.new(2, 0, 0), kind)
                            swingTerrainWithMode(gridPt + Vector3.new(-2, 0, 0), kind)
                            swingTerrainWithMode(gridPt + Vector3.new(0, 0, 2), kind)
                            swingTerrainWithMode(gridPt + Vector3.new(0, 0, -2), kind)
                        end
                    end
                end

                statusText = string.format("Predig %s  %.1fs", kind, math.max(0, predigUntil - nowPredig))
                return
            end

            if phase == "mine" then
                if not target or not target.Parent then
                    S.miningBoulder = nil
                    lastSpot = root.CFrame
                    beginLoot(false)
                    return
                end

                S.miningBoulder = target

                local kind = boulderKind(target) or "Boulder"
                local hp = boulderHealth(target)

                if hp and hp <= 0 then
                    lastSpot = root.CFrame
                    beginLoot(false)
                    return
                end

                if not anchor or not anchor.Parent or not anchor:IsDescendantOf(target) then
                    anchor = visibleAnchor(target) or anchorOf(target)
                    spotFrame = nil
                end

                local core = coreSpot(target)
                local center = core or anchorSpot(target, anchor)

                if not center then
                    lostClock = lostClock + deltaTime

                    if lostClock >= LOST_GRACE then
                        lastSpot = root.CFrame
                        beginLoot(false)
                        return
                    end

                    statusText = string.format("Holding %s", kind)
                    return
                end

                lostClock = 0

                if not spotFrame then
                    if core and probeIndex == 0 then
                        spotFrame = coreFrame(core, anchor)
                    else
                        spotFrame = approach(anchor, target, aimTurn, center, PROBE_DIST[probeIndex % #PROBE_DIST + 1])
                    end
                end

                if spotFrame then
                    FM.ownedSetNoclip("AutoBoulder", true, false)
                    hold(spotFrame, center)
                    statusText = string.format("Mining %s", kind)
                end

                if heldPick == nil or heldPick.Parent ~= LocalPlayer.Character then
                    equipClock = 0
                    heldPick = equipPick()
                else
                    equipClock = equipClock + deltaTime
                    if equipClock >= EQUIP_STEP then
                        equipClock = 0
                        heldPick = equipPick() or heldPick
                    end
                end

                
                local toolOk = heldPick ~= nil
                    or (S.farmDigTool == "Sledge Hammer" and LocalPlayer.Character
                        and LocalPlayer.Character:FindFirstChild("Sledge Hammer") ~= nil)
                if not toolOk then
                    statusText = "No pickaxe / sledge hammer"
                    return
                end
                
                if not heldPick and S.farmDigTool == "Sledge Hammer" then
                    heldPick = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                end

                swingClock = swingClock + deltaTime

                local gap = swingGap()
                local swung = 0

                if swingClock >= gap then
                    swung = math.min(math.floor(swingClock / gap), 4)
                    swingClock = swingClock - swung * gap

                    for _ = 1, swung do
                        swingBoulderWithMode(anchor, target, center, kind)
                    end
                end

                if hp then
                    if hpMark == nil or hp < hpMark - 0.001 then
                        hpMark = hp
                        dryRounds = 0
                        dryClock = 0
                        blindClock = 0
                    else
                        dryClock = dryClock + deltaTime
                        dryRounds = dryRounds + swung

                        if dryClock >= DRY_TIME or dryRounds >= DRY_ROUNDS then
                            dryClock = 0
                            dryRounds = 0
                            probeIndex = probeIndex + 1
                            aimTurn = (aimTurn + 1) % #AIM_ANGLES
                            anchor = freshAnchor(target) or visibleAnchor(target) or anchor
                            spotFrame = nil
                        end
                    end

                    statusText = string.format("Mining %s  %.0f hp", kind, hp)
                    return
                end

                if sightClear(root.Position, anchor, target) then
                    blindClock = 0
                else
                    blindClock = blindClock + deltaTime

                    if blindClock >= SIGHT_GRACE then
                        blindClock = 0
                        aimTurn = (aimTurn + 1) % #AIM_ANGLES
                        anchor = visibleAnchor(target) or anchor
                        spotFrame = nil
                    end
                end

                statusText = string.format("Mining %s", kind)

                return
            end

            if phase == "loot" then
                
                
                if pendingFinish then
                    pendingFinish = false
                    phase = "crystal_collect"
                    crystalCollectUntil = 0 
                    crystalCollectStarted = os.clock()
                    crystalRecoverTarget = nil
                    statusText = "Boulders empty — collecting crystals then runes"
                    return
                end

                
                if now < (lootUntil or 0) then
                    if lastSpot then
                        hold(lastSpot)
                    end
                    statusText = string.format("Next boulder in %.1fs", (lootUntil or 0) - now)
                    return
                end
                target = nil
                anchor = nil
                phase = "scan"
                statusText = "Next boulder"
                return
            end

            if phase == "crystal_collect" then
                local free = 0
                pcall(function()
                    free = FM.backpackFree and FM.backpackFree() or 0
                end)

                local function moveTo(pos)
                    if typeof(pos) ~= "Vector3" then return false end
                    local goal = CFrame.new(pos + Vector3.new(0, 3, 0))
                    if S.farmMode == "Teleport" then
                        pcall(function()
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.CFrame = goal
                        end)
                        return true
                    end
                    return hold(goal, pos)
                end

                local function firePickup(inst)
                    if not inst or not inst.Parent then return false end
                    pcall(function()
                        if HoldComplete then FM.queueHoldComplete(inst) end
                    end)
                    pcall(function()
                        if FM.grabCrystal then
                            FM.grabCrystal(inst, FM.crystalPrompt and FM.crystalPrompt(inst))
                        end
                    end)
                    pcall(function()
                        local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if not prompt and inst.Parent then
                            prompt = inst.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                        end
                        if prompt and typeof(fireproximityprompt) == "function" then
                            fireproximityprompt(prompt)
                        end
                    end)
                    return true
                end

                if free <= 0 then
                    statusText = "Bag full — waiting (collect paused)"
                    return
                end

                local cfg = FM.farmPickupCfg or { Enabled = false, MinValue = 0, MinLuck = 0, Tier = { All = true } }
                local filterEnabled = cfg.Enabled == true

                
                
                if not filterEnabled then
                    S._collectEmptySince = nil
                    phase = "reset"
                    waitUntil = now + 0.35
                    statusText = "Pickup disabled — skipping collect"
                    return
                end

                local minV = tonumber(cfg.MinValue) or 0
                local minL = tonumber(cfg.MinLuck)  or 0
                local tiers = cfg.Tier
                local hasTier = type(tiers) == "table" and next(tiers) and not tiers.All

                local function crystalOk(inst)
                    if not inst or not inst.Parent or not inst:IsA("BasePart") then return false end
                    if inst:GetAttribute("Collected") == true then return false end
                    if minV > 0 then
                        local val = tonumber(inst:GetAttribute("Value")) or 0
                        pcall(function()
                            if val <= 0 and FM.crystalValue then
                                val = tonumber(FM.crystalValue(inst)) or 0
                            end
                        end)
                        if val < minV then return false end
                    end
                    if minL > 0 then
                        local luck = nil
                        pcall(function()
                            if FM.crystalLuckStrict then luck = FM.crystalLuckStrict(inst) end
                        end)
                        if type(luck) ~= "number" then
                            local raw = tonumber(inst:GetAttribute("LuckBoost"))
                                or tonumber(inst:GetAttribute("Luck"))
                                or tonumber(inst:GetAttribute("LuckPercent"))
                            if raw and raw > 0 and raw < 1.5 then raw = raw * 100 end
                            luck = raw
                        end
                        if type(luck) ~= "number" or luck < minL then return false end
                    end
                    if hasTier then
                        local tn = tostring(inst:GetAttribute("TierName") or "")
                        local tierN = tonumber(inst:GetAttribute("Tier"))
                        local okTier = false
                        for k, v in pairs(tiers) do
                            if v == true or v == "true" then
                                if k == tn or tostring(k) == tn then okTier = true; break end
                                if TIER_NAMES and tierN and TIER_NAMES[tierN] == k then okTier = true; break end
                            end
                        end
                        if not okTier then return false end
                    end
                    return true
                end

                
                
                local best, bestDist = nil, 1e12
                pcall(function()
                    local things = Workspace:FindFirstChild("Things")
                    local folders = {}
                    if things then
                        folders[#folders + 1] = things:FindFirstChild("Crystals")
                        folders[#folders + 1] = things:FindFirstChild("DroppedCrystals")
                    end
                    folders[#folders + 1] = Workspace:FindFirstChild("Crystals")
                    folders[#folders + 1] = Workspace:FindFirstChild("DroppedCrystals")
                    for _, folder in ipairs(folders) do
                        if folder then
                            for _, child in ipairs(folder:GetChildren()) do
                                local part = child
                                if child:IsA("Model") then
                                    part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                                end
                                if part and part:IsA("BasePart") and crystalOk(part) then
                                    local w = tonumber(part:GetAttribute("WeightKg")) or 0
                                    if w <= free then
                                        local d = (part.Position - root.Position).Magnitude
                                        if d < bestDist then
                                            bestDist = d
                                            best = part
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)

                if best then
                    
                    crystalRecoverTarget = best
                    S._collectEmptySince = nil
                    if bestDist > 14 then
                        moveTo(best.Position)
                        statusText = string.format("Moving to crystal  %dm", math.floor(bestDist))
                    else
                        firePickup(best)
                        statusText = "Picking crystal"
                    end
                    return
                end

                
                
                crystalRecoverTarget = nil

                
                local runeTarget, runeDist = nil, 1e12
                pcall(function()
                    local folder = Workspace:FindFirstChild("DroppedRunes")
                    if not folder then return end
                    for _, child in ipairs(folder:GetChildren()) do
                        local part = child
                        if child:IsA("Model") then
                            part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                        end
                        if part and part:IsA("BasePart") and part.Parent then
                            local d = (part.Position - root.Position).Magnitude
                            if d < runeDist then
                                runeDist = d
                                runeTarget = part
                            end
                        end
                    end
                end)

                if runeTarget then
                    
                    S._collectEmptySince = nil
                    if runeDist > 12 then
                        moveTo(runeTarget.Position)
                        statusText = string.format("Moving to rune  %dm", math.floor(runeDist))
                    else
                        firePickup(runeTarget)
                        statusText = "Picking rune"
                    end
                    return
                end

                
                local since = S._collectEmptySince
                if not since then
                    S._collectEmptySince = now
                    statusText = "No matching loot — confirming clear..."
                    return
                end
                if (now - since) < 2.0 then
                    statusText = string.format("Confirming clear  %.1fs", now - since)
                    return
                end
                S._collectEmptySince = nil
                phase = "reset"
                waitUntil = now + 0.35
                statusText = "Loot done — finishing"
                return
            end

            if phase == "reset" then
                if now < waitUntil then
                    return
                end

                statusText = "Restarting server"
                WindUI:Notify({
                    Title = "FayyMeng",
                    Content = "All crystals & runes picked — rejoining",
                    Duration = 3,
                    Icon = "alert-circle",
                })
                stop()
                restart()
            end
        end

        local PICKAXE_REQ = {
            Mossite = "Titanium Spike",
            Voltite = "Celestial Apex",
            Gildrite = "Eclipse Fang",
            Rimeveil = "Voidreign",
            Nocturnite = "The Terminus",
        }

        local function setTargets(value)
            table.clear(targets)

            if type(value) == "table" then
                for key, flag in pairs(value) do
                    if type(key) == "string" and (flag == true or flag == "true") then
                        targets[key] = true
                    elseif type(flag) == "string" and flag ~= "" then
                        targets[flag] = true
                    elseif type(key) == "number" and type(flag) == "string" then
                        targets[flag] = true
                    end
                end
            elseif type(value) == "string" and value ~= "" then
                targets[value] = true
            end
        end

        local function ensureFarmHeartbeat()

            if farmConn then
                pcall(function() farmConn:Disconnect() end)
                farmConn = nil
            end
            farmConn = RunService.Heartbeat:Connect(function(deltaTime)
                if not active then
                    return
                end
                local ok, err = pcall(step, deltaTime)
                if not ok then
                    FM.reportError("boulderFarm", err)
                end
            end)
        end

        local function setActive(value)
            if type(value) == "table" then
                value = value.CurrentValue or value[1] or value.Value
            end
            value = value == true

            if not value then

                pcall(function()
