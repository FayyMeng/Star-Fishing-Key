                applyTier(vpCfg, map)
            end,
        })

        VBox:Input({
            Title = "Minimum Value",
            Flag  = "cfg_VeinMinValue",
            Desc = "Minimum value filter. 0 = any.",
            Value = "0",
            Placeholder = "0 / 1m",
            Callback = function(t)
                vpCfg.MinValue = parseNum(t)
            end,
        })

        VBox:Input({
            Title = "Minimum Luck",
            Flag  = "cfg_VeinMinLuck",
            Desc = "Minimum luck filter. 0 = any.",
            Value = "0",
            Placeholder = "0",
            Callback = function(t)
                vpCfg.MinLuck = parseNum(t)
            end,
        })
