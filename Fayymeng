                        if #payload >= 2 then break end  
                    end
                end
            end
        end

        if #payload == 0 then return false, "Nothing to throw" end

        
        
        
        local ok, err = pcall(function()
            if #payload == 1 then
                remote:FireServer(payload[1].bombId, payload[1].pos)
            else
                
                remote:FireServer(
                    payload[1].bombId, payload[1].pos,
                    payload[2].bombId, payload[2].pos
                )
