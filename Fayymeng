function FM.dropAllCrystals()
    local remote = FM.findRemote("CrystalDropRequest")
    if not remote then
        WindUI:Notify({
            Title = "Drop Crystals",
            Content = "CrystalDropRequest missing",
            Duration = 3,
            Icon = "alert-circle",
        })
        return
    end

    local crystals = FM.collectBackpackCrystals()
    if #crystals == 0 then
        WindUI:Notify({
            Title = "Drop Crystals",
            Content = "No crystals in backpack",
            Duration = 2,
            Icon = "alert-circle",
        })
        return
    end

    if S._droppingCrystals then
        return
    end
    S._droppingCrystals = true
    S._dropLockAt = os.clock()
    S._stopCrystalOps = false

    task.spawn(function()
        local timing = FM.getDropPickupTiming()
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local dropped = 0

        for _, tool in ipairs(crystals) do
            if S._stopCrystalOps then
                break
            end
            if tool and tool.Parent then
                FM.rememberDroppedCrystal(tool)

                if humanoid and tool.Parent ~= LocalPlayer.Character then
                    pcall(function()
                        humanoid:EquipTool(tool)
                    end)
                    task.wait(timing.dropEquip)
                end

                local held = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(tool.Name)
                local name = (held and held.Name) or tool.Name

                local ok = pcall(function()
                    remote:FireServer(name)
                end)
                if ok then
                    dropped = dropped + 1
                end
                task.wait(timing.dropGap)
            end
        end

        S._droppingCrystals = false
        WindUI:Notify({
            Title = "Drop Crystals",
            Content = string.format("Dropped %d (%s)", dropped, S.pickupMode or "Legit"),
            Duration = 2,
            Icon = dropped > 0 and "check" or "alert-circle",
        })
    end)
end

function FM.pickupAllDroppedCrystals()
    FM.markPickupBusy(2.5)
    local root = FM.getRoot()
    if not root then return end
    if S._pickingDropped then return end
    S._pickingDropped = true
    S._stopCrystalOps = false
    task.spawn(function()
        local origin = root.Position
        local radius = 120
        local targets, seen = {}, {}
        local function addPart(part)
            if not part or seen[part] or not part:IsA("BasePart") then return end
            if not FM.isInDroppedFolder(part) then return end
            if FM.getAttr(part, "Collected") == true then return end
            if not (FM.isCrystal(part) or FM.getAttr(part, "Value") ~= nil or FM.getAttr(part, "Tier") ~= nil) then return end
            if (part.Position - origin).Magnitude > radius then return end
            seen[part] = true
            targets[#targets + 1] = part
        end
        local function scan(folder)
            if not folder then return end
            for _, d in ipairs(folder:GetDescendants()) do
                if d:IsA("BasePart") then addPart(d) end
            end
        end
        scan(Workspace:FindFirstChild("DroppedCrystals"))
        scan(Workspace:FindFirstChild("DroppedRunes"))
        scan(Workspace:FindFirstChild("DroppedCrystal"))
        local things = Workspace:FindFirstChild("Things")
        if things then
            scan(things:FindFirstChild("DroppedCrystals"))
            scan(things:FindFirstChild("DroppedRunes"))
            scan(things:FindFirstChild("Crystals"))
            scan(things:FindFirstChild("DropCrystals"))
            scan(things:FindFirstChild("WorldCrystals"))
        end
        table.sort(targets, function(a, b)
            return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
        end)
        local picked = 0
        for _, crystal in ipairs(targets) do
            if S._stopCrystalOps then break end
            if crystal.Parent and FM.getAttr(crystal, "Collected") ~= true then
                local prompt = FM.crystalPrompt(crystal)
                local ok = false
                local Hold = HoldComplete or (FM.findRemote and FM.findRemote("CrystalHoldComplete"))
                if Hold then
                    ok = pcall(function() FM.queueHoldComplete(crystal) end)
                end
                if not ok then
                    ok = FM.grabCrystal(crystal, prompt)
                end
                if not ok and prompt then
                    ok = FM.firePrompt(prompt)
                end
                if ok then picked = picked + 1 end
                task.wait(0.08)
            end
        end
        S._pickingDropped = false
        WindUI:Notify({ Title = "Pickup Dropped", Content = string.format("Picked %d", picked), Duration = 3, Icon = picked > 0 and "check" or "alert-circle" })
    end)
end

function FM.setInstantPrompt(value)
    S.instantPromptActive = value == true
    S.instantAccumulator = math.huge

    if S._instantPromptHoldConn then
        S._instantPromptHoldConn:Disconnect()
        S._instantPromptHoldConn = nil
    end
    if S._instantPromptShownConn then
        S._instantPromptShownConn:Disconnect()
        S._instantPromptShownConn = nil
    end
    if S._instantDescendantConn then
        S._instantDescendantConn:Disconnect()
        S._instantDescendantConn = nil
    end
    if S._instantPromptServiceConn then
        S._instantPromptServiceConn:Disconnect()
        S._instantPromptServiceConn = nil
    end

    if not S.instantPromptActive then
        return
    end

    local ok, PPS = pcall(function()
        return game:GetService("ProximityPromptService")
    end)
    if not ok or not PPS then
        return
    end

    local lastFire = 0

    local function fireManual(prompt)
        if not prompt or not prompt.Parent then
            return
        end
        local now = os.clock()
        if now - lastFire < 0.08 then
            return
        end
        lastFire = now

        FM.firePrompt(prompt)

        local inst = prompt.Parent
        if inst and not inst:IsA("BasePart") then
        end
        local crystal = nil
        local node = prompt.Parent
        for _ = 1, 6 do
            if not node then
                break
            end
            if FM.isCrystal and FM.isCrystal(node) then
                crystal = node
                break
            end
            if node:IsA("BasePart") and FM.isCrystal and FM.isCrystal(node) then
                crystal = node
                break
            end
            if FM.getAttr and FM.getAttr(node, "Value") ~= nil then
                crystal = node
                break
            end
            node = node.Parent
        end
        if crystal and HoldComplete then
            pcall(function()
                FM.queueHoldComplete(crystal)
            end)
        end
    end

    S._instantPromptHoldConn = PPS.PromptButtonHoldBegan:Connect(function(prompt, player)
        if not S.instantPromptActive then
            return
        end
        if player ~= nil and player ~= LocalPlayer then
            return
        end
        fireManual(prompt)
    end)

    pcall(function()
        S._instantPromptShownConn = PPS.PromptTriggered:Connect(function(prompt, player)
            if not S.instantPromptActive then
                return
            end
            if player ~= nil and player ~= LocalPlayer then
                return
            end
            fireManual(prompt)
        end)
    end)
end

function FM.instantGrab()
    if not S.instantPromptActive then
        return
    end

    local root = FM.getRoot()
    if not root then
        return
    end

    local origin = root.Position
    local look = root.CFrame.LookVector
    local best, bestScore = nil, -1e9
    local maxDist = 14

    local function consider(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
            return
        end
        if prompt.Enabled == false then
            return
        end
        local parent = prompt.Parent
        local pos = nil
        if parent:IsA("BasePart") then
            pos = parent.Position
        elseif parent:IsA("Model") then
            local ok, pivot = pcall(function()
                return parent:GetPivot().Position
            end)
            pos = ok and pivot or nil
            if not pos then
                local p = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true)
                pos = p and p.Position
            end
        end
        if not pos then
            return
        end
        local offset = pos - origin
        local dist = offset.Magnitude
        if dist > maxDist then
            return
        end
        local dir = dist > 0.05 and offset.Unit or look
        local facing = look:Dot(dir)
        local score = facing * 12 - dist
        if score > bestScore then
            bestScore = score
            best = prompt
        end
    end

    if S.registry then
        for inst in pairs(S.registry) do
            if inst and inst.Parent then
                local prompt = FM.crystalPrompt and FM.crystalPrompt(inst) or nil
                if prompt then
                    consider(prompt)
                end
            end
        end
    end

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character or LocalPlayer }
    pcall(function()
        params.MaxParts = 40
    end)
    local ok, parts = pcall(function()
        return Workspace:GetPartBoundsInRadius(origin, maxDist, params)
    end)
    if ok and parts then
        for _, part in ipairs(parts) do
            if part and part.Parent then
                local prompt = part:FindFirstChildOfClass("ProximityPrompt")
                    or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                if not prompt and part.Parent then
                    prompt = part.Parent:FindFirstChildOfClass("ProximityPrompt")
                end
                if prompt then
                    consider(prompt)
                end
            end
        end
    end

    if best then
        FM.firePrompt(best)
        local node = best.Parent
        for _ = 1, 6 do
            if not node then
                break
            end
            if HoldComplete and FM.getAttr and FM.getAttr(node, "Value") ~= nil then
                pcall(function()
                    FM.queueHoldComplete(node)
                end)
                break
            end
            if HoldComplete and FM.isCrystal and FM.isCrystal(node) then
                pcall(function()
                    FM.queueHoldComplete(node)
                end)
                break
            end
            node = node.Parent
        end
    end
end

function FM.pickupStep(filterFunc)
    local now = os.clock()

    local cooldown, burstLimit
    if filterFunc then
        cooldown, burstLimit = FM.getPickupTiming()
    else
        cooldown = PICK.cooldown
        burstLimit = PICK.burst
    end

    if now - S.lastPickup < cooldown then
        return
    end

    local root = FM.getRoot()
    if not root then
        return
    end

    local free = FM.backpackFree()
    if free <= 0 then
        if now - S.lastBagWarn >= 12 then
            S.lastBagWarn = now
            WindUI:Notify({
                Title = "FayyMeng",
                Content = "Backpack full - pickup paused",
                Duration = 2,
                Icon = "alert-circle",
            })
        end
        return
    end

    for inst, stamp in pairs(claimed) do
        if now - stamp >= PICK.forget or not inst.Parent then
            claimed[inst] = nil
        end
    end

    local list = FM.pickupCandidates(free, root.Position, filterFunc)
    if #list == 0 then
        if free > 0.5 then
            FM.requestStream(root.Position)
        end
        return
    end

    local budget = free
    local grabs = 0

    for _, entry in ipairs(list) do
        if grabs >= burstLimit then
            break
        end
        if entry.weight <= budget then
            claimed[entry.inst] = now
            if FM.grabCrystal(entry.inst, entry.prompt) then
                budget = budget - entry.weight
                grabs = grabs + 1
            end
        end
    end

    if grabs > 0 then
        S.lastPickup = now
        if not S.farmActive and not S.miningBoulder then
            FM.markPickupBusy(0.3 + grabs * 0.05)
        end
    end
end

function FM.tryFilteredCrystalPickup(origin, free, ownedLastAt)
    if free == nil then
        free = FM.backpackFree()
    end
    if free <= 0 then
        return false
    end
    local filterOn = S.pickupValueActive or S.pickupLuckActive or S.pickupRarityActive
        or (FM.farmPickupCfg and FM.farmPickupCfg.Enabled)
        or ((tonumber(S.minValue) or 0) > 0)
        or ((tonumber(S.minLuck) or 0) > 0)
    if not filterOn then
        return false
    end

    local now = os.clock()
    local cooldown, burstLimit = FM.getPickupTiming()

    local lastAt = ownedLastAt and (ownedLastAt.lastFilteredPickup or 0) or (S.lastFilteredPickup or 0)
    if now - lastAt < cooldown then
        return false
    end

    local list = FM.pickupCandidates(free, origin, FM.valueLuckFilter)
    if not list or #list == 0 then
        return false
    end

    local grabs = 0
    for _, entry in ipairs(list) do
        if grabs >= burstLimit then
            break
        end
        if entry.inst and entry.inst.Parent and FM.getAttr(entry.inst, "Collected") ~= true then
            if entry.weight <= free then
                claimed[entry.inst] = now
                if FM.grabCrystal(entry.inst, entry.prompt) then
                    free = free - entry.weight
                    grabs = grabs + 1
                end
            end
        end
    end

    if grabs > 0 then
        if ownedLastAt then

            ownedLastAt.lastFilteredPickup = now
        else

            S.lastFilteredPickup = now
            S.lastPickup = now
            if not S.farmActive and not S.miningBoulder then
                FM.markPickupBusy(0.3 + grabs * 0.05)
            end
        end
        return true
    end
    return false
end

function FM.updateBackpackLabel()
    if not S.BackpackLabel then
