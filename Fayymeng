    S._veinDeposits = nil
    S._veinFarmTarget = nil
    S._veinLootPhase = false
    S.miningBoulder = nil
    S.rootPart = nil
    if not S.boulderFarmActive and not S.moneyFarmActive and not S.veinFarmActive then
