        local function buyAllAvailableBombs()
            local query = BombShopQuery
            local buyReq = BombBuyRequest
            if not query or not buyReq then
                return 0
            end
            local ok, data = pcall(function()
                return query:InvokeServer()
            end)
            if not ok or not data or not data.stock then
                return 0
            end
            local boughtTotal = 0
            local jobs = {}
            for bombId, amount in pairs(data.stock) do
                local count = tonumber(amount) or 0
                for _ = 1, math.max(0, count) do
                    jobs[#jobs + 1] = bombId
                end
            end
            
            local done = 0
            local active = 0
            local maxParallel = 12
            local idx = 1
            while idx <= #jobs or active > 0 do
                while active < maxParallel and idx <= #jobs do
                    local bombId = jobs[idx]
                    idx = idx + 1
                    active = active + 1
                    task.spawn(function()
                        local success, res = pcall(function()
                            return buyReq:InvokeServer(bombId)
                        end)
                        if success and res and res.ok then
                            boughtTotal = boughtTotal + 1
                        end
                        active = active - 1
                        done = done + 1
                    end)
                end
                task.wait()
            end
            return boughtTotal
