function FM.meetsFilter(inst, value)
    if S.valueFilter then
        local v = value
        if v == nil then
            v = FM.crystalValue and FM.crystalValue(inst) or 0
        end
        if (tonumber(v) or 0) < (tonumber(S.minValue) or 0) then
            return false
        end
    end
    local minL = tonumber(S.minLuck) or 0
    if minL > 0 then
        local luck = nil
        pcall(function()
            luck = FM.crystalLuckStrict and FM.crystalLuckStrict(inst)
        end)
        if type(luck) ~= "number" or luck + 1e-9 < minL then
            return false
        end
    end
    -- ESP By Mutations filter: only show crystals whose mutation matches the selected set
    if S.espMutActive then
        local filter = S.espMutFilter
        if type(filter) == "table" and not filter.All and next(filter) then
            local primary = FM.getAttr and FM.getAttr(inst, "Mutation") or ""
            primary = tostring(primary or "")
            local extra  = FM.getAttr and FM.getAttr(inst, "ExtraMutations") or ""
            extra = tostring(extra or "")
            local matched = false
            for mutName, v in pairs(filter) do
                if v == true or v == "true" then
                    local mn = string.lower(tostring(mutName))
                    if mn ~= "" then
                        if string.lower(primary) == mn then matched = true break end
                        if extra ~= "" and string.lower(extra):find(mn, 1, true) then matched = true break end
                    end
                end
            end
            if not matched then return false end
        end
    end
    return true
end

