        trackConn(button:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            if open then place() end
        end))

        trackConn(button:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if open then place() end
        end))

        updateCanvas()

        return {
            Popup = popup,
            Button = button,
            Close = function()
