        if not root then
            return false, "No character"
        end
        local origin = root.Position
        local decorations = Workspace:FindFirstChild("MountainDecorations")
        local folder = decorations and decorations:FindFirstChild("Boulders")
        if not folder then
            folder = Workspace:FindFirstChild("Boulders")
        end
        local best, bestD = nil, 1e9
        local function consider(model)
            if not model then return end
            local n = model.Name or ""
            if kindName ~= "" and kindName ~= "Any" and not n:find(kindName, 1, true) then
                return
            end
            local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
            if not part then return end
            local d = (part.Position - origin).Magnitude
            if d < bestD then
                bestD = d
                best = part
            end
        end
        if folder then
            for _, ch in ipairs(folder:GetChildren()) do
                consider(ch)
            end
        end
        if not best then
            return false, "No boulder nearby"
        end
        local bombId = "ClassicBomb"
        local info = BOMB_VEIN_INFO and BOMB_VEIN_INFO[S._shortcutThrowVein or ""]
        if info and info.bombId then
            bombId = info.bombId
        end
        if type(pickBombForVein) == "function" then
            local bomb = pickBombForVein(S._shortcutThrowVein or "Gunpowder Stone")
            if bomb and bomb.bombId then
                bombId = bomb.bombId
            end
        end
        local remote = nil
        pcall(function()
            local folderR = ReplicatedStorage:FindFirstChild("Remotes")
            remote = folderR and folderR:FindFirstChild("BombActivate")
        end)
        if not remote and FM.findRemote then
            remote = FM.findRemote("BombActivate")
        end
        if not remote then
            return false, "BombActivate missing"
        end
        local pos = best.Position
        local ok = pcall(function()
            remote:FireServer(bombId, pos)
        end)
        if ok then
            return true, bombId .. " -> boulder @ " .. math.floor(bestD) .. "m"
        end
        return false, "FireServer failed"
    end

