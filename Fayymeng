            local above = standAbove()
            local ySign = above and 1 or -1
            local yPad = above and 3.5 or 3.5

            if model:IsA("BasePart") then
                return model.Position + Vector3.new(0, ySign * (model.Size.Y * 0.5 + yPad), 0)
            end

            local boxed, cf, size = pcall(function()
                local c, s = model:GetBoundingBox()
                return c, s
            end)
            if boxed and cf then
                local halfY = (typeof(size) == "Vector3" and size.Y or 8) * 0.5
                return cf.Position + Vector3.new(0, ySign * (halfY + yPad), 0)
            end

            local ok, pivot = pcall(model.GetPivot, model)
            if ok and pivot then
                return pivot.Position + Vector3.new(0, ySign * 6, 0)
            end

            return nil
        end

        local function coreFrame(core, part)
