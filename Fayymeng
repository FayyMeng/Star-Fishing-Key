        local function resolveDigHit(preferPos)
            local root = FM.getRoot()
            if not root then
                return nil
            end
            refreshDigFilter()
            local maxReach = 14
            if typeof(preferPos) == "Vector3" then
                local origin = root.Position + Vector3.new(0, 1.5, 0)
                local delta = preferPos - origin
                local dist = delta.Magnitude
                if dist > 0.05 then
                    local dir = delta.Unit
                    local hit = Workspace:Raycast(origin, dir * math.min(dist + 2, maxReach), digRayParams)
                    if hit then
                        return hit.Position
                    end

                    local down = Workspace:Raycast(preferPos + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), digRayParams)
                    if down then
                        return down.Position
                    end
                    if dist <= maxReach then
                        return preferPos
                    end
                    return origin + dir * (maxReach - 0.5)
                end
            end
            local cam = Workspace.CurrentCamera
            if cam then
                local look = cam.CFrame.LookVector
                local hit = Workspace:Raycast(cam.CFrame.Position, look * maxReach, digRayParams)
                if hit then
                    return hit.Position
                end
                hit = Workspace:Raycast(root.Position, look * maxReach, digRayParams)
                if hit then
                    return hit.Position
                end
            end
            local down = Workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), digRayParams)
            if down then
                return down.Position
            end
            return root.Position + root.CFrame.LookVector * 6
        end

        local function boulderShape(model)

            if not model then return nil, nil end
            local ok, cf, size = pcall(function()
                return model:GetBoundingBox()
            end)
            if ok and typeof(cf) == "CFrame" and typeof(size) == "Vector3" then
                return cf, size
            end

            local minV = Vector3.new(1e9, 1e9, 1e9)
            local maxV = Vector3.new(-1e9, -1e9, -1e9)
            local any = false
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") then
                    any = true
                    local p = d.Position
                    local h = d.Size * 0.5
                    minV = Vector3.new(
                        math.min(minV.X, p.X - h.X),
                        math.min(minV.Y, p.Y - h.Y),
                        math.min(minV.Z, p.Z - h.Z)
                    )
                    maxV = Vector3.new(
                        math.max(maxV.X, p.X + h.X),
                        math.max(maxV.Y, p.Y + h.Y),
                        math.max(maxV.Z, p.Z + h.Z)
                    )
                end
            end
            if not any then return nil, nil end
            local center = (minV + maxV) * 0.5
            local size2 = maxV - minV
            return CFrame.new(center), size2
        end

        local function buildPredigPoints(model)
            local points = {}
            local cf, size = boulderShape(model)
            if not cf or not size then
                return points
            end
            local half = size * 0.5

            
            local expand = 18
            local spanX = half.X + expand
            local spanZ = half.Z + expand
            local bottomY = -half.Y - 2.5
            local step = 2.8

            for x = -spanX, spanX, step do
                for z = -spanZ, spanZ, step do
                    local world = cf:PointToWorldSpace(Vector3.new(x, bottomY, z))
                    local hit = Workspace:Raycast(world + Vector3.new(0, 16, 0), Vector3.new(0, -50, 0))
                    if hit and hit.Position then
                        points[#points + 1] = hit.Position
                    else
                        points[#points + 1] = world
                    end
                end
            end

            local outer = expand + 4
            local ring = {
                Vector3.new(half.X + outer, bottomY, 0),
                Vector3.new(-(half.X + outer), bottomY, 0),
                Vector3.new(0, bottomY, half.Z + outer),
                Vector3.new(0, bottomY, -(half.Z + outer)),
                Vector3.new(half.X + outer, bottomY, half.Z + outer),
                Vector3.new(-(half.X + outer), bottomY, half.Z + outer),
                Vector3.new(half.X + outer, bottomY, -(half.Z + outer)),
                Vector3.new(-(half.X + outer), bottomY, -(half.Z + outer)),
            }
            for _, off in ipairs(ring) do
                local world = cf:PointToWorldSpace(off)
                local hit = Workspace:Raycast(world + Vector3.new(0, 16, 0), Vector3.new(0, -50, 0))
                if hit and hit.Position then
                    points[#points + 1] = hit.Position
                else
                    points[#points + 1] = world
                end
            end
            return points
        end

