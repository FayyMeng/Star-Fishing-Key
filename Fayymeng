                dig:FireServer(name, pos + Vector3.new(2, 0, 0))
                dig:FireServer(name, pos + Vector3.new(-2, 0, 0))
                dig:FireServer(name, pos + Vector3.new(0, 0, 2))
                dig:FireServer(name, pos + Vector3.new(0, 0, -2))
            end)
            fired = true
        end
        return fired
    end

    
    local function veinKey(pos)
        if typeof(pos) ~= "Vector3" then return nil end
        return string.format("%d:%d:%d", math.floor(pos.X / 8), math.floor(pos.Y / 8), math.floor(pos.Z / 8))
    end

    local function pruneStuck(now)
        now = now or os.clock()
        S._veinStuck = S._veinStuck or {}
        for k, at in pairs(S._veinStuck) do
            if type(at) ~= "number" or (now - at) > 45 then
                S._veinStuck[k] = nil
            end
        end
    end

    local function markStuck(key, now)
        if key == nil then return end
        S._veinStuck = S._veinStuck or {}
        S._veinStuck[tostring(key)] = now or os.clock()
    end

    local function abortVeinTarget(reason)
        digSession = nil
        S._veinFarmTarget = nil
        if type(reason) == "string" and reason ~= "" then
            S._veinFarmStatus = reason
        end
    end

    local function filterPickupEnabled()
        if type(hasActiveFilter) == "function" then
            local ok, res = pcall(hasActiveFilter)
            if ok and res == true then return true end
        end
        local systems = {
            FM and FM.VeinPickupSystem,
            FM and FM.MoneyPickupSystem,
            FM and FM.BoulderPickupSystem,
        }
        for _, sys in ipairs(systems) do
            if sys and sys.Config then
                local c = sys.Config
                if (tonumber(c.MinValue) or 0) > 0 then return true end
                if (tonumber(c.MinLuck) or 0) > 0 then return true end
                if type(c.Tier) == "table" and next(c.Tier) and not c.Tier.All then return true end
                if c.PresetValue and tostring(c.PresetValue) ~= "None" then return true end
                if c.PresetLuck and tostring(c.PresetLuck) ~= "None" then return true end
            end
        end
        return false
    end

    local function pickNearestDeposit(origin, deposits, now)
        if typeof(origin) ~= "Vector3" or type(deposits) ~= "table" then
            return nil, nil
        end
        now = now or os.clock()
        S._veinStuck = S._veinStuck or {}
        local want = tostring(S._veinFarmType or S._veinTypeName or selectedName or "")
        local anyType = (S._veinFarmAnyType == true) or want == "" or want == "All"
            or (tostring(want):find("All", 1, true) ~= nil)
        local best, bestD = nil, 1e9
        for _, d in ipairs(deposits) do
            if d and typeof(d.pos) == "Vector3" then
                local lab = tostring(d.matName or d.label or "")
                local key = veinKey(d.pos)
                local stuck = key and S._veinStuck[key] and (now - S._veinStuck[key]) < 20
                if not stuck then
                    local okMatch = false
                    local ll = string.lower(lab)
                    if anyType then
                        okMatch = (ll:find("aether", 1, true) ~= nil)
                            or (ll:find("lava", 1, true) ~= nil)
                            or (ll:find("prisma", 1, true) ~= nil)
                    else
                        local wl = string.lower(want)
                        local base = string.lower((want:gsub(" Vein", "")))
                        okMatch = (base ~= "" and ll:find(base, 1, true) ~= nil)
                            or (wl:find("aether", 1, true) and ll:find("aether", 1, true))
                            or (wl:find("lava", 1, true) and ll:find("lava", 1, true))
                            or (wl:find("prisma", 1, true) and ll:find("prisma", 1, true))
                    end
                    if okMatch then
                        local dist = (d.pos - origin).Magnitude
                        if dist < bestD then
                            bestD = dist
                            best = d
                        end
                    end
                end
            end
        end
        return best, bestD
    end

    local function depositStillPresent(pos, deposits)
        if typeof(pos) ~= "Vector3" or type(deposits) ~= "table" then
            return false, nil
        end
        local best, bestD = nil, 24
        for _, d in ipairs(deposits) do
            if d and typeof(d.pos) == "Vector3" then
                local dist = (d.pos - pos).Magnitude
                if dist < bestD then
                    bestD = dist
                    best = d
                end
            end
        end
        if best then return true, best end
        return false, nil
    end

    local function veinGetPick()
        local want = tostring(S.farmDigTool or S.autoDigTool or S.standaloneDigTool or "Pickaxe")
        local char = LocalPlayer.Character
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local function matchTool(tool, wantSledge)
            if not tool or not tool:IsA("Tool") then return false end
            local n = tool.Name or ""
            if wantSledge then return n:find("Sledge", 1, true) ~= nil end
            return n:find("Pick", 1, true) ~= nil or n:find("Axe", 1, true) ~= nil
        end
        local wantSledge = (want == "Sledge Hammer")
        local found = nil
        local function scan(container)
            if not container then return end
            for _, ch in ipairs(container:GetChildren()) do
                if matchTool(ch, wantSledge) then
                    found = ch
                    return
                end
            end
        end
        scan(char)
        if not found then scan(bp) end
        if not found and wantSledge then
            scan(bp); scan(char)
            if not found then
                for _, cont in ipairs({ bp, char }) do
                    if cont then
                        for _, ch in ipairs(cont:GetChildren()) do
                            if matchTool(ch, false) then found = ch break end
                        end
                    end
                    if found then break end
                end
            end
        end
        if found and char and bp and found.Parent == bp then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:EquipTool(found) end) end
        end
        return found
    end

    local function veinSwingNeed(pick)
        if tostring(S.farmDigTool or S.autoDigTool or "") == "Sledge Hammer" then
            return 0.14
        end
        return 0.18
    end

    local function veinSwing(pick, pos, root)
        if typeof(pos) ~= "Vector3" then return false end
        local tool = tostring(S.farmDigTool or S.autoDigTool or "Pickaxe")
        if tool == "Sledge Hammer" then
            local remote = FM.findRemote and FM.findRemote("SledgeSwing")
            if not remote then
                pcall(function()
                    local r = ReplicatedStorage:FindFirstChild("Remotes")
                    remote = r and r:FindFirstChild("SledgeSwing")
                end)
            end
            if remote then
                local ok = pcall(function()
                    remote:FireServer(pos)
                    remote:FireServer(pos + Vector3.new(0, -1.5, 0))
                    remote:FireServer(pos + Vector3.new(1.5, 0, 0))
                    remote:FireServer(pos + Vector3.new(-1.5, 0, 0))
                end)
                if ok then return true end
            end
        end
        local dig = FM.findRemote and FM.findRemote("DigRequest")
        if not dig then
            pcall(function()
                local r = ReplicatedStorage:FindFirstChild("Remotes")
                dig = r and r:FindFirstChild("DigRequest")
            end)
        end
        local name = (pick and type(pick.Name) == "string" and pick.Name) or "Pickaxe"
        if dig then
            local ok = pcall(function()
                dig:FireServer(name, pos)
                dig:FireServer(name, pos - Vector3.new(0, 1.2, 0))
                dig:FireServer(name, pos + Vector3.new(0, 1.0, 0))
                dig:FireServer(name, pos + Vector3.new(2, 0, 0))
                dig:FireServer(name, pos + Vector3.new(-2, 0, 0))
                dig:FireServer(name, pos + Vector3.new(0, 0, 2))
                dig:FireServer(name, pos + Vector3.new(0, 0, -2))
            end)
            if ok then return true end
        end
        return false
    end

    function FM.setVeinFarm(on)
        if type(on) == "table" then
            on = on.CurrentValue or on[1] or on.Value
        end

        S.veinSession = (tonumber(S.veinSession) or 0) + 1
        local newSession = S.veinSession

        if veinFarmConn then
            pcall(function() veinFarmConn:Disconnect() end)
            veinFarmConn = nil
        end

        S.veinFarmActive = on == true
        do
            local tool = tostring(S.farmDigTool or S.autoDigTool or S.standaloneDigTool or "Pickaxe")
            if tool ~= "Sledge Hammer" then tool = "Pickaxe" end
            S.farmDigTool = tool
            S.autoDigTool = tool
        end
        veinDigClock = 0
        veinMoveAt = 0
        veinPickClock = 0
        S._veinFarmTarget = nil
        digSession = nil
        lootPhase = false
        lootEmptySince = 0
        S._veinLootPhase = false
        skipGen = (tonumber(skipGen) or 0) + 1
        prismOrbitIdx = 1
        prismOrbitAt = 0
        prismOrbitWaypoints = nil
        prismOrbitBuiltAt = 0

        if not S.veinFarmActive then
            if _voxelCache then
                _voxelCache.key = nil
                _voxelCache.mats = nil
                _voxelCache.at = 0
            end
            S._veinFarmAnyType = false

            if not (S._shortcutVeinEsp or S._shortcutBombVeinEsp or S.veinScannerActive) then
                active = false
                if pulseConn then
                    pcall(function() pulseConn:Disconnect() end)
                    pulseConn = nil
                end
                clearMarkers()
            end

            if FM.VeinPickupSystem then
                FM.VeinPickupSystem:StopRuntime()
            end

            S._slowMove = false
            digSession = nil
            lootPhase = false
            lootEmptySince = 0
            S._veinLootPhase = false
            S._veinFarmTarget = nil

            S._pickupBusyUntil = 0

            local prevFly = S._veinPrevFly == true
            local prevNoclip = S._veinPrevNoclip == true
            S._veinPrevFly = nil
            S._veinPrevNoclip = nil

            pcall(function()
                if MovementOwner and MovementOwner.Release then
                    MovementOwner:Release("AutoVein")
                end
            end)

            pcall(function()
                if Move and Move.glideStop then Move.glideStop() end
            end)
            pcall(function()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = false
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
            end)

            pcall(function()
                if Move and Move.setFly then
                    Move.setFly(prevFly == true)
                end
            end)

            pcall(function()
                if FM.ownedSetNoclip then
                    FM.ownedSetNoclip("AutoVein", false, false)
                end
            end)
            pcall(function()
                if MovementOwner and not MovementOwner:HasAny() then
                    if Move and Move.setNoclip then
                        Move.setNoclip(false, false)
                    end
                end
            end)
            return
        end

        S._slowMove = true
        if S._veinFarmAnyType or tostring(S._veinFarmType or "") == "All" then
            S._multiVeinEsp = true
        end
        pcall(function()
            if FM.setVeinScanner then FM.setVeinScanner(true) end
        end)
        pruneStuck(os.clock())

        S._veinPrevFly = S._flyWanted == true
        S._veinPrevNoclip = S._noclipWanted == true

        pcall(function()
            if MovementOwner and MovementOwner.Acquire then
                MovementOwner:Acquire("AutoVein")
            end
        end)
        pcall(function()
            FM.ownedSetNoclip("AutoVein", true, false)
            FM.ownedSetFly("AutoVein", true)
        end)

        if FM.VeinPickupSystem then
            local ok, err = pcall(function() FM.VeinPickupSystem:StartRuntime() end)
            if not ok then warn("[VeinPickup] StartRuntime error:", err) end
        end
        S._veinFarmStatus = "Starting — streaming terrain"
        task.spawn(function()
            local sid = newSession
            local root = FM.getRoot and FM.getRoot()
            local origin = (root and root.Position) or Vector3.new(0, 40, 0)

            local STREAM_POINTS = {
                origin,
                Vector3.new(-19.3, 120, 534.8),
                Vector3.new(41.7, 200, 246.6),
                Vector3.new(0, 300, 400),
                Vector3.new(80, 400, 100),
                Vector3.new(-80, 350, 600),
                Vector3.new(-12.7, 459, 818.8),
                Vector3.new(13.0, 318, -488.0),
                Vector3.new(74.4, 610, 210.8),
            }
            for _, pt in ipairs(STREAM_POINTS) do
                if S.veinSession ~= sid or not S.veinFarmActive then return end
                pcall(function()
                    LocalPlayer:RequestStreamAroundAsync(pt, 16)
                end)
                pcall(function()
                    if FM.requestStream then FM.requestStream(pt) end
                end)
                task.wait(0.08)
            end

            S.worldReady = true
            if S.veinSession == sid and S.veinFarmActive then
                pcall(scanOnce)
                lastScanAt = os.clock()
                S._veinFarmStatus = "Scanning veins"
            end
        end)
        pcall(scanOnce)
        lastScanAt = os.clock()

        local sid = newSession
        veinFarmConn = RunService.Heartbeat:Connect(function(dt)
            if not S.veinFarmActive or S.veinSession ~= sid then
                return
            end
            local root = FM.getRoot and FM.getRoot() or nil
            if not root then
                return
            end
            local now = os.clock()
            dt = dt or 0.016

            pcall(function()
                local v = root.AssemblyLinearVelocity
                if v.Y < -2 or v.Y > 12 then
                    root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
                end
            end)

            S._veinFarmAcc = (S._veinFarmAcc or 0) + dt
            if S._veinFarmAcc < 0.08 then
                return
            end
            local stepDt = S._veinFarmAcc
            S._veinFarmAcc = 0
            dt = stepDt

            do
                local st = tostring(S._veinFarmStatus or "")
                if st ~= (S._veinWatchStatus or "") then
                    S._veinWatchStatus = st
                    S._veinWatchAt = now
                elseif S.veinFarmActive and (now - (S._veinWatchAt or now)) > 28 then
                    S._veinWatchAt = now
                    if _voxelCache then
                        _voxelCache.key = nil
                        _voxelCache.mats = nil
                        _voxelCache.at = 0
                    end
                    lastScanAt = 0
                    pcall(scanOnce)
                    S._veinFarmStatus = "Watchdog rescan"
                end
            end

            if not veinLastPrune or (now - veinLastPrune) >= 4 then
                veinLastPrune = now
                pruneStuck(now)
            end

            local origin = root.Position
            local filterOn = filterPickupEnabled()
            if filterOn then
                veinPickClock = (veinPickClock or 0) + dt
                local tickRate = ((S.pickupMode or "Legit") == "Burst") and 0.12 or 0.28
                if veinPickClock >= tickRate then
                    veinPickClock = 0
                    doFilteredPickup(origin)
                end

                local near = countFilteredNear(origin)
                if near > 0 then
                    lootPhase = true
                    lootEmptySince = 0
                    S._veinLootPhase = true
                    S._veinFarmStatus = string.format("Pickup %d crystal(s)", near)
                elseif lootPhase then
                    if lootEmptySince == 0 then
                        lootEmptySince = now
                    elseif (now - lootEmptySince) >= LOOT_STABLE then
                        lootPhase = false
                        lootEmptySince = 0
                        S._veinLootPhase = false
                        S._veinFarmStatus = "Loot done — next vein"
                    else
                        S._veinLootPhase = true
                    end
                else
                    S._veinLootPhase = false
                end
            else
                lootPhase = false
                lootEmptySince = 0
                S._veinLootPhase = false
            end

            if lootPhase or S._veinLootPhase then
                if lootEmptySince == 0 then
                    lootEmptySince = now
                elseif (now - lootEmptySince) > 8 then
                    lootPhase = false
                    lootEmptySince = 0
                    S._veinLootPhase = false
                    S._veinFarmStatus = "Loot timeout — next vein"
                else
                    return
                end
            end

            local deposits = S._veinDeposits
            if type(deposits) ~= "table" or #deposits == 0 then
                if (now - (lastScanAt or 0)) > 1.2 then
                    if _voxelCache then
                        _voxelCache.key = nil
                        _voxelCache.mats = nil
                    end
                    pcall(scanOnce)
                    lastScanAt = now
                end

                if (not S._veinFarmAnyType) and isPrismariteVeinSelected and isPrismariteVeinSelected() then
                    if not prismOrbitWaypoints or (now - (prismOrbitBuiltAt or 0)) > 20 then
                        local list = {}
                        pcall(function()
                            if FM.listBoulderPositions then
                                list = FM.listBoulderPositions() or {}
                            end
                        end)
                        if type(list) ~= "table" or #list == 0 then

                            list = buildPrismOrbitWaypoints() or {}
                        end
                        prismOrbitWaypoints = list
                        prismOrbitBuiltAt = now
                        if not prismOrbitIdx or prismOrbitIdx < 1 then
                            prismOrbitIdx = 1
                        end
                    end
                    local wps = prismOrbitWaypoints
                    if type(wps) == "table" and #wps > 0 then
                        if prismOrbitIdx > #wps then
                            prismOrbitIdx = 1
                            prismOrbitBuiltAt = 0
                        end
                        local wp = wps[prismOrbitIdx]
                        if typeof(wp) == "Vector3" then
                            local dist = (wp - origin).Magnitude
                            S._veinFarmStatus = string.format("Prism boulder %d/%d", prismOrbitIdx, #wps)
                            if dist > 14 then
                                if now - (prismOrbitAt or 0) > 1.35 then
                                    prismOrbitAt = now
                                    pcall(function()
                                        S._slowMove = true
                                        local stand = wp + Vector3.new(0, 4, 0)
                                        if FM.moveTo then
                                            FM.moveTo(stand, wp)
                                        elseif FM.travelTo then
                                            FM.travelTo(stand, wp)
                                        end
                                    end)
                                end
                            else
                                pcall(scanOnce)
                                lastScanAt = now

                                local deps = S._veinDeposits
                                if type(deps) == "table" and #deps > 0 then
                                    S._veinFarmStatus = "Vein found near boulder"
                                    return
                                end
                                prismOrbitIdx = prismOrbitIdx + 1
                            end
                        else
                            prismOrbitIdx = prismOrbitIdx + 1
                        end
                    end
                end
                return
            end

            local skipOn = S.skipVeinActive ~= false
            local skipSec = tonumber(S.skipVeinSeconds) or 3
            if skipSec < 1 then skipSec = 3 end

            if digSession and digSession.pos then
                local sess = digSession
                local still, refreshed = depositStillPresent(sess.pos, deposits)

                if not still then

                    digSession = nil
                    S._veinFarmTarget = nil
                    S._veinFarmStatus = "Vein cleared — pickup"
                    if filterPickupEnabled() then
                        lootPhase = true
                        lootEmptySince = 0
                        S._veinLootPhase = true
                    end

                elseif skipOn and sess.digStartedAt and (now - sess.digStartedAt) >= skipSec then

                    local myGen = sess.gen
                    markStuck(sess.key, now)
                    abortVeinTarget("Skip stuck vein")
                    if filterPickupEnabled() then
                        lootPhase = true
                        lootEmptySince = 0
                        S._veinLootPhase = true
                        S._veinFarmStatus = "Skipped — pickup first"
                    end
                    if myGen ~= skipGen then
                        return
                    end

                else

                    if refreshed then
                        S._veinFarmTarget = refreshed
                        sess.pos = refreshed.pos
                        sess.key = veinKey(refreshed.pos) or sess.key
                    end
                end

                if digSession and digSession.pos and skipOn then
                    local smartSec = tonumber(S.smartSkipVeinSeconds) or tonumber(S.skipVeinSeconds) or 3
                    if smartSec < 3 then smartSec = 3 end
                    if smartSec > 5 then smartSec = 5 end
                    local rootPos = root.Position
                    local sess2 = digSession
                    if typeof(sess2.lastRootPos) ~= "Vector3" then
                        sess2.lastRootPos = rootPos
                        sess2.stillSince = now
                    else
                        local moved = (rootPos - sess2.lastRootPos).Magnitude
                        if moved > 0.5 then
                            sess2.lastRootPos = rootPos
                            sess2.stillSince = now
                        elseif sess2.stillSince and (now - sess2.stillSince) >= smartSec then
                            local myGen = sess2.gen
                            markStuck(sess2.key, now)
                            abortVeinTarget("Smart skip — no movement")
                            if filterPickupEnabled() then
                                lootPhase = true
                                lootEmptySince = 0
                                S._veinLootPhase = true
                                S._veinFarmStatus = "Smart skip — next vein"
                            end
                            if myGen ~= skipGen then
                                return
                            end
                        end
                    end
                end
            end

            local origin = root.Position
            local best, bestD

            if digSession and digSession.pos and S._veinFarmTarget then
                best = S._veinFarmTarget
                bestD = (best.pos - origin).Magnitude
            else
                best, bestD = pickNearestDeposit(origin, deposits, now)
                if not best then

                    if (now - (lastScanAt or 0)) > 1.5 then
                        pcall(scanOnce)
                    end
                    return
                end

                local key = veinKey(best.pos)
                skipGen = (tonumber(skipGen) or 0) + 1
                digSession = {
                    key = key,
                    pos = best.pos,
                    gen = skipGen,
                    digStartedAt = nil,
                    lastDigAt = nil,
                    lastRootPos = nil,
                    stillSince = nil,
                    failSwing = 0,
                    standIdx = 1,
                }
                S._veinFarmTarget = best
            end

            if not best or typeof(best.pos) ~= "Vector3" then
                return
            end

            local yOff = 3.2
            if digSession and digSession.standIdx then
                local offs = { 3.2, 6.5, 1.2, 10.0, -1.5 }
                yOff = offs[((digSession.standIdx - 1) % #offs) + 1]
            end
            local stand = best.pos + Vector3.new(0, yOff, 0)
            if bestD > 6 then
                if now - (veinMoveAt or 0) > 0.85 then
                    veinMoveAt = now
                    pcall(function()
                        S._slowMove = true
                        if FM.moveTo then
                            FM.moveTo(stand, best.pos)
                        elseif FM.travelTo then
                            FM.travelTo(stand, best.pos)
                        end
                    end)
                end
                if bestD > 55 then
                    return
                end
            else
                pcall(function()
                    root.CFrame = CFrame.new(stand, best.pos)
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end

            
            if bestD > 20 then
                return
            end

            
            local tool = tostring(S.farmDigTool or S.autoDigTool or S.standaloneDigTool or "Pickaxe")
            if tool ~= "Sledge Hammer" then
                tool = "Pickaxe"
            end
            S.farmDigTool = tool
            S.autoDigTool = tool

            local swingNeed = (tool == "Sledge Hammer") and 0.12 or 0.16
            veinDigClock = (veinDigClock or 0) + dt
            if veinDigClock < swingNeed then
                return
            end
            veinDigClock = 0

            local fired = false
            pcall(function()
                if FM.equipPick then FM.equipPick() end
            end)
            pcall(function()
                if FM.digSwingAt then
                    fired = FM.digSwingAt(best.pos, nil) == true
                elseif FM.swingTerrainWithMode then
                    fired = FM.swingTerrainWithMode(best.pos, nil) == true
                end
            end)
            if not fired then
                pcall(function()
                    if type(veinSwing) == "function" then
                        local pick = veinGetPick and veinGetPick() or nil
                        fired = veinSwing(pick, best.pos, root) == true
                    end
                end)
            end
            S._veinFarmStatus = fired and "Digging vein" or "Digging…"

            if digSession and digSession.gen == skipGen then
                if fired then
                    digSession.lastDigAt = now
                    digSession.failSwing = 0
                    if not digSession.digStartedAt then
                        digSession.digStartedAt = now
                        S._veinFarmStatus = "Digging vein"
                    end
                else
                    digSession.failSwing = (digSession.failSwing or 0) + 1
                    if digSession.failSwing >= 3 then
                        digSession.standIdx = (digSession.standIdx or 1) + 1
                        digSession.failSwing = 0
                        S._veinFarmStatus = "Adjust stand height"
                    end
                    if digSession.standIdx and digSession.standIdx > 5 and (S.skipVeinActive ~= false) then
                        local myGen = digSession.gen
                        markStuck(digSession.key, now)
                        abortVeinTarget("Smart skip — dig failed")
                        if filterPickupEnabled() then
                            lootPhase = true
                            lootEmptySince = 0
                            S._veinLootPhase = true
                            S._veinFarmStatus = "Skip undiggable vein"
                        end
                        if myGen ~= skipGen then
                            return
                        end
                    end
                end
            end
