    function FM.viewAllSpecialVeins()
        local root = FM.getRoot and FM.getRoot() or nil
        if not root then
            return 0
        end
        local origin = root.Position
        local names = { "Aetherstone Vein", "Lava Vein", "Prismarite Vein" }
        local all = {}
        local seen = {}
        for _, vn in ipairs(names) do
            local preset = getPreset(vn)
            if preset then
                local ok, found = pcall(function()
                    return findDeposits(origin, preset)
                end)
                if ok and type(found) == "table" then
                    for _, d in ipairs(found) do
                        if d and typeof(d.pos) == "Vector3" then
                            local key = string.format("%d:%d:%d:%s", math.floor(d.pos.X / 12), math.floor(d.pos.Y / 12), math.floor(d.pos.Z / 12), vn)
                            if not seen[key] then
                                seen[key] = true
                                d.label = vn
                                d.color = preset.color
                                all[#all + 1] = d
                            end
                        end
                    end
                end
            end
        end
        table.sort(all, function(a, b)
            return (a.pos - origin).Magnitude < (b.pos - origin).Magnitude
        end)
        if #all == 0 then
            return 0
        end
        S._veinDeposits = all
        local n = math.min(#all, maxMarkers or 8)
        for i in pairs(markers) do
            if i > n then
                local m = markers[i]
                if m then
                    pcall(function()
                        if m.beam then m.beam:Destroy() end
                        if m.beamA then m.beamA:Destroy() end
                        if m.beamB then m.beamB:Destroy() end
                        if m.part then m.part:Destroy() end
                    end)
                    markers[i] = nil
                end
            end
        end
        for i = 1, n do
            local d = all[i]
            local preset = getPreset(d.label)
            local col = d.color or (preset and preset.color)
            local m = markers[i]
            if not m then
                m = makeMarker(preset)
                markers[i] = m
            end
            if m and m.part then
                m.part.Position = d.pos
            end
            if m and m.title then
                m.title.Text = string.upper(tostring(d.label or "Vein"))
                if col then m.title.TextColor3 = col end
            end
            if m and m.distLbl then
                m.distLbl.Text = string.format("%dm away", math.floor((d.pos - origin).Magnitude + 0.5))
                if col then m.distLbl.TextColor3 = col end
            end
            if i <= 3 and ensureBeam then
                ensureBeam(m, col)
            end
        end
        active = true
        return #all
    end

    local function resolveBombId(toolName)
        if type(toolName) ~= "string" then
            return nil
        end
        local key = string.lower(toolName)
        if BOMB_ID_ALIASES[key] then
            return BOMB_ID_ALIASES[key]
        end
        key = string.gsub(key, "%s+", "")
        if BOMB_ID_ALIASES[key] then
            return BOMB_ID_ALIASES[key]
        end
        for id, _ in pairs(BOMB_ID_TIER) do
            if string.lower(id) == key then
                return id
            end
        end
        return nil
    end

    local function listOwnedBombs()
        local owned = {}
        local function scan(container)
            if not container then
                return
            end
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Tool") then
                    local id = resolveBombId(child.Name)
                    if id and BOMB_ID_TIER[id] then
                        owned[#owned + 1] = {
                            tool = child,
                            bombId = id,
                            tier = BOMB_ID_TIER[id],
                            name = child.Name,
                        }
                    end
                end
            end
        end
        scan(LocalPlayer:FindFirstChild("Backpack"))
        local char = LocalPlayer.Character
        if char then
            scan(char)
        end
        table.sort(owned, function(a, b)
            return a.tier < b.tier
        end)
        return owned
    end

    local function pickBombForVein(matName)
        local info = BOMB_VEIN_INFO[matName]
        if not info then
            return nil
        end
        local need = info.tier or 1
        local owned = listOwnedBombs()
        local best = nil
        for _, b in ipairs(owned) do
            if b.tier >= need then
                if b.bombId == info.bombId then
                    return b
                end
                if not best or b.tier < best.tier then
                    best = b
                end
            end
        end
        return best
    end

    function FM.throwBombAtVein(matName)
        matName = tostring(matName or "")
        local smart = matName == "" or matName == "Smart"
        local info = smart and nil or BOMB_VEIN_INFO[matName]
        if not smart and not info then
            return false, "Unknown vein " .. matName
        end
        local root = FM.getRoot and FM.getRoot() or nil
        if not root then
            return false, "No character"
        end
        local origin = root.Position
        local candidates = {}
        local function collect(list)
            if type(list) ~= "table" then
                return
            end
            for _, d in ipairs(list) do
                local label = tostring(d and d.label or "")
                if d and typeof(d.pos) == "Vector3" and ((smart and BOMB_VEIN_INFO[label]) or (not smart and label == matName)) then
                    candidates[#candidates + 1] = d
                end
            end
        end
        if smart then
            if type(S._veinDeposits) == "table" then
                for _, d in ipairs(S._veinDeposits) do
                    if d and typeof(d.pos) == "Vector3" and BOMB_VEIN_INFO[tostring(d.label or "")] then
                        candidates[#candidates + 1] = d
                    end
                end
            end
        else
            collect(S._veinDeposits)
        end
        local presetAll = getPreset("Bomb Vein (All)")
        if presetAll then
            local ok, list = pcall(function()
                return findDeposits(origin, presetAll)
            end)
            if ok then collect(list) end
        end
        if #candidates == 0 then
            local presetOne = getPreset(matName)
            if presetOne then
                local ok, list = pcall(function()
                    return findDeposits(origin, presetOne)
                end)
                if ok then collect(list) end
            end
        end
        if #candidates == 0 then
            return false, smart and "No bomb vein nearby" or ("No " .. matName .. " nearby (stand closer / enable ESP Bomb)")
        end
        table.sort(candidates, function(a, b)
            return (a.pos - origin).Magnitude < (b.pos - origin).Magnitude
        end)
        local deposit = candidates[1]
        local actualName = tostring(deposit.label or matName)
        info = BOMB_VEIN_INFO[actualName]
        if not info then return false, "No compatible bomb vein" end
        local pos = deposit.pos
        local bomb = pickBombForVein(actualName)
        local bombId = (bomb and bomb.bombId) or info.bombId
        if type(bombId) ~= "string" or bombId == "" then
            return false, "No bomb id"
        end
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum and bomb and bomb.tool and bomb.tool.Parent then
                hum:EquipTool(bomb.tool)
            end
        end)
        local remote = nil
        pcall(function()
            local folder = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 3)
            remote = folder and (folder:FindFirstChild("BombActivate") or folder:WaitForChild("BombActivate", 2))
        end)
        if not remote and FM.findRemote then
            remote = FM.findRemote("BombActivate")
        end
        if not remote then
            return false, "BombActivate missing"
        end
        local ok = pcall(function()
            remote:FireServer(bombId, pos)
        end)
        if ok then
            return true, bombId .. " -> " .. matName .. " @ " .. math.floor((pos - origin).Magnitude) .. "m"
        end
        return false, "FireServer failed"
    end

