                        end
                    end
                    consider(backpack)
                    consider(character)
                    task.spawn(function()
                        for _, tool in ipairs(tools) do
                            if humanoid and tool.Parent ~= character then
                                pcall(function() humanoid:EquipTool(tool) end)
                                task.wait(0.05)
                            end
                            pcall(function() remote:FireServer(tool.Name) end)
                            task.wait(0.08)
                        end
                    end)
                end
            end,
        })

        PickupBox:Button({
            Title = "Pickup All Dropped Crystals",
            Desc = "Pick up crystals that were dropped.",
            Callback = function()
                if FM.pickupAllDroppedCrystals then
                    FM.pickupAllDroppedCrystals()
                else
                    local Hold = FM.findRemote and FM.findRemote("CrystalHoldComplete")
                    if not Hold then return end
                    local root = FM.getRoot and FM.getRoot()
                    if not root then return end
                    local origin = root.Position
                    local targets, seen = {}, {}
                    local function add(part)
                        if not part or seen[part] or not part:IsA("BasePart") then return end
                        if FM.getAttr and FM.getAttr(part, "Collected") == true then return end
                        local okCrystal = (FM.isCrystal and FM.isCrystal(part))
                            or part:GetAttribute("Value") ~= nil
                            or part:GetAttribute("Tier") ~= nil
                        if not okCrystal then return end
                        if (part.Position - origin).Magnitude > 150 then return end
                        seen[part] = true
                        targets[#targets + 1] = part
                    end
                    local function scan(folder)
                        if not folder then return end
                        for _, d in ipairs(folder:GetDescendants()) do
                            if d:IsA("BasePart") then add(d) end
                        end
                    end
                    scan(Workspace:FindFirstChild("DroppedCrystals"))
                    local things = Workspace:FindFirstChild("Things")
                    if things then scan(things:FindFirstChild("DroppedCrystals")) end
                    task.spawn(function()
                        for _, crystal in ipairs(targets) do
                            if crystal.Parent then
                                pcall(function() FM.queueHoldComplete(crystal) end)
                                task.wait(0.08)
                            end
                        end
                    end)
                end
            end,
        })


        local function _parseNum(text)
            if type(text) == "table" then text = text.Text or text.Value or text[1] or "0" end
            text = tostring(text or "")
            local cleaned = text:gsub(",", ""):gsub("%%", ""):gsub("%s+", "")
            if FM.parseValue and text:match("[%a]") and not text:match("%%") then
                local p = FM.parseValue(text)
                if p then return p end
            end
            return tonumber((cleaned:match("[%d%.]+"))) or 0
        end

        local VALUE_PRESETS = { None=0, ["100k"]=1e5, ["500k"]=5e5, ["1m"]=1e6, ["5m"]=5e6,
            ["10m"]=1e7, ["50m"]=5e7, ["100m"]=1e8, ["1b"]=1e9 }
        local LUCK_PRESETS  = { None=0, ["1%"]=1, ["5%"]=5, ["10%"]=10, ["25%"]=25,
            ["50%"]=50, ["100%"]=100, ["500%"]=500, ["1000%"]=1000,
            ["2500%"]=2500, ["5000%"]=5000, ["10000%"]=10000 }

        local function _applyPresetValue(cfg, opt)
            if type(opt) == "table" then opt = opt[1] or opt.Value or opt.Name or "None" end
            opt = tostring(opt or "None"):gsub("%s+","")
            local n = VALUE_PRESETS[opt]
            if n == nil then n = _parseNum(opt) end
            cfg.MinValue = n or 0
        end

        local function _applyPresetLuck(cfg, opt)
            if type(opt) == "table" then opt = opt[1] or opt.Value or opt.Name or "None" end
            opt = tostring(opt or "None"):gsub("%s+","")
            local n = LUCK_PRESETS[opt]
            if n == nil then n = _parseNum(opt) end
            cfg.MinLuck = n or 0
        end

        local function _applyTier(cfg, map)
            local normalized = {}
            if type(map) == "table" then
                for k, v in pairs(map) do
                    if type(k) == "string" and (v == true or v == "true") then normalized[k] = true
                    elseif type(v) == "string" and v ~= "" then normalized[v] = true end
                end
            elseif type(map) == "string" and map ~= "" then normalized[map] = true end
            if normalized["All"] or not next(normalized) then normalized = { All = true } end
            cfg.Tier = normalized
        end

        local TIER_OPTS = Sys and Sys.TIER_OPTIONS or { "Common","Uncommon","Rare","Epic","Legendary","Mythic","Empyrean","Pulsar","Quasar" }

        local farmPickupCfg = {
            Enabled  = false,
            MinValue = 0,
            MinLuck  = 0,
            Tier     = { All = true },
            Mutation = { All = true },
        }
        FM.farmPickupCfg = farmPickupCfg

        local autoCrystalConn = nil
        local autoCrystalOn = false

        local function crystalFilterOk(inst, cfg)
            if not inst or not inst.Parent then return false end
            if not inst:IsA("BasePart") then return false end
            if FM.getAttr and FM.getAttr(inst, "Collected") == true then return false end
            local val = 0
            pcall(function()
                val = tonumber(FM.crystalValue and FM.crystalValue(inst)) or tonumber(inst:GetAttribute("Value")) or 0
            end)
            local minV = tonumber(cfg and cfg.MinValue) or 0
            local minL = tonumber(cfg and cfg.MinLuck) or 0
            if minV > 0 and val < minV then return false end
            if minL > 0 then
                local luck = nil
                pcall(function()
                    luck = FM.crystalLuckStrict and FM.crystalLuckStrict(inst)
                end)
                if type(luck) ~= "number" or luck < minL then return false end
            end
            local mutations = cfg and cfg.Mutation
            if type(mutations) == "table" and next(mutations) and not mutations.All then
                local raw = FM.getAttr and FM.getAttr(inst, "Mutation") or nil
                local name = tostring(raw or "")
                local okM = false
                for k, v in pairs(mutations) do
                    if (v == true or v == "true") and string.lower(tostring(k)) == string.lower(name) then
                        okM = true
                        break
                    end
                end
                if not okM then return false end
            end
            local tiers = cfg and cfg.Tier
            if type(tiers) == "table" and next(tiers) and not tiers.All then
                local tn = tostring((FM.getAttr and (FM.getAttr(inst, "TierName") or FM.getAttr(inst, "Tier"))) or "")
                local tierN = tonumber(FM.getAttr and FM.getAttr(inst, "Tier"))
                local okT = false
                for k, v in pairs(tiers) do
                    if v == true or v == "true" then
                        if tostring(k) == tn or (TIER_NAMES and tierN and TIER_NAMES[tierN] == k) then
                            okT = true
                            break
                        end
                        if type(k) == "string" and tn ~= "" and string.lower(tn):find(string.lower(k), 1, true) then
                            okT = true
                            break
                        end
                    end
                end
                if not okT then return false end
            end
            return true
        end

        local function stopAutoCrystal()
            autoCrystalOn = false
            farmPickupCfg.Enabled = false
            if autoCrystalConn then
                pcall(function() autoCrystalConn:Disconnect() end)
                autoCrystalConn = nil
            end
            S.autoPickupActive = false
            S.pickupValueActive = false
            S.pickupLuckActive = false
            S.pickupRarityActive = false
            S.pickupMutationActive = false
            S._filterCandCache = nil
        end

        local function startAutoCrystal()
            stopAutoCrystal()
            autoCrystalOn = true
            farmPickupCfg.Enabled = true
            S.autoPickupActive = true
            local minV = tonumber(farmPickupCfg.MinValue) or 0
            local minL = tonumber(farmPickupCfg.MinLuck) or 0
            S.pickupMinValue = minV
            S.pickupMinLuck = minL
            S.pickupValueActive = minV > 0
            S.pickupLuckActive = minL > 0
            if type(farmPickupCfg.Tier) == "table" and not farmPickupCfg.Tier.All and next(farmPickupCfg.Tier) then
                S.rarityFilter = farmPickupCfg.Tier
                S.pickupRarityActive = true
            end
            S.pickupMutationActive = type(farmPickupCfg.Mutation) == "table" and not farmPickupCfg.Mutation.All and next(farmPickupCfg.Mutation) ~= nil
            local lastAt = 0
            autoCrystalConn = RunService.Heartbeat:Connect(function()
                if not autoCrystalOn then return end
                local now = os.clock()
                if now - lastAt < 0.22 then return end
                lastAt = now
                local root = FM.getRoot and FM.getRoot()
                if not root then return end
                local free = FM.backpackFree and FM.backpackFree() or 0
                if free <= 0 then return end
                local cfg = FM.farmPickupCfg or farmPickupCfg
                local origin = root.Position
                local best, bestD = nil, 1e12
                local function consider(part)
                    if not part or not part:IsA("BasePart") then return end
                    -- Skip crystals/runes placed on any player's plot (PlacedCrystals / PlacedRunes)
                    if S.pickupSkipPlaced ~= false then
                        if FM.isPlotPlaced and FM.isPlotPlaced(part) then return end
                        -- Extra explicit check for the known plot path
                        local cur = part.Parent
                        local depth = 0
                        local inPlot = false
                        while cur and depth < 10 do
                            local n = cur.Name
                            if n == "PlacedCrystals" or n == "PlacedRunes" then
                                inPlot = true
                                break
                            end
                            cur = cur.Parent
                            depth = depth + 1
                        end
                        if inPlot then return end
                    end
                    if not crystalFilterOk(part, cfg) then return end
                    local w = tonumber(part:GetAttribute("WeightKg")) or 0
                    if w > free then return end
                    local d = (part.Position - origin).Magnitude
                    if d > 150 then return end
                    if d < bestD then bestD, best = d, part end
                end
                pcall(function()
                    local things = Workspace:FindFirstChild("Things")
                    local folders = {}
                    if things then
                        folders[#folders + 1] = things:FindFirstChild("Crystals")
                        folders[#folders + 1] = things:FindFirstChild("DroppedCrystals")
                    end
                    folders[#folders + 1] = Workspace:FindFirstChild("Crystals")
                    folders[#folders + 1] = Workspace:FindFirstChild("DroppedCrystals")
                    for _, folder in ipairs(folders) do
                        if folder then
                            for _, child in ipairs(folder:GetChildren()) do
                                if child:IsA("BasePart") then
                                    consider(child)
                                elseif child:IsA("Model") then
                                    consider(child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart"))
                                end
                            end
                        end
                    end
                end)
                if best and FM.grabCrystal then
                    pcall(FM.grabCrystal, best, FM.crystalPrompt and FM.crystalPrompt(best))
                end
            end)
        end

        pcall(function()
            PickupBox:Section({ Title = "Crystal Pickup", TextSize = 17 })
        end)

        PickupBox:Toggle({
            Title = "Auto Pickup Crystal",
            Flag = "cfg_AutoPickupCrystal",
            Desc = "Pick up nearby crystals using the filters below.",
            Value = false,
            Callback = function(v)
                if v == true then
                    startAutoCrystal()
                else
                    stopAutoCrystal()
                end
            end,
        })

        PickupBox:Dropdown({
            Title = "Preset Value",
            Flag  = "cfg_FarmPickupPresetValue",
            Desc = "Optional minimum crystal value.",
            Values = { "None", "100k", "500k", "1m", "5m", "10m", "50m", "100m", "1b" },
            Value  = "None",
            Callback = function(opt)
                _applyPresetValue(farmPickupCfg, opt)
                S.pickupMinValue = tonumber(farmPickupCfg.MinValue) or 0
                S.pickupValueActive = autoCrystalOn and (S.pickupMinValue or 0) > 0
                S._filterCandCache = nil
            end,
        })

        PickupBox:Dropdown({
            Title = "Preset Luck",
            Flag  = "cfg_FarmPickupPresetLuck",
            Desc = "Optional minimum crystal luck.",
            Values = { "None", "1%", "5%", "10%", "25%", "50%", "100%", "500%", "1000%", "2500%", "5000%", "10000%" },
            Value  = "None",
            Callback = function(opt)
                _applyPresetLuck(farmPickupCfg, opt)
                S.pickupMinLuck = tonumber(farmPickupCfg.MinLuck) or 0
                S.pickupLuckActive = autoCrystalOn and (S.pickupMinLuck or 0) > 0
                S._filterCandCache = nil
            end,
        })

        PickupBox:Dropdown({
            Title = "Tier Filter",
            Flag  = "cfg_FarmPickupTier",
            Desc = "Optional rarity filter.",
            Values = TIER_OPTS,
            Multi  = true,
            Value  = {},
            AllowNone = true,
            Callback = function(map)
                _applyTier(farmPickupCfg, map)
                if autoCrystalOn and type(farmPickupCfg.Tier) == "table" and not farmPickupCfg.Tier.All and next(farmPickupCfg.Tier) then
                    S.rarityFilter = farmPickupCfg.Tier
                    S.pickupRarityActive = true
                else
                    S.pickupRarityActive = false
                end
                S._filterCandCache = nil
            end,
        })

        PickupBox:Dropdown({
            Title = "Mutation Filter",
            Flag  = "cfg_FarmPickupMutation",
            Desc = "Optional mutation filter.",
            Values = { "Verdant", "Voltaic", "Gilded", "Onyx", "Terminus", "Frost", "Dustworn", "Molten", "Bloodmoon", "Lucky", "Fire", "Thunder", "Starfall", "Aurora", "Radioactive", "Poison", "Wet" },
            Multi = true,
            Value = {},
            AllowNone = true,
            Callback = function(map)
                local normalized = {}
                if type(map) == "table" then
                    for k, v in pairs(map) do
                        if type(k) == "string" and (v == true or v == "true") then
                            normalized[k] = true
                        elseif type(v) == "string" and v ~= "" then
                            normalized[v] = true
                        end
                    end
                elseif type(map) == "string" and map ~= "" then
                    normalized[map] = true
                end
                if not next(normalized) then normalized = { All = true } end
                farmPickupCfg.Mutation = normalized
                S.pickupMutationActive = autoCrystalOn and not normalized.All
                S._filterCandCache = nil
            end,
        })

        PickupBox:Input({
            Title = "Minimum Value",
            Flag  = "cfg_FarmPickupMinValue",
            Desc = "Minimum value filter. 0 = any.",
            Value = "0",
            Placeholder = "0 / 1m / 500k",
            Callback = function(t)
                local n = _parseNum(t)
                farmPickupCfg.MinValue = n
                S.pickupMinValue = n
                S.pickupValueActive = autoCrystalOn and n > 0
                S._filterCandCache = nil
            end,
        })

        PickupBox:Input({
            Title = "Minimum Luck (%)",
            Flag  = "cfg_FarmPickupMinLuck",
            Desc = "Minimum luck filter. 0 = any.",
            Value = "0",
            Placeholder = "0 / 50 / 1000",
            Callback = function(t)
                local n = _parseNum(t)
                farmPickupCfg.MinLuck = n
                S.pickupMinLuck = n
                S.pickupLuckActive = autoCrystalOn and n > 0
                S._filterCandCache = nil
            end,
        })

        -- ── PICKUP BY MUTATIONS ─────────────────────────────────────────────
        pcall(function()
            PickupBox:Section({ Title = "Pickup By Mutations", TextSize = 17 })
        end)

        local MUT_OPTS = { "Verdant", "Voltaic", "Gilded", "Onyx", "Terminus", "Frost", "Dustworn", "Molten", "Bloodmoon", "Lucky", "Fire", "Thunder", "Starfall", "Aurora", "Radioactive", "Poison", "Wet" }

        PickupBox:Dropdown({
            Title = "Pickup By Mutations",
            Flag  = "cfg_FarmPickupByMutation",
            Desc  = "Only pick up crystals that have one of the selected mutations. Leave empty to pick up all mutations.",
            Values = MUT_OPTS,
            Multi  = true,
            AllowNone = true,
            Value  = {},
            Callback = function(map)
                local normalized = {}
                if type(map) == "table" then
                    for k, v in pairs(map) do
                        if type(k) == "string" and (v == true or v == "true") then
                            normalized[k] = true
                        elseif type(v) == "string" and v ~= "" then
                            normalized[v] = true
                        end
                    end
                elseif type(map) == "string" and map ~= "" then
                    normalized[map] = true
                end
                if not next(normalized) then normalized = { All = true } end
                farmPickupCfg.Mutation = normalized
                S.pickupMutationActive = autoCrystalOn and not normalized.All
                S._filterCandCache = nil
            end,
        })

        -- ── PICKUP RUNE / CRYSTAL (skip PlacedCrystals + PlacedRunes) ───────
        pcall(function()
            PickupBox:Section({ Title = "Pickup Rune & Crystal Settings", TextSize = 17 })
        end)

        PickupBox:Toggle({
            Title = "Skip Placed Crystals & Runes",
            Flag  = "cfg_PickupSkipPlaced",
            Desc  = "When enabled, Auto Pickup will NEVER collect crystals or runes that are placed on any player's plot (PlacedCrystals / PlacedRunes folders).",
            Value = true,
            Callback = function(v)
                S.pickupSkipPlaced = v == true
                S._filterCandCache = nil
            end,
        })

    end
    install()
end

do
    local godStateConn = nil
    local godEnabled = false
    local godHealthConn = nil
    local godCharConn = nil

    local function clearGodConnections()
        if godHealthConn then
            pcall(function() godHealthConn:Disconnect() end)
            godHealthConn = nil
        end
        if godStateConn then
            pcall(function() godStateConn:Disconnect() end)
            godStateConn = nil
        end
    end

    local function applyGodToCharacter(char)
        if not char or not godEnabled then
            return
        end
        if not char.Parent then
            return
        end

        clearGodConnections()

        local human = char:FindFirstChildWhichIsA("Humanoid")
        if not human then
            return
        end

        local softOk = pcall(function()
            human.MaxHealth = math.huge
            human.Health = math.huge
            human.BreakJointsOnDeath = false
            human:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            human:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            human:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end)

        if not softOk or human.MaxHealth < 1e9 then
            pcall(function()
                local Cam = Workspace.CurrentCamera
                local Pos = Cam and Cam.CFrame
                local old = human
                local nHuman = old:Clone()
                nHuman.BreakJointsOnDeath = false
                nHuman:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                nHuman:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                nHuman:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                nHuman:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
                nHuman.MaxHealth = math.huge
                nHuman.Health = math.huge
                nHuman.Parent = char
                old:Destroy()
                human = nHuman
                if Cam then
                    Cam.CameraSubject = nHuman
                    if Pos then Cam.CFrame = Pos end
                end
                local anim = char:FindFirstChild("Animate")
                if anim then
                    anim.Disabled = true
                    task.defer(function()
                        if anim and anim.Parent then
                            anim.Disabled = false
                        end
                    end)
                end
            end)
            human = char:FindFirstChildWhichIsA("Humanoid")
        end

        if human then
            pcall(function()
                human.MaxHealth = math.huge
                human.Health = math.huge
                human.BreakJointsOnDeath = false
                human:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            end)
            godHealthConn = human.HealthChanged:Connect(function()
                if not godEnabled then return end
                if human and human.Parent and human.Health < human.MaxHealth then
                    human.Health = human.MaxHealth
                end
            end)
            pcall(function()
                godStateConn = human.StateChanged:Connect(function(_, new)
                    if not godEnabled or not human or not human.Parent then return end
                    if new == Enum.HumanoidStateType.Dead
                        or new == Enum.HumanoidStateType.FallingDown
                        or new == Enum.HumanoidStateType.Ragdoll then
                        pcall(function()
                            human:ChangeState(Enum.HumanoidStateType.Running)
                            human.Health = human.MaxHealth
                        end)
                    end
                end)
            end)
        end

        pcall(function()
            if FM.CharacterManager and FM.CharacterManager.Refresh then
                FM.CharacterManager:Refresh(char)
            else
                FM.bindCharacter(char)
            end
        end)
    end

    local function setGodMode(value)
        godEnabled = value == true
        S.godMode = godEnabled

        if godEnabled then
            local char = LocalPlayer.Character
            if char then
                applyGodToCharacter(char)
            end

            if not godCharConn then
                godCharConn = LocalPlayer.CharacterAdded:Connect(function(char)
                    task.delay(0.4, function()
                        if godEnabled and char and char.Parent then
                            applyGodToCharacter(char)
                        end
                    end)
                end)
            end
            pcall(function()
                WindUI:Notify({
                    Title = "God Mode",
                    Content = "God Mode enabled",
                    Duration = 2,
                    Icon = "check",
                })
            end)
        else
            clearGodConnections()
            local human = FM.getHumanoid and FM.getHumanoid() or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid"))
            if human then
                pcall(function()
                    human.MaxHealth = 100
                    human.Health = math.min(human.Health, 100)
                    human.BreakJointsOnDeath = true
                    human:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                    human:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                    human:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                end)
            end
            pcall(function()
                WindUI:Notify({
                    Title = "God Mode",
                    Content = "God Mode disabled",
                    Duration = 2,
                    Icon = "x",
                })
            end)
        end
    end

    FM.setGodMode = setGodMode
    FM._godReapply = applyGodToCharacter

    local function install()
        local MoveBox = Tabs.movement

        MoveBox:Section({ Title = "Movement", TextSize = 17 })

        MoveBox:Toggle({
            Title = "Speed Boost",
            Desc = "Increase your walk speed.",
            Value = true,
            Callback = FM.setSpeedBoost
        })

        task.defer(function()
            if S._speedWanted ~= false then
                FM.setSpeedBoost(true)
            end
        end)

        MoveBox:Toggle({
            Title = "Noclip",
            Desc = "Walk through walls and terrain.",
            Value = false,
            Callback = Move.setNoclip
        })

        MoveBox:Toggle({
            Title = "Inf Jump",
            Desc = "Jump continuously while holding jump.",
            Value = false,
            Callback = Move.setInfJump
        })

        MoveBox:Toggle({
            Title = "Fly",
            Desc = "Enable flight movement.",
            Value = false,
            Callback = Move.setFly
        })

        MoveBox:Slider({
            Title = "Fly Speed",
            Desc = "Flight speed while Fly is enabled.",
            Step = 1,
            Value = {
                Min = 20,
                Max = 300,
                Default = 100,
            },
            Callback = Move.setFlySpeed
        })

        MoveBox:Toggle({
            Title = "God Mode",
            Desc = "Reduce or avoid damage.",
            Value = false,
            Callback = setGodMode,
        })

    end

    install()
end

do
    local MiscState = {
        antiFling = false,
        clickTp = false,
        autoRejoin = false,
        fpsBoost = false,
        clickTpConn = nil,
        antiFlingConn = nil,
        rejoinConn = nil,
        originalLighting = nil,
    }

    local function setAntiFling(value)
        MiscState.antiFling = value == true
        if MiscState.antiFlingConn then
            pcall(function() MiscState.antiFlingConn:Disconnect() end)
            MiscState.antiFlingConn = nil
        end
        if not MiscState.antiFling then
            return
        end
        MiscState.antiFlingConn = RunService.Heartbeat:Connect(function()
            if not MiscState.antiFling then
                return
            end
            local char = LocalPlayer.Character
            if not char then
                return
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then
                return
            end
            local vel = root.AssemblyLinearVelocity
            local maxH = 90
            local maxV = 120
            local hx, hz = vel.X, vel.Z
            local hy = vel.Y
            local hMag = math.sqrt(hx * hx + hz * hz)
            if hMag > maxH then
                local scale = maxH / hMag
                hx, hz = hx * scale, hz * scale
            end
            if hy > maxV then
                hy = maxV
            elseif hy < -maxV then
                hy = -maxV
            end
            if hx ~= vel.X or hy ~= vel.Y or hz ~= vel.Z then
                root.AssemblyLinearVelocity = Vector3.new(hx, hy, hz)
            end
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("BodyForce") or child:IsA("BodyAngularVelocity") then
                    if not child:GetAttribute("FM_Keep") then
                        pcall(function() child:Destroy() end)
                    end
                end
            end
        end)
    end

    local function setClickTp(value)
        MiscState.clickTp = value == true
        if MiscState.clickTpConn then
            pcall(function() MiscState.clickTpConn:Disconnect() end)
            MiscState.clickTpConn = nil
        end
        if not MiscState.clickTp then
            return
        end
        MiscState.clickTpConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed or not MiscState.clickTp then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                return
            end
            local cam = Workspace.CurrentCamera
            local root = FM.getRoot and FM.getRoot() or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            if not cam or not root then
                return
            end
            local mouse = LocalPlayer:GetMouse()
            local unitRay = cam:ScreenPointToRay(mouse.X, mouse.Y)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { LocalPlayer.Character }
            local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, params)
            if result and result.Position then
                local dest = result.Position + Vector3.new(0, 3, 0)
                if FM.teleportTo then
                    FM.teleportTo(dest)
                else
                    root.CFrame = CFrame.new(dest)
                end
            end
        end)
    end

    local function setAutoRejoin(value)
        MiscState.autoRejoin = value == true
        if MiscState.rejoinConn then
            pcall(function() MiscState.rejoinConn:Disconnect() end)
            MiscState.rejoinConn = nil
        end
        if not MiscState.autoRejoin then
            return
        end
        local GuiService = game:GetService("GuiService")
        local TeleportService = game:GetService("TeleportService")
        MiscState.rejoinConn = GuiService.ErrorMessageChanged:Connect(function()
            if not MiscState.autoRejoin then
                return
            end
            task.delay(1.5, function()
                if not MiscState.autoRejoin then
                    return
                end
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)
            end)
        end)
        pcall(function()
            LocalPlayer.OnTeleport:Connect(function(state)
                if state == Enum.TeleportState.Failed and MiscState.autoRejoin then
                    task.delay(2, function()
                        pcall(function()
                            TeleportService:Teleport(game.PlaceId, LocalPlayer)
                        end)
                    end)
                end
            end)
        end)
    end

    local function setFpsBoost(value)
        MiscState.fpsBoost = value == true
        local Lighting = game:GetService("Lighting")
        local Terrain = Workspace:FindFirstChildOfClass("Terrain")

        if MiscState.fpsBoost then
            if not MiscState.originalLighting then
                MiscState.originalLighting = {
                    GlobalShadows = Lighting.GlobalShadows,
                    FogEnd = Lighting.FogEnd,
                    Brightness = Lighting.Brightness,
                    QualityLevel = settings().Rendering.QualityLevel,
                }
            end
            pcall(function()
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 9e9
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            end)
            pcall(function()
                if Terrain then
                    Terrain.Decoration = false
                end
            end)
            pcall(function()
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect")
                        or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") then
