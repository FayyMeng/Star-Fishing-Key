function FM.valueLuckFilter(inst)
    if not inst or not S then
        return false
    end
    
    local cfg = FM.farmPickupCfg
    if cfg and cfg.Enabled then
        local value = 0
        pcall(function() value = tonumber(FM.crystalValue(inst)) or 0 end)
        local minV = tonumber(cfg.MinValue) or 0
        local minL = tonumber(cfg.MinLuck) or 0
        if minV > 0 and value < minV then return false end
        if minL > 0 then
            local luck = nil
            pcall(function() luck = FM.crystalLuckStrict and FM.crystalLuckStrict(inst) end)
            if type(luck) ~= "number" or luck < minL then return false end
        end
        local tiers = cfg.Tier
        if type(tiers) == "table" and next(tiers) and not tiers.All then
            local tn = tostring(FM.getAttr and (FM.getAttr(inst, "TierName") or "") or "")
            local tierN = tonumber(FM.getAttr and FM.getAttr(inst, "Tier"))
            local okT = false
            for k, v in pairs(tiers) do
                if v == true or v == "true" then
                    if k == tn or (TIER_NAMES and tierN and TIER_NAMES[tierN] == k) then
                        okT = true
                        break
                    end
                end
            end
            if not okT then return false end
        end
        return true
    end
    if S.pickupRarityActive then
        if FM.rarityAllowed and not FM.rarityAllowed(inst) then
            return false
        end
    end
    if S.pickupValueActive then
        local value = FM.crystalValue(inst)
        local minV = tonumber(S.pickupMinValue) or tonumber(S.minValue) or 0
        if value < minV then
            return false
        end
    end
    if S.pickupLuckActive then
        local minL = tonumber(S.pickupMinLuck) or tonumber(S.minLuck) or 0
        if minL > 0 then
            local luck = nil
            pcall(function()
                luck = FM.crystalLuckStrict and FM.crystalLuckStrict(inst)
            end)
            if type(luck) ~= "number" or luck < minL then
                return false
            end
        end
    end
    return true
end

function FM.crystalFingerprint(inst)
    if not inst then
        return nil
    end
    local value = FM.crystalValue(inst)
    local weight = FM.crystalWeight(inst)
    local tier = FM.crystalTier(inst)
    local name = tostring(FM.crystalName(inst) or inst.Name or "")
    local mut = tostring(FM.getAttr(inst, "Mutation") or "")
    return string.format("%s|%.4f|%.4f|%d|%s", name, value, weight, tier, mut)
end

function FM.rememberDroppedCrystal(toolOrInst)
    if not S.recentDrops then
        S.recentDrops = {}
    end
    local fp = FM.crystalFingerprint(toolOrInst)
    if not fp then
        return
    end
    S.recentDrops[#S.recentDrops + 1] = {
        fp = fp,
        at = os.clock(),
        value = FM.crystalValue(toolOrInst),
        weight = FM.crystalWeight(toolOrInst),
        name = tostring(FM.crystalName(toolOrInst) or ""),
    }
    while #S.recentDrops > 80 do
        table.remove(S.recentDrops, 1)
    end
end

function FM.isOurRecentDrop(inst, maxAge)
    maxAge = maxAge or 120
    if not inst or not S.recentDrops or #S.recentDrops == 0 then
        return false
    end
    local now = os.clock()
    local fp = FM.crystalFingerprint(inst)
    if not fp then
        return false
    end
    for i = #S.recentDrops, 1, -1 do
        local entry = S.recentDrops[i]
        if now - entry.at > maxAge then
            table.remove(S.recentDrops, i)
        elseif entry.fp == fp then
            return true
        end
    end
    return false
end

function FM.isInDroppedFolder(inst)
    local p = inst
    while p do
        local n = p.Name
        if n == "DroppedCrystals"
            or n == "DroppedRunes"
            or n == "DroppedCrystal"
            or n == "DropCrystals"
            or n == "WorldCrystals"
        then
            return true
        end
        p = p.Parent
    end
    return false
end

