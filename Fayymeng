function FM.backpackCapacity()
    if LocalPlayer:GetAttribute("InfBackpack") == true then
        return math.huge
    end

    local base = FM.realStat("CarryWeight") or 10
    if FM.ownsGamepass("CarryKgPlus4") then
        base = base * 4
    end

    local total = base + (FM.realStat("CarryWeightBonus") or 0)

    if FM.hasActiveRune("Weight") then
        return total * 2
    end

    return total
end

function FM.backpackWeight()
    local total = 0

    local function scan(container)
        if not container then
            return
        end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and FM.getAttr(child, "Tier") ~= nil then
                local kg = tonumber(FM.getAttr(child, "WeightKg"))
                if kg then
                    total = total + kg
                end
            end
        end
    end

    scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
    scan(LocalPlayer.Character)

    return total
end

function FM.backpackFree()
    local capacity = FM.backpackCapacity()
    if capacity == math.huge then
        return math.huge
    end
    return capacity - FM.backpackWeight()
end

function FM.looksLikeCrystal(inst)
    if not inst:IsA("BasePart") then
        return false
    end
    if inst.Name:find("Crystal", 1, true) ~= nil then
        return true
    end

    local parent = inst.Parent
    if parent then
        local pname = parent.Name
        if pname == "Crystals" or pname == "DroppedCrystals" or pname == "DroppedRunes" or pname == "DroppedCrystal"
            or pname == "WorldCrystals" or pname == "DroppedCrystal" then
            return true
        end
    end
    return false
end

local crystalFlags = setmetatable({}, { __mode = "k" })

function FM.isPlotPlaced(inst)
    if not inst then
        return false
    end
    local cur = inst
    local depth = 0
    while cur and depth < 16 do
        local n = cur.Name
        if type(n) == "string" then
            if n == "PlacedCrystals" or n == "PlacedRunes" then
                return true
            end
        end
        local p = cur.Parent
        if not p then
            break
        end
        cur = p
        depth = depth + 1
    end
    return false
end

function FM.isCrystal(inst)
    local cached = crystalFlags[inst]
    if cached == true then
        return true
    end
    if type(cached) == "table" and cached.v == false then
        if (os.clock() - (cached.t or 0)) < 1.5 then
            return false
        end
        crystalFlags[inst] = nil
    elseif cached == false then
        crystalFlags[inst] = nil
    end

    local result = false
    if inst and inst:IsA("BasePart") then
        local parent = inst.Parent
        if parent then
            if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then
                crystalFlags[inst] = { v = false, t = os.clock() }
                return false
            end
            if parent:IsA("Tool") or parent:IsA("Accoutrement") then
                crystalFlags[inst] = { v = false, t = os.clock() }
                return false
            end
        end

        local value     = FM.getAttr(inst, "Value")
        local hasValue  = typeof(value) == "number"
        local tier      = FM.getAttr(inst, "Tier")
        local hasTier   = typeof(tier) == "number" and tier > 0
        local cname     = FM.getAttr(inst, "CrystalName")
        local hasName   = type(cname) == "string" and cname ~= ""
        local weight    = FM.getAttr(inst, "WeightKg")
        local hasWeight = typeof(weight) == "number"
        local nameHit   = type(inst.Name) == "string" and inst.Name:find("Crystal", 1, true) ~= nil
        local minedHp   = FM.getAttr(inst, "MinedHP")
        local hasMinedHp = typeof(minedHp) == "number"
        local tierName  = FM.getAttr(inst, "TierName")
        local hasTierName = type(tierName) == "string" and tierName ~= ""

        local inKnownContainer = false
        if parent then
            local pname = parent.Name
            if pname == "Crystals" or pname == "DroppedCrystals" or pname == "DroppedRunes" or pname == "DroppedCrystal"
                or pname == "WorldCrystals" or pname == "DroppedCrystal" then
                inKnownContainer = true
            end

            if not inKnownContainer then
                local gp = parent.Parent
                if gp then
                    local gpname = gp.Name
                    if gpname == "Crystals" or gpname == "DroppedCrystals" or gpname == "DroppedRunes" or gpname == "DroppedCrystal"
                        or gpname == "WorldCrystals" or gpname == "DroppedCrystal" then
                        inKnownContainer = true
                    end
                end
            end
        end

        local hasLuck = FM.getAttr(inst, "Luck") ~= nil
            or FM.getAttr(inst, "LuckBoost") ~= nil
            or FM.getAttr(inst, "LuckPercent") ~= nil

        if hasValue then
            result = true
        elseif hasName and (hasTier or hasWeight or nameHit or hasLuck) then
            result = true
        elseif hasTier and hasWeight then
            result = true
        elseif hasMinedHp and (hasTier or hasName or nameHit) then
            result = true
        elseif inKnownContainer and (hasTier or hasTierName or hasName or nameHit or hasValue or hasLuck or hasWeight) then
            result = true
        elseif inKnownContainer and inst:IsA("MeshPart") then
            
            result = true
        else
            result = false
        end
    end

    if not result then
        local parent = inst and inst.Parent
        local function isKnownContainerName(n)
            return n == "Crystals" or n == "DroppedCrystals" or n == "DroppedRunes" or n == "DroppedCrystal"
                or n == "WorldCrystals" or n == "DroppedCrystal"
        end
        local pname = parent and parent.Name or ""
        local gp = parent and parent.Parent
        local gpname = gp and gp.Name or ""
        if isKnownContainerName(pname) or isKnownContainerName(gpname) then
            return false
        end
    end

    if result then
        crystalFlags[inst] = true
    else
        crystalFlags[inst] = { v = false, t = os.clock() }
    end
    return result
end

local containerList = {}
local containerClock = 0

function FM.rebuildContainers()
    table.clear(containerList)

    local seen = {}

    local function push(container)
        if not container or seen[container] then
            return
        end
        if container == Workspace then
            return
        end
        seen[container] = true
        containerList[#containerList + 1] = container
    end

    push(Workspace:FindFirstChild("DroppedCrystals"))
    push(Workspace:FindFirstChild("DroppedRunes"))
    push(Workspace:FindFirstChild("DroppedCrystal"))
    push(Workspace:FindFirstChild("Runes"))

    for _, name in ipairs(CONTAINER_NAMES) do
        push(Workspace:FindFirstChild(name))
    end

    local things = Workspace:FindFirstChild("Things")
    if things then
        push(things:FindFirstChild("DroppedCrystals"))
        push(things:FindFirstChild("DroppedRunes"))
        push(things:FindFirstChild("DroppedCrystal"))
        for _, name in ipairs(CONTAINER_NAMES) do
            push(things:FindFirstChild(name))
        end
        push(things:FindFirstChild("WorldCrystals"))
        push(things:FindFirstChild("Runes"))
        push(things:FindFirstChild("Pickups"))
    end
end

function FM.eachContainer(fn)
    local now = os.clock()
    local interval = (S.moneyFarmActive or S.boulderFarmActive) and 0.35 or ((S.luckEspActive or S.espActive) and 1.2 or 1.5)
    local stale = #containerList == 0 or now - containerClock >= interval

    if not stale then
        for _, container in ipairs(containerList) do
            if not container.Parent and container ~= Workspace then
                stale = true
                break
            end
        end
    end

    if stale then
        containerClock = now
        FM.rebuildContainers()
    end

    for _, container in ipairs(containerList) do
        fn(container)
    end
end

