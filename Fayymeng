        return c
    end
    return COLORS.default
end

function FM.mutationRichText(inst)
    local list = FM.mutationList(inst)
    if #list == 0 then
        return ""
    end
    local parts = {}
    for i, name in ipairs(list) do
        local c = FM.mutationColor(name)
        local hex = string.format("%02X%02X%02X",
            math.floor(c.R * 255 + 0.5),
            math.floor(c.G * 255 + 0.5),
            math.floor(c.B * 255 + 0.5))
        parts[#parts + 1] = string.format('<font color="#%s">%s</font>', hex, name)
        if i == 1 and #list > 1 then
            parts[#parts + 1] = '<font color="#00FF00"><b>+</b></font>'
        elseif i > 1 and i < #list then
            parts[#parts + 1] = '<font color="#AAAAAA">, </font>'
        end
    end

    if #list == 1 then
        local c = FM.mutationColor(list[1])
        local hex = string.format("%02X%02X%02X",
            math.floor(c.R * 255 + 0.5),
            math.floor(c.G * 255 + 0.5),
            math.floor(c.B * 255 + 0.5))
        return string.format('<font color="#%s">(%s)</font>', hex, list[1])
    end
    local first = list[1]
    local c1 = FM.mutationColor(first)
    local hex1 = string.format("%02X%02X%02X",
        math.floor(c1.R * 255 + 0.5),
        math.floor(c1.G * 255 + 0.5),
        math.floor(c1.B * 255 + 0.5))
    local extras = {}
    for i = 2, #list do
        local c = FM.mutationColor(list[i])
        local hex = string.format("%02X%02X%02X",
            math.floor(c.R * 255 + 0.5),
            math.floor(c.G * 255 + 0.5),
            math.floor(c.B * 255 + 0.5))
        extras[#extras + 1] = string.format('<font color="#%s">%s</font>', hex, list[i])
    end
    return string.format('<font color="#%s">(%s)</font> <font color="#00FF00"><b>+</b></font> %s',
        hex1, first, table.concat(extras, ", "))
end

function FM.crystalLuck(inst)
    if not inst then return 0 end

    local function parsePercentText(text)
        if type(text) ~= "string" then return nil end
        local cleaned = text:gsub(",", ""):gsub("%s+", ""):gsub("^%+", "")
        local pct = tonumber(cleaned:match("([%d%.]+)%%"))
        if not pct then
            pct = tonumber(cleaned:match("([%d%.]+)"))
        end
        return pct
    end

    local labelText = FM.luckLabelText(inst)
    local fromLabel = parsePercentText(labelText)
    if fromLabel and fromLabel > 0 then
        return fromLabel
    end

    if FM.getAttr then
        for _, key in ipairs({ "LuckBoost", "Luck", "LuckPercent", "DisplayLuck" }) do
            local raw = FM.getAttr(inst, key)
            if raw ~= nil then
                local n = tonumber(raw)
                if not n and type(raw) == "string" then
                    n = parsePercentText(raw)
                end
                if n and n > 0 then
                    if n > 0 and n < 1.5 then
                        return n * 100
                    end
                    return n
                end
            end
        end
    end

    local ok, ratio = pcall(FM.computeLuck, inst)
    if ok and type(ratio) == "number" and ratio > 0 then
        return ratio * 100
    end
    return 0
end


function FM.crystalLuckStrict(inst)
    local n = FM.crystalLuck(inst)
    if type(n) == "number" and n > 0 then
        return n
    end
    return nil
end


