    local function ensureBeam(marker, color)
        local char = LocalPlayer.Character
        local hand = char and (char:FindFirstChild("RadarLeftHand") or char:FindFirstChild("HumanoidRootPart"))
        if not (hand and hand:IsA("BasePart")) then
            if marker.beam then
                pcall(function() marker.beam:Destroy() end)
                marker.beam = nil
            end
            return
        end
        color = color or Color3.fromRGB(255, 170, 70)
        if marker.beam and marker.beam.Parent then
            if marker.beamA and marker.beamA.Parent ~= hand then
                marker.beamA.Parent = hand
            end
            marker.beam.Parent = hand
            marker.beam.Color = ColorSequence.new(color, color)
            return
        end
        marker.beamA = Instance.new("Attachment")
        marker.beamA.Parent = hand
        marker.beamB = Instance.new("Attachment")
        marker.beamB.Parent = marker.part
        local beam = Instance.new("Beam")
        beam.Attachment0 = marker.beamA
        beam.Attachment1 = marker.beamB
        beam.Color = ColorSequence.new(color, color)
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.FaceCamera = true
        beam.Width0 = 0.4
        beam.Width1 = 0.18
        beam.CurveSize0 = 3
        beam.CurveSize1 = -3
        beam.Segments = 12
        beam.TextureSpeed = 2.2
        beam.TextureLength = 4
        beam.Parent = hand
        marker.beam = beam
    end

    local LOCAL_BOMB_MAT = {
        [Enum.Material.Pavement] = "Gunpowder Stone",
        [Enum.Material.Salt] = "Skyglass",
        [Enum.Material.Ice] = "Cryostone",
        [Enum.Material.LeafyGrass] = "Cinderforge Plate",
        [Enum.Material.Asphalt] = "Stormsteel",
        [Enum.Material.Concrete] = "Venomite",
        [Enum.Material.Cobblestone] = "Chronoshard",
        [Enum.Material.Brick] = "Dreadstone",
    }

    local function isBombMat(mat)
        if mat == nil then
            return false
        end
        if BombMats and type(BombMats.isBombMaterial) == "function" then
            local ok, res = pcall(BombMats.isBombMaterial, mat)
            if ok and res == true then
                return true
            end
        end
        return LOCAL_BOMB_MAT[mat] ~= nil
    end

    local function bombInfo(mat)
        if BombMats and type(BombMats.infoFor) == "function" then
            local ok, info = pcall(BombMats.infoFor, mat)
            if ok and info then
                return info
            end
        end
        local name = LOCAL_BOMB_MAT[mat]
        if name then
            return { matName = name, name = name }
        end
        return nil
    end

    local function clusterPositions(positions, gap)
        gap = gap or 16
        local clusters = {}
        for _, pos in ipairs(positions) do
            local best, bestD = nil, gap
            for _, c in ipairs(clusters) do
                local d = ((c.sum / c.count) - pos).Magnitude
                if d < bestD then
                    best, bestD = c, d
                end
            end
            if best then
                best.sum = best.sum + pos
                best.count = best.count + 1
            else
                clusters[#clusters + 1] = { sum = pos, count = 1 }
            end
        end
        local out = {}
        for _, c in ipairs(clusters) do
            if c.count >= minCluster then
                out[#out + 1] = { pos = c.sum / c.count, count = c.count }
            end
        end
        return out
    end

    local _voxelSnap = { key = nil, mats = nil, corner = nil, at = 0 }
    local function findDeposits(origin, preset)
        if typeof(origin) ~= "Vector3" or not preset then
            return {}
        end
        local half = 90
        local res = 4
        local key = string.format("%d:%d:%d", math.floor(origin.X / 24), math.floor(origin.Y / 24), math.floor(origin.Z / 24))
        local mats, corner
        local nowV = os.clock()
        if _voxelSnap.key == key and _voxelSnap.mats and (nowV - (_voxelSnap.at or 0)) < 1.25 then
            mats = _voxelSnap.mats
            corner = _voxelSnap.corner
        else
            local region = Region3.new(
                origin - Vector3.new(half, half, half),
                origin + Vector3.new(half, half, half)
            ):ExpandToGrid(res)
            local ok, m = pcall(function()
                local mm, _ = Terrain:ReadVoxels(region, res)
                return mm
            end)
            if not ok or not m then
                return {}
            end
            mats = m
            corner = region.CFrame.Position - region.Size * 0.5
            _voxelSnap.key = key
            _voxelSnap.mats = mats
            _voxelSnap.corner = corner
            _voxelSnap.at = nowV
        end
        if not mats or not corner then
            return {}
        end

        local function clusterHits(positions, gap, minCount)
            gap = gap or 16
            minCount = minCount or 3
            local clusters = {}
            if type(positions) ~= "table" then
                return {}
            end
            for _, pos in ipairs(positions) do
                if typeof(pos) == "Vector3" then
                    local best, bestD = nil, gap
                    for _, c in ipairs(clusters) do
                        if c and typeof(c.sum) == "Vector3" and type(c.count) == "number" and c.count > 0 then
                            local d = ((c.sum / c.count) - pos).Magnitude
                            if d < bestD then
                                best, bestD = c, d
                            end
                        end
                    end
                    if best and typeof(best.sum) == "Vector3" then
                        best.sum = best.sum + pos
                        best.count = (best.count or 0) + 1
                    else
                        clusters[#clusters + 1] = { sum = pos, count = 1 }
                    end
                end
            end
            local out = {}
            for _, c in ipairs(clusters) do
                if c and typeof(c.sum) == "Vector3" and type(c.count) == "number" and c.count >= minCount then
                    out[#out + 1] = {
                        pos = c.sum / c.count,
                        count = c.count,
                    }
                end
            end
            return out
        end

        if preset.kind == "bomb" or preset.kind == "bomb_all" then
            local byMat = {}
            local totalHits = 0
            local MAX_HITS = 120
            for x = 1, #mats do
                local yx = mats[x]
                for y = 1, #yx do
                    local zy = yx[y]
                    for z = 1, #zy do
                        local mat = zy[z]
                        local isBomb = false
                        if BombMats and type(BombMats.isBombMaterial) == "function" then
                            local okB, resB = pcall(BombMats.isBombMaterial, mat)
                            isBomb = okB and resB == true
                        end
                        if not isBomb then
                            isBomb = LOCAL_BOMB_MAT[mat] ~= nil
                        end
                        if isBomb then
                            local matName = nil
                            if BombMats and type(BombMats.infoFor) == "function" then
                                local okI, info = pcall(BombMats.infoFor, mat)
                                if okI and type(info) == "table" and type(info.matName) == "string" then
                                    matName = info.matName
                                end
                            end
                            if not matName then
                                matName = LOCAL_BOMB_MAT[mat]
                            end
                            if type(matName) ~= "string" or matName == "" then
                                matName = "Bomb Vein"
                            end
                            
                            if preset.kind == "bomb_all"
                                or matName == preset.bombName
                                or (preset.name and matName == preset.name and preset.kind == "bomb") then
                                local list = byMat[mat]
                                if not list then
                                    list = { _name = matName }
                                    byMat[mat] = list
                                end
                                if not list._name or list._name == "Bomb Vein (All)" then
                                    list._name = matName
                                end
                                list[#list + 1] = corner + Vector3.new(
                                    (x - 0.5) * res,
                                    (y - 0.5) * res,
                                    (z - 0.5) * res
                                )
                                totalHits = totalHits + 1
                                if totalHits >= MAX_HITS then
                                    break
                                end
                            end
                        end
                    end
                    if totalHits >= MAX_HITS then break end
                end
                if totalHits >= MAX_HITS then break end
            end
            local out = {}
            for mat, hits in pairs(byMat) do
                local name = hits._name
                if type(name) ~= "string" or name == "" or name == "Bomb Vein (All)" or name == "Bomb Vein" then
                    name = LOCAL_BOMB_MAT[mat]
                    if (not name) and BombMats and type(BombMats.infoFor) == "function" then
                        local okI, info = pcall(BombMats.infoFor, mat)
                        if okI and info and info.matName then
                            name = info.matName
                        end
                    end
                    name = name or "Bomb Vein"
                end
                hits._name = nil
                local clusters = clusterHits(hits, 16, 3)
                local col = (BOMB_COLORS and BOMB_COLORS[name]) or Color3.fromRGB(255, 170, 70)
                for _, c in ipairs(clusters) do
                    c.label = name
                    c.color = col
                    c.matName = name
                    out[#out + 1] = c
                end
            end
            return out
        end

        if preset.kind == "terrain" and preset.material then
            local hits = {}
            for x = 1, #mats do
                local yx = mats[x]
                for y = 1, #yx do
                    local zy = yx[y]
                    for z = 1, #zy do
                        if zy[z] == preset.material then
                            hits[#hits + 1] = corner + Vector3.new(
                                (x - 0.5) * res,
                                (y - 0.5) * res,
                                (z - 0.5) * res
                            )
                        end
                    end
                end
            end
            local clusters = clusterHits(hits, 14, 3)
            for _, c in ipairs(clusters) do
                c.label = preset.name
                c.color = preset.color
            end
            return clusters
        end

        if preset.kind == "prismarite" then
            local targets = {
                Enum.Material.WoodPlanks,
                Enum.Material.Glass,
                Enum.Material.Ice,
                Enum.Material.Salt,
                Enum.Material.Marble,
                Enum.Material.Limestone,
            }
            if type(S._prismariteMaterials) == "table" then
                targets = S._prismariteMaterials
            end
            local hits = {}
            local targetSet = {}
            for _, m in ipairs(targets) do
                targetSet[m] = true
            end
            for x = 1, #mats do
                local yx = mats[x]
                for y = 1, #yx do
                    local zy = yx[y]
                    for z = 1, #zy do
                        if targetSet[zy[z]] then
                            hits[#hits + 1] = corner + Vector3.new(
                                (x - 0.5) * res,
                                (y - 0.5) * res,
                                (z - 0.5) * res
                            )
                        end
                    end
                end
            end
            local clusters = clusterHits(hits, 14, 3)
            for _, c in ipairs(clusters) do
                c.label = preset.name
                c.color = preset.color
            end
            return clusters
        end

        return {}
    end

    
local function scanOnce()
        local root = FM.getRoot and FM.getRoot() or nil
        if not root then
            clearMarkers()
            S._veinDeposits = {}
            return
        end
        local origin = root.Position
        local deposits = {}
        local seen = {}
        local defaultPreset = getPreset(selectedName) or getPreset("Aetherstone Vein")

        local function pushFound(found, preset)
            if type(found) ~= "table" or not preset then
                return
            end
            for _, d in ipairs(found) do
                if d and typeof(d.pos) == "Vector3" then
                    local lab = d.matName or d.label
                    if type(lab) ~= "string" or lab == "" or lab == "Bomb Vein (All)" then
                        if preset.kind == "bomb" or preset.kind == "bomb_all" then
                            lab = d.matName or d.label or "Bomb Vein"
                        else
                            lab = preset.name or "Vein"
                        end
                    end
                    lab = tostring(lab)
                    local key = string.format("%d:%d:%d:%s", math.floor(d.pos.X / 12), math.floor(d.pos.Y / 12), math.floor(d.pos.Z / 12), lab)
                    if not seen[key] then
                        seen[key] = true
                        d.label = lab
                        d.matName = lab
                        d.color = d.color or preset.color
                        d._preset = preset
                        deposits[#deposits + 1] = d
                    end
                end
            end
        end

        local wantMulti = (S._shortcutVeinEsp == true) or (S._multiVeinEsp == true)
        
        
        local wantBomb = (S._shortcutBombVeinEsp == true) and not wantMulti

        
        local nameIsBomb = tostring(selectedName or ""):find("Bomb", 1, true) ~= nil
        local nameStr    = tostring(selectedName or "")

        if wantMulti then
            
            local names = { "Aetherstone Vein", "Lava Vein", "Prismarite Vein" }
            S._veinMultiIdx = ((S._veinMultiIdx or 0) % #names) + 1
            local vn = names[S._veinMultiIdx]
            local preset = getPreset(vn)
            if preset then
                local ok, found = pcall(findDeposits, origin, preset)
                if ok then pushFound(found, preset) end
            end
            
            if type(S._veinDeposits) == "table" then
                for _, d in ipairs(S._veinDeposits) do
                    if d and typeof(d.pos) == "Vector3" then
                        local lab = tostring(d.matName or d.label or "")
                        if lab ~= "" and lab ~= string.upper(vn) and lab ~= vn then
                            local isTerrain = (lab:find("AETHER", 1, true) or lab:find("LAVA", 1, true) or lab:find("PRISMA", 1, true)
                                or lab:find("Aether", 1, true) or lab:find("Lava", 1, true) or lab:find("Prisma", 1, true))
                            if isTerrain then
                                local key = string.format("%d:%d:%d:%s", math.floor(d.pos.X / 12), math.floor(d.pos.Y / 12), math.floor(d.pos.Z / 12), lab)
                                if not seen[key] then
                                    seen[key] = true
                                    deposits[#deposits + 1] = d
                                end
                            end
                        end
                    end
                end
            end
        elseif wantBomb then
            
            local preset = getPreset("Bomb Vein (All)") or getPreset(selectedName)
            if preset then
                local ok, found = pcall(findDeposits, origin, preset)
                if ok then pushFound(found, preset) end
            end
        else
            
            
            if nameIsBomb then
                
                
            elseif defaultPreset then
                local ok, found = pcall(findDeposits, origin, defaultPreset)
                if ok then pushFound(found, defaultPreset) end
            end
        end

        
        S._veinProgTick = (S._veinProgTick or 0) + 1
        if typeof(origin) == "Vector3" and (S._veinProgTick % 3 == 0) then
            S._veinProgAng = ((S._veinProgAng or 0) + 1) % 8
            local dist   = 100 + (S._veinProgAng % 3) * 60
            local rad    = (S._veinProgAng / 8) * math.pi * 2
            local center = origin + Vector3.new(math.cos(rad) * dist, 0, math.sin(rad) * dist)
            local function scanCenter(preset)
                if not preset then return end
                local ok, found = pcall(findDeposits, center, preset)
                if ok and type(found) == "table" then pushFound(found, preset) end
            end
            
            if wantBomb then
                scanCenter(getPreset("Bomb Vein (All)") or getPreset(selectedName))
            elseif wantMulti then
                local names = { "Aetherstone Vein", "Lava Vein", "Prismarite Vein" }
                scanCenter(getPreset(names[(S._veinProgAng % 3) + 1]))
            elseif defaultPreset and not nameIsBomb then
                scanCenter(defaultPreset)
            end
        end

        
        
        
        
        
        
        
        
        
        local PER_TYPE = 8
        local range = math.clamp(tonumber(S.veinEspRange) or 800, 500, 1000)

        local freshByType = {}
        for _, d in ipairs(deposits) do
            if d and typeof(d.pos) == "Vector3" then
                local dist = (d.pos - origin).Magnitude
                if dist <= range then
                    local lab = tostring(d.matName or d.label or "Vein")
                    if lab ~= "Bomb Vein (All)" and lab ~= "" then
                        d.label = lab
                        d.matName = lab
                        d._dist = dist
                        if not freshByType[lab] then
                            freshByType[lab] = {}
                        end
                        freshByType[lab][#freshByType[lab] + 1] = d
                    end
                end
            end
        end

        local allMerged = {}
        local activeKeys = {}
        local beamLeft = 3

        for lab, candidates in pairs(freshByType) do
            table.sort(candidates, function(a, b)
                return (a._dist or 0) < (b._dist or 0)
            end)
            local take = math.min(#candidates, PER_TYPE)
            for i = 1, take do
                local d = candidates[i]
                local preset = d._preset or defaultPreset
                local col = d.color or (preset and preset.color) or Color3.fromRGB(200, 200, 255)
                local showName = string.upper(tostring(d.matName or d.label or lab))
                local key = string.format("%s:%d:%d:%d", showName, math.floor(d.pos.X / 28), math.floor(d.pos.Y / 28), math.floor(d.pos.Z / 28))
                activeKeys[key] = true
                allMerged[#allMerged + 1] = d

                local m = markers[key]
                if not m then
                    m = makeMarker(preset or defaultPreset)
                    markers[key] = m
                end
                if m and m.part then
                    if (m.part.Position - d.pos).Magnitude > 4 then
                        m.part.CFrame = CFrame.new(d.pos)
                    end
                    if m.nameLbl then
                        m.nameLbl.Text = showName
                        m.nameLbl.TextColor3 = col
                    end
                    if m.title then
                        m.title.Text = showName
                        m.title.TextColor3 = col
                    end
                    if m.distLbl then
                        local dist = math.floor((d.pos - origin).Magnitude + 0.5)
                        if preset and (preset.kind == "bomb" or preset.kind == "bomb_all") then
                            local sizeTxt = (type(sizeLabel) == "function" and sizeLabel(d.count)) or tostring(d.count or 1)
                            m.distLbl.Text = string.format("%s  ·  %dm away", sizeTxt, dist)
                        else
                            m.distLbl.Text = string.format("%dm away", dist)
                        end
                        m.distLbl.TextColor3 = col
                    end
                    if beamLeft > 0 then
                        beamLeft = beamLeft - 1
                        pcall(function()
                            ensureBeam(m, col)
                        end)
                    elseif m.beam then
                        pcall(function()
                            if m.beam then m.beam:Destroy() end
                            if m.beamA then m.beamA:Destroy() end
                            if m.beamB then m.beamB:Destroy() end
                        end)
                        m.beam, m.beamA, m.beamB = nil, nil, nil
                    end
                end
            end
        end

        
        for key, m in pairs(markers) do
            if not activeKeys[key] then
                if type(m) == "table" then
                    pcall(function()
                        if m.beam then m.beam:Destroy() end
                        if m.beamA then m.beamA:Destroy() end
                        if m.beamB then m.beamB:Destroy() end
                        if m.part then m.part:Destroy() end
                    end)
                end
                markers[key] = nil
            end
        end

        
        S._lockedSlots = nil
        S._veinDeposits = allMerged
        S._veinEspCache = {}
    end


function FM.setVeinScanner(on)
        if on == true then
            S.veinScannerActive = true
        elseif on == false then
            if not (S._shortcutVeinEsp or S._shortcutBombVeinEsp or S._multiVeinEsp) then
                S.veinScannerActive = false
            end
        end
        local shouldRun = (S.veinScannerActive == true)
            or (S._shortcutVeinEsp == true)
            or (S._shortcutBombVeinEsp == true)
            or (S._multiVeinEsp == true)
        if not shouldRun then
            active = false
            if pulseConn then
                pcall(function()
                    pulseConn:Disconnect()
                end)
                pulseConn = nil
            end
            clearMarkers()
            S._veinDeposits = {}
            return
        end
        if shouldRun and active then
            pcall(scanOnce)
            return
        end
        active = shouldRun
        if pulseConn then
            pcall(function()
                pulseConn:Disconnect()
            end)
            pulseConn = nil
        end
        if not active then
            clearMarkers()
            S._veinDeposits = {}
            return
        end
        pcall(scanOnce)
        lastScanAt = 0
        task.spawn(function()
            while active do
                local root = FM.getRoot and FM.getRoot() or nil
                local now = os.clock()
                local should = true
                
                if root and lastScanPos then
                    local moved = (root.Position - lastScanPos).Magnitude
                    if moved < 10 and (now - lastScanAt) < 1.4 then
                        should = false
                        
                        if (now - lastScanAt) > 0.25 then
                            for _, m in pairs(markers) do
                                if m and m.part and m.distLbl then
                                    local dist = math.floor((m.part.Position - root.Position).Magnitude + 0.5)
                                    local txt = m.distLbl.Text or ""
                                    if txt:find("away", 1, true) then
                                        local prefix = txt:match("^(.-)·") or txt:match("^(%S+)") or ""
                                        if txt:find("·", 1, true) then
                                            m.distLbl.Text = string.format("%s·  %dm away", prefix, dist)
                                        else
                                            m.distLbl.Text = string.format("%dm away", dist)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if should then
                    pcall(scanOnce)
                    if root then
                        lastScanPos = root.Position
                        lastScanAt = now
                    end
                end
                task.wait(0.20)
            end
        end)
        
        local BEAM_SEQ_DIM    = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    0.88),
            NumberSequenceKeypoint.new(0.15, 0.52),
            NumberSequenceKeypoint.new(0.85, 0.60),
            NumberSequenceKeypoint.new(1,    1),
        })
        local BEAM_SEQ_BRIGHT = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    0.82),
            NumberSequenceKeypoint.new(0.15, 0.35),
