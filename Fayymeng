    local hit = Instance.new("TextButton")
    hit.Name = "Hit"
    hit.Size = UDim2.fromScale(1, 1)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.ZIndex = 10
    hit.AutoButtonColor = false
    hit.Active = true
    hit.Parent = frame

    local dragging = false
    local dragMoved = false
    local dragInput = nil
    local startMouse = nil
    local startFrame = nil
    local lastClick = 0
    local THRESH = 10

    local function clampToScreen(absX, absY)
        local cam = Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local halfW = BTN_W * 0.5
        local halfH = BTN_H * 0.5
        absX = math.clamp(absX, halfW + 4, vp.X - halfW - 4)
        absY = math.clamp(absY, halfH + 4, vp.Y - halfH - 4)
        return absX, absY
    end

    local function setAbsCenter(cx, cy)
        cx, cy = clampToScreen(cx, cy)
        frame.Position = UDim2.fromOffset(cx, cy)
        S._pickupBtnPos = frame.Position
    end

    local function beginDrag(input)
        if S.pickupBtnLocked then
            dragging = true
            dragMoved = false
            dragInput = input
            startMouse = Vector2.new(input.Position.X, input.Position.Y)
            startFrame = nil
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        dragMoved = false
        dragInput = input
        startMouse = Vector2.new(input.Position.X, input.Position.Y)
        local ap = frame.AbsolutePosition
        local as = frame.AbsoluteSize
        startFrame = Vector2.new(ap.X + as.X * 0.5, ap.Y + as.Y * 0.5)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
        end
    end)

    S._pickupBtnMoveConn = UIS.InputChanged:Connect(function(input)
        if not dragging or not dragInput then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if S.pickupBtnLocked or not startFrame or not startMouse then
            return
        end
        local cur = Vector2.new(input.Position.X, input.Position.Y)
        local delta = cur - startMouse
        if delta.Magnitude > THRESH then
            dragMoved = true
        end
        if dragMoved then
            setAbsCenter(startFrame.X + delta.X, startFrame.Y + delta.Y)
        end
    end)

    S._pickupBtnEndConn = UIS.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local wasDrag = dragMoved
        dragging = false
        dragMoved = false
        dragInput = nil
        startMouse = nil
        startFrame = nil

        if wasDrag then
            return
        end

        local now = os.clock()
        if now - lastClick < 0.25 then return end
        lastClick = now

        task.spawn(function()
            local root = FM.getRoot and FM.getRoot()
            if not root then return end
            local origin = root.Position
            local range = 28
            local list = {}
            local seen = {}

            local function hasActiveFilter()
                local cfg = FM.farmPickupCfg
                if type(cfg) == "table" and cfg.Enabled == true then
                    if (tonumber(cfg.MinValue) or 0) > 0 then return true end
                    if (tonumber(cfg.MinLuck) or 0) > 0 then return true end
                    if type(cfg.PresetValue) == "string" and cfg.PresetValue ~= "" and cfg.PresetValue ~= "None" then return true end
                    if type(cfg.PresetLuck) == "string" and cfg.PresetLuck ~= "" and cfg.PresetLuck ~= "None" then return true end
                    if type(cfg.Tier) == "table" and not cfg.Tier.All then
                        for k, v in pairs(cfg.Tier) do
                            if v == true and k ~= "All" then return true end
                        end
                    end
                end
                if (tonumber(S.minValue) or 0) > 0 then return true end
                if S.luckFilter == true and (tonumber(S.minLuck) or 0) > 0 then return true end
                return false
            end

            local function passesFilter(inst)
                if not hasActiveFilter() then
                    return true
                end
                local cfg = FM.farmPickupCfg
                if type(cfg) == "table" and cfg.Enabled == true then
                    local minV = tonumber(cfg.MinValue) or 0
                    local minL = tonumber(cfg.MinLuck) or 0
                    if minV > 0 then
                        local v = FM.crystalValue and FM.crystalValue(inst) or 0
                        if (tonumber(v) or 0) < minV then return false end
                    end
                    if minL > 0 then
                        local l = FM.getCrystalLuckScore and FM.getCrystalLuckScore(inst) or 0
                        if (tonumber(l) or 0) + 1e-9 < minL then return false end
                    end
                    if type(cfg.Tier) == "table" and not cfg.Tier.All then
                        local tierName = nil
                        pcall(function()
                            tierName = FM.crystalRarity and FM.crystalRarity(inst)
                        end)
                        local tierNum = FM.crystalTier and FM.crystalTier(inst)
                        local ok = false
                        for k, v in pairs(cfg.Tier) do
                            if v == true then
                                if k == tostring(tierName) or k == tostring(tierNum) then
                                    ok = true
                                    break
                                end
                            end
                        end
                        if not ok then return false end
                    end
                end
                if FM.meetsFilter then
                    return FM.meetsFilter(inst, FM.crystalValue and FM.crystalValue(inst)) ~= false
                end
                return true
            end

            local function consider(inst)
                if not inst or seen[inst] then return end
                if not inst:IsA("BasePart") then
                    if inst:IsA("Model") then
                        local p = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
                        if p then consider(p) end
                    end
                    return
                end
                seen[inst] = true
                if FM.getAttr and FM.getAttr(inst, "Collected") == true then return end
                local okCrystal = false
                pcall(function()
                    if FM.isCrystal and FM.isCrystal(inst) then okCrystal = true end
                end)
                if not okCrystal then
                    if FM.getAttr and (FM.getAttr(inst, "Value") ~= nil or FM.getAttr(inst, "Tier") ~= nil) then
                        okCrystal = true
                    end
                end
                if not okCrystal then return end
                local d = (inst.Position - origin).Magnitude
                if d > range then return end
                if not passesFilter(inst) then return end
                list[#list + 1] = { inst = inst, d = d }
            end

            if S.registry then
                for inst in pairs(S.registry) do
                    consider(inst)
                end
            end
            pcall(function()
                if FM.eachContainer then
                    FM.eachContainer(function(container)
                        if not container then return end
                        for _, child in ipairs(container:GetChildren()) do
                            consider(child)
                        end
                    end)
                end
            end)
            pcall(function()
                local things = Workspace:FindFirstChild("Things")
                if things then
                    local c = things:FindFirstChild("Crystals")
                    if c then for _, ch in ipairs(c:GetChildren()) do consider(ch) end end
                    local d = things:FindFirstChild("DroppedCrystals")
                    if d then for _, ch in ipairs(d:GetChildren()) do consider(ch) end end
                end
                local dc = Workspace:FindFirstChild("DroppedCrystals")
                if dc then for _, ch in ipairs(dc:GetChildren()) do consider(ch) end end
            end)

            table.sort(list, function(a, b) return a.d < b.d end)

            local hc = HoldComplete or (FM.findRemote and FM.findRemote("CrystalHoldComplete"))
            local noFilter = not hasActiveFilter()
            local CHUNK = 10
            local fired = 0

            if noFilter then
                for i, entry in ipairs(list) do
                    local inst = entry.inst
                    if inst and inst.Parent and not (FM.isPlotPlaced and FM.isPlotPlaced(inst)) then
                        if hc then
                            pcall(function()
                                hc:FireServer(inst)
                                hc:FireServer(inst)
                            end)
                        end
                        if FM.grabCrystal then
                            pcall(FM.grabCrystal, inst, FM.crystalPrompt and FM.crystalPrompt(inst))
                        end
                        fired = fired + 1
                        if i % CHUNK == 0 then
                            task.wait()
                        end
                    end
                end
            else
                local best = list[1] and list[1].inst
                if best then
                    if hc then
                        pcall(function()
                            hc:FireServer(best)
                            hc:FireServer(best)
                        end)
                    end
                    if FM.grabCrystal then
                        pcall(FM.grabCrystal, best, FM.crystalPrompt and FM.crystalPrompt(best))
                    end
                    fired = 1
                end
            end
        end)
    end)
end

