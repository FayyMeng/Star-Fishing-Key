        local function place()
            if not popup.Parent or not button.Parent then
                return
            end
            local pos = button.AbsolutePosition
            local size = button.AbsoluteSize
            local cam = Workspace.CurrentCamera
            local viewport = cam and cam.ViewportSize or Vector2.new(800, 600)
            local popupW = 196
            local popupH = 138
            local gap = 8

            local x = pos.X + size.X + gap
            if x + popupW > viewport.X - 6 then
                x = pos.X - popupW - gap
            end
            if x < 6 then
                x = math.clamp(pos.X, 6, math.max(6, viewport.X - popupW - 6))
            end

            local y = math.clamp(pos.Y, 6, math.max(6, viewport.Y - popupH - 6))
            popup.Position = UDim2.fromOffset(x, y)
        end

