            if open then
                for _, other in ipairs(shortcutPopups) do
                    if other and other ~= popup then
                        pcall(function() other.Visible = false end)
                    end
                end
                updateCanvas()
                list.CanvasPosition = Vector2.new(0, 0)
                place()
            end
            popup.Visible = open
