        end)

        if not ok then
            
            ok = true
            for _, p in ipairs(payload) do
                local fok = pcall(function()
                    remote:FireServer(p.bombId, p.pos)
                end)
                if not fok then ok = false end
            end
        end

        local names = {}
        for _, p in ipairs(payload) do names[#names + 1] = p.name end
