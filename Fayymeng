            local function fireAllNearbyBatched()
                local root = FM.getRoot and FM.getRoot()
                if not root then return end
                local origin = root.Position
                local queued = 0
                local r2 = SC_RADIUS * SC_RADIUS

                local function tryInst(inst)
                    if queued >= SC_MAX_PER_TICK then
                        return true
                    end
                    if not inst or not inst.Parent then
                        return false
                    end
                    local pos = getCrystalPos(inst)
                    if not pos then
                        return false
                    end
                    local dx = pos.X - origin.X
                    local dy = pos.Y - origin.Y
                    local dz = pos.Z - origin.Z
                    if (dx * dx + dy * dy + dz * dz) > r2 then
                        return false
                    end
                    if not passShortcutFilter(inst) then
                        return false
                    end
                    if FM.queueHoldComplete and FM.queueHoldComplete(inst) then
                        queued = queued + 1
                    end
                    return false
                end

                local folders = {}
                pcall(function()
                    folders[#folders + 1] = Workspace:FindFirstChild("DroppedCrystals")
                    local things = Workspace:FindFirstChild("Things")
                    if things then
                        folders[#folders + 1] = things:FindFirstChild("Crystals")
                        folders[#folders + 1] = things:FindFirstChild("DroppedCrystals")
                    end
                    folders[#folders + 1] = Workspace:FindFirstChild("Crystals")
                end)

                for _, folder in ipairs(folders) do
                    if queued >= SC_MAX_PER_TICK then break end
                    if folder then
                        local children = folder:GetChildren()
                        for i = 1, #children do
                            if tryInst(children[i]) then
                                break
                            end
                            if queued >= SC_MAX_PER_TICK then break end
                        end
                    end
                end
            end

