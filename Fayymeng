    local function iterWorldCrystals()
        local list = {}
        local seen = {}
        local function push(inst)
            if not inst or seen[inst] then
                return
            end
            local ok = true
            if FM.isCrystal then
                ok = FM.isCrystal(inst) == true
            end
            if not ok then
                local has = false
                pcall(function()
                    if FM.getAttr and (FM.getAttr(inst, "Value") ~= nil or FM.getAttr(inst, "Tier") ~= nil) then
                        has = true
                    end
                end)
                ok = has
            end
            if ok then
                seen[inst] = true
                list[#list + 1] = inst
            end
        end

        if type(S) == "table" and type(S.registry) == "table" then
            for inst in pairs(S.registry) do
                push(inst)
            end
        end

        local function scanFolder(folder)
            if not folder then
                return
            end
            for _, child in ipairs(folder:GetChildren()) do
                push(child)
                if child:IsA("Model") or child:IsA("Folder") then
                    for _, inner in ipairs(child:GetChildren()) do
                        push(inner)
                    end
                end
            end
        end

        pcall(function()
            if FM.eachContainer then
                FM.eachContainer(function(container)
                    scanFolder(container)
                end)
            end
        end)

        local things = Workspace:FindFirstChild("Things")
        if things then
            scanFolder(things:FindFirstChild("Crystals"))
            scanFolder(things:FindFirstChild("DroppedCrystals"))
            scanFolder(things:FindFirstChild("WorldCrystals"))
        end
        scanFolder(Workspace:FindFirstChild("DroppedCrystals"))
        scanFolder(Workspace:FindFirstChild("Crystals"))

        return list
    end

    local function scoreCrystalLuck(inst)
        local n = nil
        pcall(function()
            if FM.getCrystalLuckScore then
                n = FM.getCrystalLuckScore(inst)
            elseif FM.crystalLuckStrict then
                n = FM.crystalLuckStrict(inst)
            end
        end)
        if type(n) == "number" and n > 0 then
            return n
        end
        pcall(function()
            local labelRaw = FM.luckLabelText and FM.luckLabelText(inst)
            if type(labelRaw) == "string" and labelRaw:match("[%d]") then
                local cleaned = labelRaw:gsub(",", ""):gsub("%s+", ""):gsub("^%+", "")
                local pct = cleaned:match("([%d%.]+)%%")
                n = tonumber(pct) or tonumber(cleaned:match("([%d%.]+)"))
            end
        end)
        if type(n) == "number" and n > 0 then
            return n
        end
        pcall(function()
            if FM.computeLuck then
                n = FM.computeLuck(inst)
            end
        end)
        return (type(n) == "number" and n > 0) and n or 0
    end

    local function scoreCrystalValue(inst)
        local n = 0
        pcall(function()
            if FM.crystalValue then
                n = FM.crystalValue(inst) or 0
            else
                n = tonumber(inst:GetAttribute("Value")) or 0
            end
        end)
        return tonumber(n) or 0
    end

    local function startTopEsp(mode)
        stopTopEsp()
        topEspMode = mode
        if S then S.topEspMode = mode end
        local parent = GuiRoot
        pcall(function()
            if typeof(gethui) == "function" then
                parent = gethui() or parent
            end
        end)
        topEspFolder = Instance.new("Folder")
        topEspFolder.Name = "FM_ShortcutTopEsp"
        topEspFolder.Parent = parent

        local lastRefresh = 0
        local currentAdornee = nil
        local billboard = nil

        local function ensureBillboard(part, line1, line2, color)
            if not part then return end
            if not billboard or not billboard.Parent then
                billboard = Instance.new("BillboardGui")
                billboard.Name = "TopEsp"
                billboard.AlwaysOnTop = true
                billboard.ResetOnSpawn = false
                billboard.LightInfluence = 0
                billboard.Size = UDim2.fromOffset(160, 40)
                billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.4, 0)
                billboard.MaxDistance = 5000
                billboard.Parent = topEspFolder

                local function mk(name, order, col)
                    local t = Instance.new("TextLabel")
                    t.Name = name
                    t.BackgroundTransparency = 1
                    t.Size = UDim2.new(1, 0, 0.5, 0)
                    t.Position = UDim2.new(0, 0, (order - 1) * 0.5, 0)
                    t.Font = Enum.Font.SourceSansBold
                    t.TextSize = 14
                    t.TextColor3 = col
                    t.TextStrokeTransparency = 0.35
                    t.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    t.Parent = billboard
                    return t
                end
                mk("Main", 1, color or Color3.fromRGB(255, 196, 0))
                mk("Sub", 2, Color3.fromRGB(200, 210, 230))
            end
            billboard.Adornee = part
            local main = billboard:FindFirstChild("Main")
            local sub = billboard:FindFirstChild("Sub")
            if main then
                main.Text = line1 or ""
                main.TextColor3 = color or main.TextColor3
            end
            if sub then
                sub.Text = line2 or ""
            end
            currentAdornee = part
        end

        
        local acc = 0
        local SCAN_INTERVAL = 0.75
        topEspConn = RunService.Heartbeat:Connect(function(dt)
            if topEspMode ~= mode then return end
            acc = acc + (dt or 0.016)
            if acc < SCAN_INTERVAL then return end
            acc = 0

            local best, bestScore, bestPart = nil, -1, nil
            local crystals = iterWorldCrystals()
            for i = 1, #crystals do
                local inst = crystals[i]
                local part = crystalPart(inst)
                if part then
                    local score
                    if mode == "luck" then
                        score = scoreCrystalLuck(inst)
                    else
                        score = scoreCrystalValue(inst)
                    end
                    if score > bestScore then
                        bestScore, best, bestPart = score, inst, part
                    end
                end
            end

            if best and bestPart and bestScore > 0 then
                local dist = 0
                pcall(function()
                    local root = FM.getRoot and FM.getRoot()
                    if root then
                        dist = (bestPart.Position - root.Position).Magnitude
                    end
                end)
                local distTxt = FM.formatDistance and FM.formatDistance(dist) or string.format("%dm", math.floor(dist + 0.5))
                local col, line1, line2
                if mode == "luck" then
                    local rarityName = "Unknown"
                    pcall(function()
                        rarityName = (FM.crystalRarity and FM.crystalRarity(best)) or "Unknown"
                    end)
                    local luckText
                    if FM.formatLuck then
                        luckText = FM.formatLuck(bestScore)
                    else
                        luckText = string.format("+%.2f%%", bestScore)
                    end
                    line1 = string.format("[%s] %s", rarityName, luckText)
                    line2 = distTxt
                    local tier = FM.crystalTier and FM.crystalTier(best) or 0
                    col = (TIER_COLORS and TIER_COLORS[tier]) or Color3.fromRGB(255, 196, 0)
                else
                    local rarityName = "Unknown"
                    pcall(function()
                        rarityName = (FM.crystalRarity and FM.crystalRarity(best)) or "Unknown"
                    end)
                    local valText = tostring(bestScore)
                    pcall(function()
                        if FM.formatShort then
                            valText = FM.formatShort(bestScore, "$") or valText
                        elseif FM.formatValue then
                            local ok, r = pcall(FM.formatValue, bestScore)
                            if ok and r then valText = tostring(r) end
                        end
                    end)
                    line1 = string.format("[%s] %s", rarityName, valText)
                    line2 = distTxt
                    local tier = FM.crystalTier and FM.crystalTier(best) or 0
                    col = (TIER_COLORS and TIER_COLORS[tier]) or Color3.fromRGB(60, 255, 90)
                end
                ensureBillboard(bestPart, line1, line2, col)
            elseif billboard then
                billboard.Adornee = nil
            end
        end)
        trackConn(topEspConn)
        
    end

    local function isDigTool(tool)
        if not tool or not tool:IsA("Tool") then
            return false
        end
        local n = string.lower(tool.Name or "")
        return n:find("pickaxe", 1, true) ~= nil
            or n:find("sledge", 1, true) ~= nil
            or n:find("hammer", 1, true) ~= nil
            or n:find("pick", 1, true) ~= nil
    end

    local function getHeldDigTool()
        local char = LocalPlayer.Character
        if not char then return nil end
        for _, child in ipairs(char:GetChildren()) do
            if isDigTool(child) then
                return child
            end
        end
        return nil
    end

    local function buyAllBombsNow()
        local query = BombShopQuery or FM.findRemote("BombShopQuery")
        local buyReq = BombBuyRequest or FM.findRemote("BombBuyRequest")
        if not query or not buyReq then
            return 0
        end
        local ok, data = pcall(function()
            return query:InvokeServer()
        end)
        if not ok or not data or type(data.stock) ~= "table" then
            return 0
        end
        local bought = 0
        local jobs = {}
        for bombId, amount in pairs(data.stock) do
            local count = tonumber(amount) or 0
            for _ = 1, math.max(0, count) do
                jobs[#jobs + 1] = bombId
            end
        end
        local active = 0
        local maxParallel = 12
        local idx = 1
        while idx <= #jobs or active > 0 do
            while active < maxParallel and idx <= #jobs do
                local bombId = jobs[idx]
                idx = idx + 1
                active = active + 1
                task.spawn(function()
                    local success, res = pcall(function()
                        return buyReq:InvokeServer(bombId)
                    end)
                    if success and res and res.ok then
                        bought = bought + 1
                    end
                    active = active - 1
                end)
            end
            task.wait()
        end
        return bought
    end


