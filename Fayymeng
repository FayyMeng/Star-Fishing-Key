                            okM = true
                            break
                        end
                    end
                    if not okM then return false end
                end
                if minLuck <= 0 and minValue <= 0 and (type(mutations) ~= "table" or mutations.All or not next(mutations)) then
                    return true
                end
                if minLuck > 0 then
                    local luck = 0
                    pcall(function()
                        if scoreCrystalLuck then
                            luck = tonumber(scoreCrystalLuck(inst)) or 0
                        elseif FM.crystalLuckStrict then
                            luck = tonumber(FM.crystalLuckStrict(inst)) or 0
