        local function veinGetPick()
        local want = tostring(S.farmDigTool or S.autoDigTool or S.standaloneDigTool or "Pickaxe")
        local char = LocalPlayer.Character
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local function matchTool(tool, wantSledge)
            if not tool or not tool:IsA("Tool") then return false end
            local n = tostring(tool.Name or "")
            if wantSledge then
                return n:find("Sledge", 1, true) ~= nil
            end
            return n:find("Pick", 1, true) ~= nil
                or n:find("Axe", 1, true) ~= nil
                or n:find("Drill", 1, true) ~= nil
        end
        local wantSledge = (want == "Sledge Hammer")
        local found = nil
        local function scan(container)
            if not container then return end
            for _, ch in ipairs(container:GetChildren()) do
                if matchTool(ch, wantSledge) then
                    found = ch
                    return
                end
            end
        end
        scan(char)
        if not found then scan(bp) end
        if not found and wantSledge then
            
            scan(char)
            if not found then scan(bp) end
            for _, cont in ipairs({ char, bp }) do
                if cont and not found then
                    for _, ch in ipairs(cont:GetChildren()) do
                        if matchTool(ch, false) then found = ch break end
                    end
                end
            end
        end
        if found and char then
